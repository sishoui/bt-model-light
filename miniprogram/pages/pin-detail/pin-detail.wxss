/* 引脚配置详情页样式（ADR-0027 / #27 / T7；design.md §7.3 工具页范式）。
   柔光通透语言：白卡 + 大圆角 + 极轻阴影，控件走药丸/tint 底。
   阶段区是竖向时间轴：左列细轴（时刻 + 时长圆点 + 连线），右侧每段一张可编辑卡片。
   图层纵向排列，数值参数是细边圆环（百分比 = 环长），点开在卡内展开一行数字轴。
   注意：canvas / 拖选选择器类名（.color-wheel / .picker-wheel / .led-grid /
   .led-cell / .gauge__track）被 JS 的 createSelectorQuery 使用，
   改名会让真机画布/拖选/刻度轴失效。 */

/* 底部给悬浮 Dock 留位，另留页面自身滚动余量 */
.page {
  padding: 0 0 220rpx;
}

/* 同步状态条：syncing/synced/failed/local 四态，idle 不显示 */
.sync-bar {
  padding: 10rpx 40rpx;
  color: var(--bt-color-label-tertiary);
  font-size: 24rpx;
  line-height: 1.4;
}

.sync-bar__text {
  display: block;
}

.sync-bar--syncing {
  color: var(--bt-color-accent);
}

.sync-bar--synced {
  color: var(--bt-color-label-tertiary);
}

.sync-bar--failed {
  color: var(--bt-color-danger);
}

.sync-bar--local {
  color: var(--bt-color-label-tertiary);
}

/* ===== 顶部信息卡：引脚图 + 名称 + 灯组选择 ===== */
.pin-head-card {
  padding: 28rpx;
}

.pin-head {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.pin-head__img {
  flex-shrink: 0;
  width: 128rpx;
  height: 128rpx;
  border-radius: var(--bt-radius-inner);
  background: var(--bt-color-bg-sunken);
}

.pin-head__info {
  flex: 1;
  min-width: 0;
}

.pin-head__name {
  height: 60rpx;
  color: var(--bt-color-label);
  font-size: 38rpx;
  line-height: 60rpx;
  font-weight: 700;
}

.pin-head__placeholder {
  color: var(--bt-color-label-quaternary);
}

/* 开关行：引脚号（左）+ switch（右） */
.pin-head__switch-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 4rpx;
}

.pin-head__pin-no {
  color: var(--bt-color-label-tertiary);
  font-size: 24rpx;
  line-height: 34rpx;
}

/* 灯组选择：药丸容器内嵌 picker + 配置按钮 */
.group-select {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 24rpx;
}

.group-select__value {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  height: 96rpx;
  padding: 0 24rpx;
  border-radius: var(--bt-radius-pill);
  background: var(--bt-color-bg-input);
  box-sizing: border-box;
  transition: background-color 0.2s ease-out;
}

.group-select__value:active {
  background: var(--bt-color-gray-5);
}

.group-select__text {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.group-select__name {
  overflow: hidden;
  color: var(--bt-color-label);
  font-size: 30rpx;
  line-height: 40rpx;
  font-weight: 600;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.group-select__range {
  color: var(--bt-color-label-tertiary);
  font-size: 22rpx;
  line-height: 30rpx;
}

.group-select__arrow {
  flex: 0 0 auto;
  margin-left: 12rpx;
  color: var(--bt-color-label-tertiary);
  font-size: 18rpx;
  line-height: 28rpx;
}

.group-select__config {
  flex: 0 0 auto;
  height: 96rpx;
  padding: 0 32rpx;
  border-radius: var(--bt-radius-pill);
  background: var(--bt-color-accent-soft);
  color: var(--bt-color-accent);
  font-size: 28rpx;
  line-height: 96rpx;
  font-weight: 600;
  box-sizing: border-box;
}

/* ===== 通用行：标签 + 控件 ===== */
.row {
  display: flex;
  align-items: center;
  margin-top: 16rpx;
}

.row__label {
  flex-shrink: 0;
  width: 148rpx;
  color: var(--bt-color-label-secondary);
  font-size: 26rpx;
  line-height: 38rpx;
}

.row__input {
  flex: 1;
  height: 72rpx;
  padding: 0 20rpx;
  border-radius: var(--bt-radius-inner);
  background: var(--bt-color-bg-input);
  color: var(--bt-color-label);
  font-size: 28rpx;
  line-height: 72rpx;
  box-sizing: border-box;
}

/* ===== 灯珠范围（视觉方格，点击热区经 margin 扩展） ===== */
.range {
  margin-top: 24rpx;
}

.range__title {
  color: var(--bt-color-label);
  font-size: 28rpx;
  line-height: 38rpx;
  font-weight: 600;
}

.led-grid {
  display: grid;
  grid-template-columns: repeat(10, 1fr);
  gap: 14rpx;
  max-height: 50vh;
  margin: 12rpx 0 0;
  overflow-x: hidden;
  overflow-y: auto;
  touch-action: none;
}

.led-cell {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  aspect-ratio: 1;
  min-height: 48rpx;
  border-radius: 12rpx;
  background: var(--bt-color-bg-input);
  color: var(--bt-color-label-quaternary);
  font-size: 20rpx;
  line-height: 1;
  box-sizing: border-box;
  transition: background-color 0.15s ease-out, color 0.15s ease-out, box-shadow 0.15s ease-out;
}

/* 已选中（松手后生效）：实心品牌色 */
.led-cell--selected {
  background: var(--bt-color-accent);
  color: #ffffff;
  font-weight: 600;
}

/* 被其他灯组占用：灰底不可选 */
.led-cell--occupied {
  background: var(--bt-color-gray-4);
  color: var(--bt-color-label-quaternary);
  opacity: 0.6;
}

/* 拖选起点/终点：白底 + 品牌色描边 */
.led-cell--drag-start,
.led-cell--drag-end {
  background: var(--bt-color-bg-elevated);
  color: var(--bt-color-accent);
  box-shadow: inset 0 0 0 3rpx var(--bt-color-accent);
}

/* 拖选中间：品牌色浅底 */
.led-cell--drag-mid {
  background: var(--bt-color-accent-soft-2);
  color: var(--bt-color-accent);
}

.range__hint {
  margin-top: 14rpx;
  color: var(--bt-color-label-tertiary);
  font-size: 22rpx;
  line-height: 32rpx;
}

.range__actions {
  display: flex;
  justify-content: flex-end;
  margin-top: 16rpx;
}

.range__clear {
  padding: 12rpx 28rpx;
  border-radius: var(--bt-radius-pill);
  background: var(--bt-color-danger-soft);
  color: var(--bt-color-danger);
  font-size: 26rpx;
  line-height: 36rpx;
  font-weight: 600;
}

/* ===== 阶段标题行：标题 + 总时长 + 添加阶段 ===== */
.stage-head {
  display: flex;
  align-items: center;
  margin: 32rpx 40rpx 0;
}

.stage-head__title {
  color: var(--bt-color-label);
  font-size: 30rpx;
  line-height: 40rpx;
  font-weight: 600;
}

.stage-head__total {
  flex: 1;
  margin-left: 16rpx;
  color: var(--bt-color-label-tertiary);
  font-size: 22rpx;
  line-height: 30rpx;
}

/* 添加阶段：品牌色 tint 圆钮 */
.stage-add {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 auto;
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: var(--bt-color-accent-soft);
  color: var(--bt-color-accent);
  font-size: 32rpx;
  line-height: 1;
}

.stage-add--disabled {
  background: var(--bt-color-bg-input);
  color: var(--bt-color-label-quaternary);
}

/* ===== 竖向时间轴：左轴（时刻 + 时长圆点 + 连线）+ 右侧段卡片 ===== */
.timeline {
  margin: 16rpx 32rpx 0;
}

.tl-row {
  display: flex;
  align-items: stretch;
}

/* 左轴列：撑满行高，连线才能连到下一节点 */
.tl-axis {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex: 0 0 auto;
  width: 92rpx;
}

.tl-axis__time {
  color: var(--bt-color-label-tertiary);
  font-size: 20rpx;
  line-height: 26rpx;
  /* 上边距对齐卡片内序号行，圆点与卡片标题同高 */
  margin-top: 30rpx;
}

/* 时长圆点：细边圆环，环内是秒数；点它展开时长刻度轴。
   环色由内联 style 注入（该段首个灯效主题色），空阶段无内联色 → 走灰环。 */
.tl-axis__dot {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 auto;
  width: 56rpx;
  height: 56rpx;
  margin-top: 8rpx;
  border-radius: 50%;
  border: 2rpx solid var(--bt-color-gray-3);
  background: var(--bt-color-bg-elevated);
  box-sizing: border-box;
  transition: border-color 0.25s ease-out, background-color 0.25s ease-out;
}

.tl-axis__dot--on {
  background: var(--bt-color-accent-soft);
  border-color: var(--bt-color-accent);
}

.tl-axis__duration {
  color: var(--bt-color-label-secondary);
  font-size: 22rpx;
  line-height: 1;
  font-weight: 600;
}

.tl-axis__dot--on .tl-axis__duration {
  color: var(--bt-color-accent);
}

/* 连线：从圆点下方一直拉到行底，下一行的圆点接上 */
.tl-axis__line {
  flex: 1;
  width: 2rpx;
  min-height: 24rpx;
  margin-top: 6rpx;
  background: var(--bt-color-separator);
}

.tl-card {
  flex: 1;
  min-width: 0;
  margin: 12rpx 0 20rpx 8rpx;
  padding: 20rpx 24rpx 24rpx;
  border-radius: var(--bt-radius-card);
  background: var(--bt-color-bg-elevated);
  box-shadow: var(--bt-shadow-card);
}

.tl-card--enter {
  animation: tl-card-in 0.22s ease;
}

@keyframes tl-card-in {
  from {
    opacity: 0;
  }
  to {
    opacity: 1;
  }
}

/* 卡头：序号 + 名称 + 上移/下移/删除 */
.tl-card__head {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.tl-card__no {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 auto;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: var(--bt-color-accent-soft);
  color: var(--bt-color-accent);
  font-size: 22rpx;
  line-height: 1;
  font-weight: 600;
}

.tl-card__name {
  flex: 1;
  min-width: 0;
  height: 56rpx;
  color: var(--bt-color-label);
  font-size: 30rpx;
  line-height: 56rpx;
  font-weight: 600;
}

/* 上移/下移：56rpx 热区，到顶/到底置灰但仍占位（不打乱卡头布局） */
.tl-card__move {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 auto;
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: var(--bt-color-bg-input);
  color: var(--bt-color-label-secondary);
  font-size: 26rpx;
  line-height: 1;
}

.tl-card__move--off {
  color: var(--bt-color-label-quaternary);
  opacity: 0.5;
}

.tl-card__del {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 auto;
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: var(--bt-color-danger-soft);
  color: var(--bt-color-danger);
  font-size: 24rpx;
  line-height: 1;
}

/* ===== 图层：纵向一列 ===== */
.layer-list {
  margin-top: 12rpx;
}

.layer-row {
  margin-top: 12rpx;
  padding: 18rpx 20rpx 20rpx;
  border-radius: var(--bt-radius-inner);
  background: var(--bt-color-bg-sunken);
}

/* 空槽：虚线描边 + 无底色，视觉上比占用槽轻一档 */
.layer-row--empty {
  background: transparent;
  border: 2rpx dashed var(--bt-color-accent-soft-2);
}

.layer-row__head {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.layer-row__title {
  flex: 0 0 auto;
  color: var(--bt-color-label-tertiary);
  font-size: 22rpx;
  line-height: 32rpx;
}

/* 灯效磁贴：方框 + 图标 + 名称，整块可点（换灯效）。
   主题色由内联 style 注入 --tile-color（灯效 id → 主题色）。 */
.effect-tile {
  display: flex;
  align-items: center;
  gap: 10rpx;
  flex: 1;
  min-width: 0;
  height: 72rpx;
  padding: 0 18rpx;
  border-radius: var(--bt-radius-inner);
  background: var(--bt-color-bg-elevated);
  box-shadow: var(--bt-shadow-card);
  box-sizing: border-box;
  transition: box-shadow 0.2s ease-out, background-color 0.2s ease-out;
}

/* 触点反馈：按下时内描边（不位移，避免卡内元素抖动） */
.effect-tile:active {
  background: var(--bt-color-bg-input);
}

/* 该图层开着数字轴：磁贴描一圈主题色，跟圆环/轴的归属对上 */
.effect-tile--on {
  box-shadow: 0 0 0 2rpx var(--tile-color, var(--bt-color-accent));
}

.effect-tile__icon {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 auto;
  width: 48rpx;
  height: 48rpx;
  border-radius: 12rpx;
  /* 图标画框随方块缩小：--ico-size 驱动 .bt-ico--e-* 的所有尺寸 */
  --ico-size: 30rpx;
  background: var(--bt-color-accent-soft);
  color: var(--tile-color, var(--bt-color-accent));
}

.effect-tile__name {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  color: var(--bt-color-label);
  font-size: 26rpx;
  line-height: 36rpx;
  font-weight: 600;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.effect-tile__caret {
  flex: 0 0 auto;
  color: var(--bt-color-label-tertiary);
  font-size: 18rpx;
  line-height: 1;
}

/* 图层删除：44rpx 热区 + 负边距抵掉多余高度 */
.layer-row__del {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 auto;
  width: 44rpx;
  height: 44rpx;
  margin: -4rpx -6rpx -4rpx 0;
  border-radius: 50%;
  color: var(--bt-color-danger);
  font-size: 22rpx;
  line-height: 1;
}

/* 空槽添加：整行虚线区内居中 */
.layer-row__empty {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  height: 88rpx;
}

.layer-row__plus {
  color: var(--bt-color-accent);
  font-size: 32rpx;
  line-height: 1;
}

.layer-row__add-text {
  color: var(--bt-color-accent);
  font-size: 24rpx;
  line-height: 34rpx;
}

/* 渐变色带：多色灯效在卡片上直接展示配色 */
.layer-row__gradient {
  height: 12rpx;
  margin-top: 16rpx;
  border-radius: 999rpx;
}

/* ===== 参数区：细边环（数值，环下百分比同一行）/ 选项卡（枚举） ===== */
.ring-row {
  display: flex;
  flex-wrap: wrap;
  align-items: flex-start;
  gap: 4rpx 0;
  margin-top: 16rpx;
}

/* 每格 1/4 宽：圆环居中、说明文字在环下同一行（名称 + 百分比） */
.ring-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 25%;
  padding: 4rpx 4rpx 0;
  box-sizing: border-box;
}

/* 细边进度环：conic-gradient 底层画进度，内层挖空成环（2rpx 细边）。
   环的百分比由内联 background 注入（fld.ring）。 */
.ring-item__ring {
  position: relative;
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  /* conic 渐变由 WXML 内联覆盖；这里给个兜底灰环 */
  background: var(--bt-color-gray-5);
  transition: transform 0.25s ease-out;
}

/* 挖空：中心留白，形成 2rpx 细边环；洞里居中放该参数的图标 */
.ring-item__hole {
  position: absolute;
  top: 2rpx;
  left: 2rpx;
  right: 2rpx;
  bottom: 2rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: var(--bt-color-bg-sunken);
  color: var(--bt-color-label-secondary);
  transition: color 0.25s ease-out;
}

/* 展开数字轴的圆环：只描边高亮 + 图标转品牌色。
   内圈不染底色——进度弧配半透明圆盘会被读成"扇形"。 */
.ring-item__ring--on {
  box-shadow: 0 0 0 2rpx var(--bt-color-accent-soft-2);
}

.ring-item__ring--on .ring-item__hole {
  color: var(--bt-color-accent);
}

/* 环下说明：名称 + 数值同一行（数值已是百分比），一行读完，不占两行高度 */
.ring-item__caption {
  margin-top: 8rpx;
  color: var(--bt-color-label-tertiary);
  font-size: 20rpx;
  line-height: 26rpx;
  white-space: nowrap;
}

/* ===== 枚举参数：整行「名称 + 一排选项卡」（点一下即换档，不占圆环） ===== */
.option-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 14rpx;
}

.option-row__label {
  flex: 0 0 auto;
  width: 72rpx;
  color: var(--bt-color-label-tertiary);
  font-size: 22rpx;
  line-height: 52rpx;
}

.option-tabs {
  flex: 1;
  min-width: 0;
  display: flex;
  padding: 4rpx;
  border-radius: var(--bt-radius-pill);
  background: var(--bt-color-bg-input);
  box-sizing: border-box;
}

.option-tabs__item {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 0;
  height: 52rpx;
  padding: 0 8rpx;
  border-radius: var(--bt-radius-pill);
  color: var(--bt-color-label-secondary);
  font-size: 24rpx;
  line-height: 52rpx;
  font-weight: 500;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  transition: background-color 0.2s ease-out, color 0.2s ease-out, box-shadow 0.2s ease-out;
}

.option-tabs__item--on {
  background: var(--bt-color-bg-elevated);
  color: var(--bt-color-accent);
  font-weight: 600;
  box-shadow: 0 1rpx 4rpx rgba(17, 24, 39, 0.08);
}

/* ===== 参数图标（环内，28rpx 画框，全用 currentColor 细线） ===== */
.ring-item__hole .bt-ico {
  position: relative;
  flex-shrink: 0;
  width: 28rpx;
  height: 28rpx;
}

/* 亮度：太阳（实心圆 + 八向短线） */
.bt-ico--p-sun::before {
  content: '';
  position: absolute;
  top: 7rpx;
  left: 7rpx;
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: currentColor;
}

.bt-ico--p-sun::after {
  content: '';
  position: absolute;
  top: 13rpx;
  left: 1rpx;
  width: 6rpx;
  height: 2rpx;
  border-radius: 1rpx;
  background: currentColor;
  box-shadow: 20rpx 0 0 currentColor;
}

/* 速度：向右箭头 + 两道速度线 */
.bt-ico--p-speed::before {
  content: '';
  position: absolute;
  top: 12rpx;
  left: 4rpx;
  width: 20rpx;
  height: 2rpx;
  border-radius: 1rpx;
  background: currentColor;
  box-shadow: 0 -6rpx 0 -0rpx currentColor, 0 6rpx 0 -0rpx currentColor;
}

.bt-ico--p-speed::after {
  content: '';
  position: absolute;
  top: 9rpx;
  left: 16rpx;
  width: 8rpx;
  height: 8rpx;
  border-top: 2rpx solid currentColor;
  border-right: 2rpx solid currentColor;
  transform: rotate(45deg);
  box-sizing: border-box;
}

/* 方向：水平线 + 左右两个箭头尖（两条 45° 细边旋转拼成） */
.bt-ico--p-arrow::before {
  content: '';
  position: absolute;
  top: 13rpx;
  left: 2rpx;
  width: 24rpx;
  height: 2rpx;
  border-radius: 1rpx;
  background: currentColor;
}

.bt-ico--p-arrow::after {
  content: '';
  position: absolute;
  top: 9rpx;
  left: 2rpx;
  width: 8rpx;
  height: 8rpx;
  border-top: 2rpx solid currentColor;
  border-right: 2rpx solid currentColor;
  transform: rotate(-135deg);
  box-sizing: border-box;
  /* 右端箭头尖：与左端同形、镜像到另一端 */
  box-shadow: none;
  border-radius: 1rpx;
  margin-left: 16rpx;
}

/* 周期：时钟（圆环 + 指针） */
.bt-ico--p-clock::before {
  content: '';
  position: absolute;
  inset: 3rpx;
  border: 2rpx solid currentColor;
  border-radius: 50%;
  box-sizing: border-box;
}

.bt-ico--p-clock::after {
  content: '';
  position: absolute;
  top: 8rpx;
  left: 13rpx;
  width: 2rpx;
  height: 12rpx;
  background: currentColor;
  border-radius: 1rpx;
  transform-origin: 50% 100%;
  transform: rotate(40deg);
}

/* 波形：正弦折线 */
.bt-ico--p-wave::before {
  content: '';
  position: absolute;
  top: 13rpx;
  left: 2rpx;
  width: 10rpx;
  height: 2rpx;
  border-radius: 1rpx;
  background: currentColor;
  transform: rotate(-30deg);
}

.bt-ico--p-wave::after {
  content: '';
  position: absolute;
  top: 13rpx;
  left: 16rpx;
  width: 10rpx;
  height: 2rpx;
  border-radius: 1rpx;
  background: currentColor;
  transform: rotate(30deg);
}

/* 亮：灯泡（圆 + 底座线） */
.bt-ico--p-lamp-on::before {
  content: '';
  position: absolute;
  top: 3rpx;
  left: 8rpx;
  width: 12rpx;
  height: 12rpx;
  border: 2rpx solid currentColor;
  border-radius: 50%;
  box-sizing: border-box;
}

.bt-ico--p-lamp-on::after {
  content: '';
  position: absolute;
  top: 20rpx;
  left: 9rpx;
  width: 10rpx;
  height: 2rpx;
  border-radius: 1rpx;
  background: currentColor;
  box-shadow: 0 4rpx 0 currentColor;
}

/* 灭：细环（空心的灯） */
.bt-ico--p-lamp-off::before {
  content: '';
  position: absolute;
  top: 3rpx;
  left: 8rpx;
  width: 12rpx;
  height: 12rpx;
  border: 2rpx solid currentColor;
  border-radius: 50%;
  box-sizing: border-box;
  opacity: 0.55;
}

.bt-ico--p-lamp-off::after {
  content: '';
  position: absolute;
  top: 20rpx;
  left: 9rpx;
  width: 10rpx;
  height: 2rpx;
  border-radius: 1rpx;
  background: currentColor;
  opacity: 0.55;
}

/* 灯珠数：三点排（数量感） */
.bt-ico--p-dots::before {
  content: '';
  position: absolute;
  top: 12rpx;
  left: 6rpx;
  width: 4rpx;
  height: 4rpx;
  border-radius: 50%;
  background: currentColor;
  box-shadow: 6rpx 0 0 currentColor, 12rpx 0 0 currentColor;
}

/* 间隔：两段中间断开 */
.bt-ico--p-gap::before {
  content: '';
  position: absolute;
  top: 13rpx;
  left: 2rpx;
  width: 8rpx;
  height: 2rpx;
  border-radius: 1rpx;
  background: currentColor;
  box-shadow: 16rpx 0 0 currentColor;
}

/* 扩散：由内向外两圈 */
.bt-ico--p-spread::before {
  content: '';
  position: absolute;
  top: 10rpx;
  left: 10rpx;
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: currentColor;
}

.bt-ico--p-spread::after {
  content: '';
  position: absolute;
  inset: 3rpx;
  border: 2rpx solid currentColor;
  border-radius: 50%;
  box-sizing: border-box;
  opacity: 0.6;
}

/* 尾长：渐细的拖尾 */
.bt-ico--p-tail::before {
  content: '';
  position: absolute;
  top: 12rpx;
  left: 2rpx;
  width: 18rpx;
  height: 4rpx;
  border-radius: 2rpx;
  background: currentColor;
}

.bt-ico--p-tail::after {
  content: '';
  position: absolute;
  top: 13rpx;
  left: 22rpx;
  width: 4rpx;
  height: 2rpx;
  border-radius: 1rpx;
  background: currentColor;
  opacity: 0.5;
}

/* 衰减：阶梯下落 */
.bt-ico--p-decay::before {
  content: '';
  position: absolute;
  top: 6rpx;
  left: 3rpx;
  width: 6rpx;
  height: 6rpx;
  border-radius: 2rpx;
  background: currentColor;
  box-shadow: 8rpx 6rpx 0 currentColor, 16rpx 12rpx 0 currentColor;
}

/* 模式：拨动开关 */
.bt-ico--p-toggle::before {
  content: '';
  position: absolute;
  top: 10rpx;
  left: 2rpx;
  width: 24rpx;
  height: 10rpx;
  border: 2rpx solid currentColor;
  border-radius: 6rpx;
  box-sizing: border-box;
}

.bt-ico--p-toggle::after {
  content: '';
  position: absolute;
  top: 13rpx;
  left: 16rpx;
  width: 4rpx;
  height: 4rpx;
  border-radius: 50%;
  background: currentColor;
}

/* 节奏：高低柱（三根柱顶/底都落在 28rpx 画框内） */
.bt-ico--p-rhythm::before {
  content: '';
  position: absolute;
  top: 14rpx;
  left: 4rpx;
  width: 4rpx;
  height: 8rpx;
  border-radius: 1rpx;
  background: currentColor;
  box-shadow: 8rpx -6rpx 0 currentColor, 16rpx 2rpx 0 currentColor;
}

/* 步长：等距刻度 */
.bt-ico--p-step::before {
  content: '';
  position: absolute;
  top: 12rpx;
  left: 2rpx;
  width: 2rpx;
  height: 6rpx;
  border-radius: 1rpx;
  background: currentColor;
  box-shadow: 8rpx -4rpx 0 currentColor, 16rpx 0 0 currentColor;
}

/* 兜底：小圆点（schema 里新增/未知参数） */
.bt-ico--p-dot::before {
  content: '';
  position: absolute;
  top: 12rpx;
  left: 12rpx;
  width: 4rpx;
  height: 4rpx;
  border-radius: 50%;
  background: currentColor;
}

/* rgb 参数：实心色盘圆点（无进度语义），点开颜色弹层 */
.ring-item__dot {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  box-shadow: inset 0 0 0 2rpx rgba(17, 24, 39, 0.08);
  transition: transform 0.25s ease-out;
}

/* ===== 数字轴（点数值圆环展开，横向拖动） =====
   极简一行：一条细线（手柄在上面滑）+ 当前值。
   名称与百分比在圆环下面那行，这里不重复；不铺刻度数字、不画进度填充——
   它只是"改这个数"的入口，不是第二块图表。 */
.gauge-slot {
  display: grid;
  grid-template-rows: 0fr;
  margin-top: 0;
  transition: grid-template-rows 0.2s ease-out, margin-top 0.2s ease-out;
}

/* 展开态：0fr → 1fr，容器高度跟着内容自然长出来 */
.gauge-slot--open {
  grid-template-rows: 1fr;
  margin-top: 10rpx;
}

/* 过渡期间内容不能溢出，否则收起时会先"露头"再消失 */
.gauge-slot__inner {
  min-height: 0;
  overflow: hidden;
}

/* 一行两段：轴（吃掉剩余宽度）+ 当前值（定宽右对齐） */
.gauge {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 10rpx 8rpx 6rpx;
  border-top: 2rpx solid var(--bt-color-separator);
}

/* 展开：淡入 + 轻微下推；收起：反向淡出（时长与 GAUGE_ANIM_MS 对齐） */
.gauge--in {
  animation: gauge-in 0.2s ease-out both;
}

.gauge--out {
  animation: gauge-out 0.2s ease-in both;
}

@keyframes gauge-in {
  from {
    opacity: 0;
    transform: translateY(-6rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes gauge-out {
  from {
    opacity: 1;
    transform: translateY(0);
  }
  to {
    opacity: 0;
    transform: translateY(-6rpx);
  }
}

/* 当前值：与环下百分比同源，拖动时同步刷新（时长轴是秒，参数轴是百分比） */
.gauge__value {
  flex: 0 0 auto;
  width: 96rpx;
  color: var(--bt-color-label);
  font-size: 24rpx;
  line-height: 32rpx;
  font-weight: 700;
  text-align: right;
}

/* 轨道：只有一条细线（触摸区高 48rpx，手指好按），手柄沿线滑动 */
.gauge__track {
  position: relative;
  flex: 1;
  min-width: 0;
  height: 48rpx;
}

.gauge__track::before {
  content: '';
  position: absolute;
  top: 23rpx;
  left: 8rpx;
  right: 8rpx;
  height: 2rpx;
  border-radius: 2rpx;
  background: var(--bt-color-gray-4);
}

/* 手柄：一枚落在轴上的小圆头（拖它改值） */
.gauge__handle {
  position: absolute;
  top: 16rpx;
  width: 16rpx;
  height: 16rpx;
  margin-left: -8rpx;
  border-radius: 50%;
  border: 2rpx solid var(--bt-color-accent);
  background: var(--bt-color-bg-elevated);
  box-sizing: border-box;
  box-shadow: var(--bt-shadow-card);
}

/* 两格都空时的提示 */
.layer-empty-hint {
  display: block;
  margin-top: 12rpx;
  color: var(--bt-color-label-tertiary);
  font-size: 22rpx;
  line-height: 30rpx;
  text-align: center;
}

/* ===== 灯组配置弹窗（点灯组行的「配置」打开） ===== */
.group-config-mask {
  position: fixed;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
  box-sizing: border-box;
  z-index: 90;
}

.group-config-backdrop {
  position: absolute;
  inset: 0;
  background: rgba(17, 24, 39, 0.4);
}

.group-config-panel {
  position: relative;
  width: 100%;
  max-height: 84vh;
  padding: 28rpx;
  overflow-y: auto;
  border-radius: var(--bt-radius-card);
  background: var(--bt-color-bg-elevated);
  box-shadow: var(--bt-shadow-raised);
  box-sizing: border-box;
}

.group-config-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 8rpx;
}

.group-config-title {
  color: var(--bt-color-label);
  font-size: 32rpx;
  line-height: 42rpx;
  font-weight: 600;
}

.group-config-close {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: var(--bt-color-bg-input);
  color: var(--bt-color-label-secondary);
  font-size: 24rpx;
  line-height: 1;
}

/* ===== 颜色弹层（底部弹板） ===== */
.color-picker-mask {
  position: fixed;
  inset: 0;
  z-index: 100;
  display: flex;
  align-items: flex-end;
}

.color-picker-backdrop {
  position: absolute;
  inset: 0;
  background: rgba(17, 24, 39, 0.4);
}

.color-picker-panel {
  position: relative;
  width: 100%;
  padding: 28rpx 32rpx 48rpx;
  border-radius: 40rpx 40rpx 0 0;
  background: var(--bt-color-bg-elevated);
  box-shadow: var(--bt-shadow-raised);
  box-sizing: border-box;
}

.color-picker-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.color-picker-title {
  color: var(--bt-color-label);
  font-size: 32rpx;
  line-height: 42rpx;
  font-weight: 600;
}

.color-picker-close {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: var(--bt-color-bg-input);
  color: var(--bt-color-label-secondary);
  font-size: 24rpx;
  line-height: 1;
}

/* 色轮 + 右侧预览 */
.picker-main {
  display: flex;
  align-items: center;
  gap: 32rpx;
}

.picker-wheel {
  position: relative;
  flex: 0 0 auto;
  width: 360rpx;
  height: 360rpx;
}

.color-wheel {
  width: 360rpx;
  height: 360rpx;
  border-radius: 50%;
}

/* 色轮上的选色圆点 */
.picker-dot {
  position: absolute;
  width: 28rpx;
  height: 28rpx;
  margin: -14rpx 0 0 -14rpx;
  border-radius: 50%;
  border: 4rpx solid #ffffff;
  box-shadow: 0 0 0 2rpx rgba(17, 24, 39, 0.16);
  box-sizing: border-box;
  pointer-events: none;
}

.picker-side {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.picker-preview {
  width: 120rpx;
  height: 120rpx;
  border-radius: var(--bt-radius-inner);
  box-shadow: inset 0 0 0 2rpx rgba(17, 24, 39, 0.08);
}

.picker-hex {
  margin-top: 14rpx;
  color: var(--bt-color-label);
  font-size: 26rpx;
  line-height: 34rpx;
  font-weight: 600;
}

.picker-hs {
  margin-top: 2rpx;
  color: var(--bt-color-label-tertiary);
  font-size: 20rpx;
  line-height: 28rpx;
}

/* 最近使用色 */
.recent-colors {
  margin-top: 24rpx;
}

.recent-colors__title {
  color: var(--bt-color-label-tertiary);
  font-size: 22rpx;
  line-height: 30rpx;
}

.recent-colors__row {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  margin-top: 10rpx;
}

.color-cell {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  box-shadow: inset 0 0 0 2rpx rgba(17, 24, 39, 0.08);
}

.color-cell--recent {
  transition: transform 0.25s ease-out;
}

.color-cell--recent:active {
  transform: scale(0.92);
}

/* ===== 底部磁贴面板（灯组 / 灯效共用一套外壳） =====
   遮罩 + 从底部升起的弹板 + 标题 + 磁贴网格；两种选择只是在网格里放不同的卡。 */
.pick-mask {
  position: fixed;
  inset: 0;
  z-index: 95;
  display: flex;
  align-items: flex-end;
}

.pick-backdrop {
  position: absolute;
  inset: 0;
  background: rgba(17, 24, 39, 0.4);
}

.pick-panel {
  position: relative;
  width: 100%;
  padding: 28rpx 28rpx 48rpx;
  border-radius: 40rpx 40rpx 0 0;
  background: var(--bt-color-bg-elevated);
  box-shadow: var(--bt-shadow-raised);
  box-sizing: border-box;
  animation: pick-panel-in 0.24s ease-out both;
}

@keyframes pick-panel-in {
  from {
    transform: translateY(100%);
  }
  to {
    transform: translateY(0);
  }
}

.pick-panel__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.pick-panel__title {
  color: var(--bt-color-label);
  font-size: 32rpx;
  line-height: 42rpx;
  font-weight: 600;
}

.pick-panel__close {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: var(--bt-color-bg-input);
  color: var(--bt-color-label-secondary);
  font-size: 24rpx;
  line-height: 1;
}

/* 磁贴网格：默认 4 列（灯效 8 种 = 4×2） */
.pick-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 16rpx;
}

/* 灯组只有 5 个：单行 5 列，名称不被挤成两行 */
.pick-grid--groups {
  grid-template-columns: repeat(5, 1fr);
}

.pick-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  min-height: 112rpx;
  padding: 16rpx 8rpx;
  border-radius: var(--bt-radius-inner);
  background: var(--bt-color-bg-sunken);
  box-sizing: border-box;
  transition: background-color 0.2s ease-out, box-shadow 0.2s ease-out;
}

/* 当前选中（当前灯组 / 当前灯效）：品牌色描边 + tint 底 */
.pick-card--on {
  background: var(--bt-color-accent-soft);
  box-shadow: inset 0 0 0 2rpx var(--bt-color-accent);
}

/* 灯效磁贴：方框图标 + 名称（灯组卡没有图标，只有名称 + 灯珠区间） */
.pick-card__icon {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 72rpx;
  height: 72rpx;
  border-radius: 16rpx;
  /* 面板磁贴里的图标画框（比卡头方块大，一眼可辨） */
  --ico-size: 44rpx;
  background: var(--bt-color-bg-elevated);
  color: var(--bt-color-label-secondary);
  box-sizing: border-box;
  box-shadow: var(--bt-shadow-card);
}

.pick-card--on .pick-card__icon {
  color: var(--bt-color-accent);
}

.pick-card__name {
  overflow: hidden;
  max-width: 100%;
  color: var(--bt-color-label-secondary);
  font-size: 22rpx;
  line-height: 30rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.pick-card--on .pick-card__name {
  color: var(--bt-color-accent);
  font-weight: 600;
}

/* 灯组卡副标题：灯珠区间 */
.pick-card__sub {
  overflow: hidden;
  max-width: 100%;
  color: var(--bt-color-label-tertiary);
  font-size: 18rpx;
  line-height: 26rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* ===== 灯效图标（纯 CSS，在 --ico-size 方框内作图，图标随容器缩放） =====
   卡头方块 48rpx、面板磁贴 72rpx，同一套图形按比例套用，不用维护两份尺寸。 */
.bt-ico {
  position: relative;
  flex-shrink: 0;
  width: var(--ico-size, 56rpx);
  height: var(--ico-size, 56rpx);
}

/* 常亮：实心方块（稳定输出） */
.bt-ico--e-solid::before {
  content: '';
  position: absolute;
  top: calc(var(--ico-size, 56rpx) * 0.25);
  left: calc(var(--ico-size, 56rpx) * 0.25);
  width: calc(var(--ico-size, 56rpx) * 0.5);
  height: calc(var(--ico-size, 56rpx) * 0.5);
  border-radius: calc(var(--ico-size, 56rpx) * 0.14);
  background: currentColor;
}

/* 呼吸：外圈淡、内核实心（由小到大的呼吸） */
.bt-ico--e-breath::before {
  content: '';
  position: absolute;
  top: calc(var(--ico-size, 56rpx) * 0.25);
  left: calc(var(--ico-size, 56rpx) * 0.25);
  width: calc(var(--ico-size, 56rpx) * 0.5);
  height: calc(var(--ico-size, 56rpx) * 0.5);
  border-radius: 50%;
  background: currentColor;
  opacity: 0.35;
}

.bt-ico--e-breath::after {
  content: '';
  position: absolute;
  top: calc(var(--ico-size, 56rpx) * 0.375);
  left: calc(var(--ico-size, 56rpx) * 0.375);
  width: calc(var(--ico-size, 56rpx) * 0.25);
  height: calc(var(--ico-size, 56rpx) * 0.25);
  border-radius: 50%;
  background: currentColor;
}

/* 闪烁：上下两块（亮-灭切换） */
.bt-ico--e-blink::before {
  content: '';
  position: absolute;
  top: calc(var(--ico-size, 56rpx) * 0.23);
  left: calc(var(--ico-size, 56rpx) * 0.25);
  width: calc(var(--ico-size, 56rpx) * 0.5);
  height: calc(var(--ico-size, 56rpx) * 0.18);
  border-radius: calc(var(--ico-size, 56rpx) * 0.07);
  background: currentColor;
}

.bt-ico--e-blink::after {
  content: '';
  position: absolute;
  top: calc(var(--ico-size, 56rpx) * 0.59);
  left: calc(var(--ico-size, 56rpx) * 0.25);
  width: calc(var(--ico-size, 56rpx) * 0.5);
  height: calc(var(--ico-size, 56rpx) * 0.18);
  border-radius: calc(var(--ico-size, 56rpx) * 0.07);
  background: currentColor;
  opacity: 0.35;
}

/* 跑马灯：一列点，末位高亮（逐灯珠点亮） */
.bt-ico--e-marquee::before {
  content: '';
  position: absolute;
  top: calc(var(--ico-size, 56rpx) * 0.45);
  left: calc(var(--ico-size, 56rpx) * 0.18);
  width: calc(var(--ico-size, 56rpx) * 0.14);
  height: calc(var(--ico-size, 56rpx) * 0.14);
  border-radius: 50%;
  background: currentColor;
  box-shadow: calc(var(--ico-size, 56rpx) * 0.18) 0 0 currentColor,
    calc(var(--ico-size, 56rpx) * 0.36) 0 0 currentColor;
  opacity: 0.45;
}

.bt-ico--e-marquee::after {
  content: '';
  position: absolute;
  top: calc(var(--ico-size, 56rpx) * 0.41);
  left: calc(var(--ico-size, 56rpx) * 0.64);
  width: calc(var(--ico-size, 56rpx) * 0.22);
  height: calc(var(--ico-size, 56rpx) * 0.22);
  border-radius: 50%;
  background: currentColor;
}

/* 彩虹渐变：上半弧 + 下半浅色（色相环） */
.bt-ico--e-rainbow::before {
  content: '';
  position: absolute;
  top: calc(var(--ico-size, 56rpx) * 0.18);
  left: calc(var(--ico-size, 56rpx) * 0.18);
  width: calc(var(--ico-size, 56rpx) * 0.64);
  height: calc(var(--ico-size, 56rpx) * 0.64);
  border-radius: 50%;
  border: calc(var(--ico-size, 56rpx) * 0.09) solid currentColor;
  box-sizing: border-box;
  clip-path: inset(0 0 50% 0);
}

.bt-ico--e-rainbow::after {
  content: '';
  position: absolute;
  top: calc(var(--ico-size, 56rpx) * 0.46);
  left: calc(var(--ico-size, 56rpx) * 0.18);
  width: calc(var(--ico-size, 56rpx) * 0.64);
  height: calc(var(--ico-size, 56rpx) * 0.18);
  border-radius: 0 0 50% 50%;
  background: currentColor;
  opacity: 0.4;
}

/* 流星拖尾：亮头 + 斜向渐隐尾 */
.bt-ico--e-meteor::before {
  content: '';
  position: absolute;
  top: calc(var(--ico-size, 56rpx) * 0.36);
  left: calc(var(--ico-size, 56rpx) * 0.6);
  width: calc(var(--ico-size, 56rpx) * 0.22);
  height: calc(var(--ico-size, 56rpx) * 0.22);
  border-radius: 50%;
  background: currentColor;
}

.bt-ico--e-meteor::after {
  content: '';
  position: absolute;
  top: calc(var(--ico-size, 56rpx) * 0.44);
  left: calc(var(--ico-size, 56rpx) * 0.14);
  width: calc(var(--ico-size, 56rpx) * 0.43);
  height: calc(var(--ico-size, 56rpx) * 0.07);
  border-radius: calc(var(--ico-size, 56rpx) * 0.04);
  background: linear-gradient(to right, transparent, currentColor);
  transform: rotate(-15deg);
}

/* 双色渐变：左右两块拼合（左实右浅） */
.bt-ico--e-dual::before {
  content: '';
  position: absolute;
  top: calc(var(--ico-size, 56rpx) * 0.25);
  left: calc(var(--ico-size, 56rpx) * 0.25);
  width: calc(var(--ico-size, 56rpx) * 0.23);
  height: calc(var(--ico-size, 56rpx) * 0.5);
  border-radius: calc(var(--ico-size, 56rpx) * 0.14) 0 0 calc(var(--ico-size, 56rpx) * 0.14);
  background: currentColor;
}

.bt-ico--e-dual::after {
  content: '';
  position: absolute;
  top: calc(var(--ico-size, 56rpx) * 0.25);
  left: calc(var(--ico-size, 56rpx) * 0.52);
  width: calc(var(--ico-size, 56rpx) * 0.23);
  height: calc(var(--ico-size, 56rpx) * 0.5);
  border-radius: 0 calc(var(--ico-size, 56rpx) * 0.14) calc(var(--ico-size, 56rpx) * 0.14) 0;
  background: currentColor;
  opacity: 0.4;
}

/* 律动跳变：高低不一的柱（节奏） */
.bt-ico--e-rhythm::before {
  content: '';
  position: absolute;
  top: calc(var(--ico-size, 56rpx) * 0.43);
  left: calc(var(--ico-size, 56rpx) * 0.21);
  width: calc(var(--ico-size, 56rpx) * 0.12);
  height: calc(var(--ico-size, 56rpx) * 0.32);
  border-radius: calc(var(--ico-size, 56rpx) * 0.06);
  background: currentColor;
  box-shadow: calc(var(--ico-size, 56rpx) * 0.21) calc(var(--ico-size, 56rpx) * -0.21) 0 currentColor,
    calc(var(--ico-size, 56rpx) * 0.43) calc(var(--ico-size, 56rpx) * 0.07) 0 currentColor;
}

/* ===== 灯珠拖选取消区 ===== */
.led-cancel-zone {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 120;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 160rpx;
  background: rgba(17, 24, 39, 0.32);
}

.led-cancel-zone--active {
  background: rgba(255, 56, 60, 0.72);
}

.led-cancel-zone__text {
  color: #ffffff;
  font-size: 26rpx;
  line-height: 36rpx;
  font-weight: 600;
}

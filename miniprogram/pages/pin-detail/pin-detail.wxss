/* 引脚配置详情页样式（ADR-0027 / #27 / T7；范式 B 工具页，design.md §7.3）。 */

.page {
  padding: 0 0 176rpx; /* 底部给固定玻璃保存栏留位 */
}

/* 顶部：图片 / 名称 / 开关 */
.pin-head {
  display: flex;
  align-items: center;
}

.pin-head__img {
  width: 120rpx;
  height: 120rpx;
  border-radius: 16rpx;
  background: var(--bt-color-bg-input);
  margin-right: 24rpx;
}

.pin-head__info {
  flex: 1;
}

.pin-head__name {
  font-size: 34rpx;
  line-height: 44rpx;
  font-weight: 600;
  height: 64rpx;
}

/* 灯组 Tab（固定 5 个；横向滚动防拥挤，design.md §5.4 热区 88rpx） */
.group-tabs {
  white-space: nowrap;
  padding: 12rpx 32rpx;
}

.group-tab {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-width: 140rpx;
  height: 88rpx;
  padding: 8rpx 24rpx;
  margin-right: 12rpx;
  background: var(--bt-color-bg-elevated);
  border-radius: 20rpx;
  box-sizing: border-box;
  transition: background-color 0.25s ease-out, color 0.25s ease-out;
}

.group-tab--active {
  background: var(--bt-color-accent);
}

.group-tab__name {
  font-size: 28rpx;
  line-height: 36rpx;
  color: var(--bt-color-label);
  transition: color 0.25s ease-out;
}

.group-tab--active .group-tab__name {
  color: #ffffff;
}

.group-tab__range {
  font-size: 22rpx;
  line-height: 30rpx;
  color: var(--bt-color-label-tertiary);
  transition: color 0.25s ease-out;
}

.group-tab--active .group-tab__range {
  color: rgba(255, 255, 255, 0.75);
}

/* 通用行：标签 + 控件 */
.row {
  display: flex;
  align-items: center;
  margin-top: 16rpx;
}

.row__label {
  width: 160rpx;
  font-size: 28rpx;
  line-height: 38rpx;
  color: var(--bt-color-label-secondary);
}

.row__input {
  flex: 1;
  height: 64rpx;
  padding: 0 16rpx;
  background: var(--bt-color-bg-input);
  border-radius: 12rpx;
  font-size: 28rpx;
  line-height: 64rpx;
  text-align: center;
  box-sizing: border-box;
}

.row__input--num {
  max-width: 200rpx;
}

.row__picker {
  flex: 1;
  padding: 0 16rpx;
  height: 64rpx;
  background: var(--bt-color-bg-input);
  border-radius: 12rpx;
  font-size: 28rpx;
  line-height: 64rpx;
  text-align: center;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

/* 灯珠范围（视觉 60rpx 方格，点击热区经 margin 扩至 ~88rpx，design.md §5.4） */
.range {
  margin-top: 24rpx;
}

.range__title {
  font-size: 28rpx;
  line-height: 38rpx;
  font-weight: 600;
}

.led-grid {
  display: grid;
  grid-template-columns: repeat(10, 1fr);
  gap: 16rpx;
  margin: 8rpx 0 0;
  touch-action: none;
  max-height: 50vh;
  overflow-y: auto;
  overflow-x: hidden;
}

.led-cell {
  width: 100%;
  aspect-ratio: 1;
  min-height: 48rpx;
  border-radius: 12rpx;
  background: var(--bt-color-bg-input);
  color: var(--bt-color-label-tertiary);
  font-size: 20rpx;
  line-height: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  transition: background-color 0.15s ease-out, color 0.15s ease-out, box-shadow 0.15s ease-out;
}

.led-cell--occupied {
  background: var(--bt-color-gray-4);
  color: var(--bt-color-gray-5);
  opacity: 0.6;
}

/* 已选中（松手后生效）：实心蓝底白字 */
.led-cell--selected {
  background: var(--bt-color-accent);
  color: #ffffff;
}

/* 被其他灯组占用：灰色不可选 */
.led-cell--occupied {
  background: var(--bt-color-gray-4);
  color: var(--bt-color-label-quaternary);
}

/* 拖选起点/终点：蓝框白底（高亮边框） */
.led-cell--drag-start,
.led-cell--drag-end {
  background: #ffffff;
  color: var(--bt-color-accent);
  box-shadow: inset 0 0 0 3rpx var(--bt-color-accent);
}

/* 拖选中间：浅蓝连接条 */
.led-cell--drag-mid {
  background: rgba(0, 136, 255, 0.2);
  color: var(--bt-color-accent);
}

.range__hint {
  margin-top: 12rpx;
  font-size: 22rpx;
  line-height: 32rpx;
  color: var(--bt-color-label-tertiary);
}

.range__actions {
  margin-top: 16rpx;
  display: flex;
  justify-content: flex-end;
}

.range__clear {
  padding: 12rpx 28rpx;
  font-size: 26rpx;
  line-height: 40rpx;
  color: var(--bt-color-danger);
  background: var(--bt-color-bg-input);
  border-radius: 999rpx;
}


/* 阶段标题行：左标题 + 右添加（满 5 禁用态） */
.stage-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 16rpx;
}

.stage-head__title {
  font-size: 28rpx;
  line-height: 38rpx;
  font-weight: 600;
  color: var(--bt-color-label);
}

/* 横向阶段分段条（N 段等宽拼成整体圆角矩形；轻点选中、长按拖动排序） */
.stage-bar__scroll {
  width: 100%;
  white-space: nowrap;
}

.stage-inner {
  display: flex;
  margin: 0 24rpx;
  height: 120rpx;
  background: var(--bt-color-bg-elevated);
  border: 2rpx solid rgba(0, 0, 0, 0.08);
  border-radius: 20rpx;
  overflow: hidden;
}

.stage-seg {
  position: relative;
  flex: 0 0 auto;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-width: 0;
  transition: transform 0.2s ease, background 0.2s ease;
}

.stage-seg + .stage-seg {
  border-left: 2rpx solid rgba(0, 0, 0, 0.08);
}

.stage-seg--active {
  background: rgba(0, 136, 255, 0.12);
}

.stage-seg--drag {
  transition: none;
  z-index: 2;
  background: var(--bt-color-bg-elevated);
}

.stage-seg__num {
  font-size: 30rpx;
  line-height: 36rpx;
  font-weight: 600;
  color: var(--bt-color-label);
}

.stage-seg--active .stage-seg__num {
  color: var(--bt-color-accent);
}

.stage-seg__name {
  max-width: 100%;
  padding: 0 8rpx;
  font-size: 22rpx;
  line-height: 28rpx;
  color: var(--bt-color-label-tertiary);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.stage-seg__info {
  font-size: 22rpx;
  line-height: 28rpx;
  color: var(--bt-color-label-tertiary);
}

.stage-seg__dot--enter {
  animation: stage-node-in 0.22s ease;
}

.stage-seg--enter {
  animation: stage-seg-in 0.22s ease;
}

@keyframes stage-seg-in {
  from {
    opacity: 0;
  }
  to {
    opacity: 1;
  }
}

@keyframes stage-node-in {
  from {
    transform: scale(0.4);
    opacity: 0;
  }
  to {
    transform: scale(1);
    opacity: 1;
  }
}

.stage-add {
  flex: 0 0 auto;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  border: 2rpx dashed var(--bt-color-accent);
  color: var(--bt-color-accent);
  font-size: 32rpx;
}

.stage-add--disabled {
  border-color: rgba(0, 0, 0, 0.15);
  color: var(--bt-color-label-tertiary);
}

/* 阶段详情气泡卡片：箭头指向当前选中阶段（left 由 JS 按段中心写入 --bubble-x） */
.step-bubble {
  position: relative;
  margin: 24rpx 24rpx 0;
  padding: 20rpx 20rpx 24rpx;
  background: var(--bt-color-bg-elevated);
  border-radius: 20rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.08);
}

.step-bubble__arrow {
  position: absolute;
  top: -12rpx;
  left: var(--bubble-x, 50%);
  transform: translateX(-50%);
  width: 24rpx;
  height: 24rpx;
  background: var(--bt-color-bg-elevated);
  border-left: 2rpx solid rgba(0, 0, 0, 0.08);
  border-top: 2rpx solid rgba(0, 0, 0, 0.08);
  transform: translateX(-50%) rotate(45deg);
  border-radius: 4rpx 0 0 0;
}

/* 阶段详情（横向阶段条下方的参数编辑区） */
.step-detail {
  margin-top: 0;
}

.step-detail__head {
  display: flex;
  align-items: center;
  margin-bottom: 8rpx;
}

.step-detail__title {
  flex: 1;
  text-align: left;
  font-size: 28rpx;
  line-height: 38rpx;
  font-weight: 600;
  color: var(--bt-color-label);
}

/* 时长行独占；过渡/循环并排一行 */
.row--two {
  flex-wrap: wrap;
  gap: 16rpx;
}

.row__half {
  flex: 1;
  display: flex;
  align-items: center;
  min-width: 40%;
}

.row__half .row__label {
  width: 100rpx;
}

.step__del {
  font-size: 24rpx;
  line-height: 34rpx;
  color: var(--bt-color-danger);
}

/* 底部删除当前阶段按钮（页面最下面，仅剩 1 个阶段时隐藏） */
.del-stage {
  margin: 24rpx 32rpx 8rpx;
  padding: 20rpx;
  text-align: center;
  font-size: 28rpx;
  line-height: 38rpx;
  font-weight: 600;
  color: #ffffff;
  background: var(--bt-color-danger);
  border-radius: 16rpx;
}

/* 图层（卡内嵌块：elevated 卡内用 grouped 底，同心圆角） */
.layer {
  margin-top: 16rpx;
  padding: 16rpx;
  background: var(--bt-color-bg-input);
  border-radius: 12rpx;
}

.layer__head {
  margin-bottom: 8rpx;
}

.layer__title {
  font-size: 28rpx;
  line-height: 38rpx;
  font-weight: 600;
}

.layer__effect {
  margin-bottom: 8rpx;
}

/* 参数行（rgb 色块预览） */
.param {
  margin-top: 12rpx;
}

/* rgb 色块预览：点击弹层 */
.color-swatch {
  width: 96rpx;
  height: 64rpx;
  flex: 0 0 auto;
  border-radius: 12rpx;
  box-shadow: inset 0 0 0 2rpx var(--bt-color-bg-input);
}

/* 颜色弹层（#33） */
.color-picker-mask {
  position: fixed;
  inset: 0;
  z-index: 200;
  display: flex;
  align-items: flex-end;
}

.color-picker-backdrop {
  position: absolute;
  inset: 0;
  background: rgba(0, 0, 0, 0.4);
}

.color-picker-panel {
  position: relative;
  width: 100%;
  max-height: 60vh;
  overflow-y: auto;
  background: var(--bt-color-bg-elevated);
  border-radius: 28rpx 28rpx 0 0;
  padding: 24rpx 32rpx 48rpx;
  box-shadow: 0 -24rpx 64rpx rgba(0, 0, 0, 0.2);
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.color-picker-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.color-picker-title {
  font-size: 32rpx;
  line-height: 44rpx;
  font-weight: 700;
  color: var(--bt-color-label);
}

.color-picker-close {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  line-height: 40rpx;
  color: var(--bt-color-label-secondary);
  border-radius: 999rpx;
  background: var(--bt-color-bg-input);
}

.color-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 16rpx;
  margin-top: 8rpx;
}

.color-cell {
  width: 100%;
  aspect-ratio: 1;
  border-radius: 12rpx;
  box-shadow: inset 0 0 0 2rpx rgba(0, 0, 0, 0.1);
}

.color-cell--recent {
  width: 80rpx;
  height: 80rpx;
  flex: 0 0 auto;
}

.recent-colors {
  margin-top: 16rpx;
}

.recent-colors__title {
  font-size: 26rpx;
  line-height: 36rpx;
  color: var(--bt-color-label-secondary);
}

.recent-colors__row {
  display: flex;
  gap: 12rpx;
  flex-wrap: wrap;
  margin-top: 12rpx;
}

/* 图层头（摘要行 + 箭头 + 删除） */
.layer__head-actions {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.layer__arrow {
  font-size: 24rpx;
  line-height: 34rpx;
  color: var(--bt-color-label-tertiary);
}

/* 添加按钮（次级虚线按钮） */
.add-layer {
  margin-top: 16rpx;
  padding: 12rpx;
  text-align: center;
  font-size: 28rpx;
  line-height: 38rpx;
  color: var(--bt-color-accent);
  border: 2rpx dashed var(--bt-color-accent);
  border-radius: 12rpx;
  transition: background-color 0.25s ease-out;
}

.add-layer:active {
  background-color: rgba(0, 136, 255, 0.08);
}

/* 同步状态条（autoSync 驱动，嵌在页面顶部）：四态小字，failed 可点重试 */
.sync-bar {
  padding: 8rpx 32rpx;
  font-size: 24rpx;
  line-height: 1.4;
  color: var(--bt-color-label-secondary);
}

.sync-bar--syncing {
  color: var(--bt-color-accent);
}

.sync-bar--synced {
  color: var(--bt-color-label-secondary);
}

.sync-bar--failed {
  color: var(--bt-color-danger);
}

.sync-bar--local {
  color: var(--bt-color-label-tertiary);
}
/* 灯组配置弹窗（长按灯组 Tab 打开）：居中面板，名称 + 灯珠范围拖选内嵌。 */
.group-config-mask {
  position: fixed;
  inset: 0;
  z-index: 90;
  display: flex;
  align-items: center;
  justify-content: center;
}

.group-config-backdrop {
  position: absolute;
  inset: 0;
  background: rgba(0, 0, 0, 0.4);
}

.group-config-panel {
  position: relative;
  width: 90vw;
  max-width: 720rpx;
  max-height: 80vh;
  overflow-y: auto;
  background: var(--bt-color-bg-elevated);
  border-radius: 28rpx;
  padding: 24rpx;
  box-shadow: 0 24rpx 64rpx rgba(0, 0, 0, 0.2);
  display: flex;
  flex-direction: column;
}

.group-config-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.group-config-title {
  font-size: 32rpx;
  line-height: 44rpx;
  font-weight: 700;
  color: var(--bt-color-label);
}

.group-config-close {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  line-height: 40rpx;
  color: var(--bt-color-label-secondary);
  border-radius: 999rpx;
  background: var(--bt-color-bg-input);
}

/* 取消区：fixed 屏幕底部，与弹窗物理分离，永不遮挡方格 */
.led-cancel-zone {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  height: 80rpx;
  z-index: 101;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(180deg, rgba(255, 56, 60, 0) 0%, rgba(255, 56, 60, 0.25) 40%, rgba(255, 56, 60, 0.45) 100%);
  transition: background 0.2s ease-out;
}

.led-cancel-zone--active {
  background: linear-gradient(180deg, rgba(255, 56, 60, 0.1) 0%, rgba(255, 56, 60, 0.45) 40%, rgba(255, 56, 60, 0.7) 100%);
}

.led-cancel-zone__text {
  font-size: 28rpx;
  line-height: 40rpx;
  color: #ffffff;
  font-weight: 600;
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.25);
}

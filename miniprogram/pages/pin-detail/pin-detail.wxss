/* 引脚配置详情页样式（ADR-0027 / #27 / T7；design.md §7.3 工具页范式）。
   柔光通透语言：白卡 + 大圆角 + 极轻阴影，控件走药丸/tint 底。
   注意：.brightness-spark 之外的 canvas 选择器类名（.stage-inner / .effect3d-canvas /
   .color-wheel / .led-grid / .led-cell / .picker-wheel）被 JS 的
   createSelectorQuery 使用，改名会让真机画布失效。 */

/* 底部给悬浮 Dock 留位，另留页面自身滚动余量 */
.page {
  padding: 0 0 220rpx;
}

/* ===== 顶部信息卡：引脚图 + 名称 + 灯组选择 ===== */
.pin-head-card {
  padding: 28rpx;
}

.pin-head {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.pin-head__img {
  flex-shrink: 0;
  width: 128rpx;
  height: 128rpx;
  border-radius: var(--bt-radius-inner);
  background: var(--bt-color-bg-sunken);
}

.pin-head__info {
  flex: 1;
  min-width: 0;
}

.pin-head__name {
  height: 60rpx;
  color: var(--bt-color-label);
  font-size: 38rpx;
  line-height: 60rpx;
  font-weight: 700;
}

.pin-head__placeholder {
  color: var(--bt-color-label-quaternary);
}

/* 开关行：引脚号（左）+ switch（右） */
.pin-head__switch-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 4rpx;
}

.pin-head__pin-no {
  color: var(--bt-color-label-tertiary);
  font-size: 24rpx;
  line-height: 34rpx;
}

/* 灯组选择：药丸容器内嵌 picker + 配置按钮 */
.group-select {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 24rpx;
}

.group-select__picker {
  flex: 1;
  min-width: 0;
}

.group-select__value {
  display: flex;
  align-items: center;
  height: 96rpx;
  padding: 0 24rpx;
  border-radius: var(--bt-radius-pill);
  background: var(--bt-color-bg-input);
  box-sizing: border-box;
}

.group-select__text {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.group-select__name {
  overflow: hidden;
  color: var(--bt-color-label);
  font-size: 30rpx;
  line-height: 40rpx;
  font-weight: 600;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.group-select__range {
  color: var(--bt-color-label-tertiary);
  font-size: 22rpx;
  line-height: 30rpx;
}

.group-select__arrow {
  flex: 0 0 auto;
  margin-left: 12rpx;
  color: var(--bt-color-label-tertiary);
  font-size: 18rpx;
  line-height: 28rpx;
}

.group-select__config {
  flex: 0 0 auto;
  height: 96rpx;
  padding: 0 32rpx;
  border-radius: var(--bt-radius-pill);
  background: var(--bt-color-accent-soft);
  color: var(--bt-color-accent);
  font-size: 28rpx;
  line-height: 96rpx;
  font-weight: 600;
  box-sizing: border-box;
}

/* ===== 通用行：标签 + 控件 ===== */
.row {
  display: flex;
  align-items: center;
  margin-top: 16rpx;
}

.row__label {
  flex-shrink: 0;
  width: 148rpx;
  color: var(--bt-color-label-secondary);
  font-size: 26rpx;
  line-height: 38rpx;
}

.row__input {
  flex: 1;
  height: 72rpx;
  padding: 0 20rpx;
  border-radius: var(--bt-radius-inner);
  background: var(--bt-color-bg-input);
  color: var(--bt-color-label);
  font-size: 28rpx;
  line-height: 72rpx;
  box-sizing: border-box;
}

.row__input--num {
  max-width: 200rpx;
  text-align: center;
}

/* 时长 / 参数滑块：标签 + 滑块 + 数字输入框 */
.row__slider {
  flex: 1;
  margin: 0 12rpx;
}

.row__slider-input {
  flex: 0 0 auto;
  width: 100rpx;
  max-width: 100rpx;
}

.param-slider__bar {
  flex: 1;
  min-width: 0;
  margin-right: 12rpx;
}

/* 枚举单选：胶囊组，选中实心品牌色 */
.param-radio {
  flex: 1;
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  justify-content: flex-end;
}

.param-radio__item {
  padding: 10rpx 24rpx;
  border-radius: var(--bt-radius-pill);
  background: var(--bt-color-bg-input);
  color: var(--bt-color-label-secondary);
  font-size: 26rpx;
  line-height: 36rpx;
  transition: background-color 0.25s ease-out, color 0.25s ease-out;
}

.param-radio__item--on {
  background: var(--bt-color-accent);
  color: #ffffff;
  font-weight: 600;
}

.row__picker {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 72rpx;
  padding: 0 20rpx;
  border-radius: var(--bt-radius-inner);
  background: var(--bt-color-bg-input);
  color: var(--bt-color-label);
  font-size: 28rpx;
  line-height: 72rpx;
  text-align: center;
  box-sizing: border-box;
}

/* ===== 灯珠范围（视觉方格，点击热区经 margin 扩展） ===== */
.range {
  margin-top: 24rpx;
}

.range__title {
  color: var(--bt-color-label);
  font-size: 28rpx;
  line-height: 38rpx;
  font-weight: 600;
}

.led-grid {
  display: grid;
  grid-template-columns: repeat(10, 1fr);
  gap: 14rpx;
  max-height: 50vh;
  margin: 12rpx 0 0;
  overflow-x: hidden;
  overflow-y: auto;
  touch-action: none;
}

.led-cell {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  aspect-ratio: 1;
  min-height: 48rpx;
  border-radius: 12rpx;
  background: var(--bt-color-bg-input);
  color: var(--bt-color-label-quaternary);
  font-size: 20rpx;
  line-height: 1;
  box-sizing: border-box;
  transition: background-color 0.15s ease-out, color 0.15s ease-out, box-shadow 0.15s ease-out;
}

/* 已选中（松手后生效）：实心品牌色 */
.led-cell--selected {
  background: var(--bt-color-accent);
  color: #ffffff;
  font-weight: 600;
}

/* 被其他灯组占用：灰底不可选 */
.led-cell--occupied {
  background: var(--bt-color-gray-4);
  color: var(--bt-color-label-quaternary);
  opacity: 0.6;
}

/* 拖选起点/终点：白底 + 品牌色描边 */
.led-cell--drag-start,
.led-cell--drag-end {
  background: var(--bt-color-bg-elevated);
  color: var(--bt-color-accent);
  box-shadow: inset 0 0 0 3rpx var(--bt-color-accent);
}

/* 拖选中间：品牌色浅底 */
.led-cell--drag-mid {
  background: var(--bt-color-accent-soft-2);
  color: var(--bt-color-accent);
}

.range__hint {
  margin-top: 14rpx;
  color: var(--bt-color-label-tertiary);
  font-size: 22rpx;
  line-height: 32rpx;
}

.range__actions {
  display: flex;
  justify-content: flex-end;
  margin-top: 16rpx;
}

.range__clear {
  padding: 12rpx 28rpx;
  border-radius: var(--bt-radius-pill);
  background: var(--bt-color-danger-soft);
  color: var(--bt-color-danger);
  font-size: 26rpx;
  line-height: 36rpx;
  font-weight: 600;
}

/* ===== 阶段标题行 ===== */
.stage-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 32rpx 40rpx 0;
}

.stage-head__title {
  color: var(--bt-color-label);
  font-size: 30rpx;
  line-height: 40rpx;
  font-weight: 600;
}

/* 添加阶段：品牌色 tint 圆钮 */
.stage-add {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 auto;
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: var(--bt-color-accent-soft);
  color: var(--bt-color-accent);
  font-size: 32rpx;
  line-height: 1;
}

.stage-add--disabled {
  background: var(--bt-color-bg-input);
  color: var(--bt-color-label-quaternary);
}

/* ===== 横向阶段分段条 ===== */
.stage-bar__scroll {
  width: 100%;
  margin-top: 12rpx;
  white-space: nowrap;
}

.stage-inner {
  display: flex;
  height: 128rpx;
  margin: 0 32rpx;
  overflow: hidden;
  border-radius: var(--bt-radius-card);
  background: var(--bt-color-bg-elevated);
  box-shadow: var(--bt-shadow-card);
}

.stage-seg {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  flex: 0 0 auto;
  min-width: 0;
  transition: transform 0.2s ease, background-color 0.2s ease;
}

/* 段间分隔：极淡一条，不用黑边 */
.stage-seg + .stage-seg {
  border-left: 1rpx solid var(--bt-color-separator);
}

.stage-seg--active {
  background: var(--bt-color-accent-soft);
}

.stage-seg--drag {
  z-index: 2;
  background: var(--bt-color-bg-elevated);
  box-shadow: var(--bt-shadow-raised);
  transition: none;
}

.stage-seg__num {
  color: var(--bt-color-label);
  font-size: 32rpx;
  line-height: 38rpx;
  font-weight: 600;
}

.stage-seg--active .stage-seg__num {
  color: var(--bt-color-accent);
}

.stage-seg__name {
  max-width: 100%;
  padding: 0 8rpx;
  overflow: hidden;
  color: var(--bt-color-label-secondary);
  font-size: 22rpx;
  line-height: 28rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.stage-seg__info {
  color: var(--bt-color-label-tertiary);
  font-size: 20rpx;
  line-height: 26rpx;
}

.stage-seg--enter {
  animation: stage-seg-in 0.22s ease;
}

@keyframes stage-seg-in {
  from {
    opacity: 0;
  }
  to {
    opacity: 1;
  }
}

/* ===== 阶段时间轴图（泳道甘特） ===== */
.timeline {
  margin: 20rpx 32rpx 0;
  padding: 20rpx;
  border-radius: var(--bt-radius-card);
  background: var(--bt-color-bg-elevated);
  box-shadow: var(--bt-shadow-card);
}

.timeline__head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 14rpx;
}

.timeline__title {
  color: var(--bt-color-label);
  font-size: 26rpx;
  line-height: 34rpx;
  font-weight: 600;
}

.timeline__total {
  color: var(--bt-color-label-tertiary);
  font-size: 22rpx;
  line-height: 30rpx;
}

/* 轨道：段按 left/width 百分比铺满 */
.timeline__track {
  position: relative;
  height: 72rpx;
  overflow: hidden;
  border-radius: 14rpx;
  background: var(--bt-color-bg-input);
}

.timeline__seg {
  position: absolute;
  top: 0;
  display: flex;
  flex-direction: column;
  justify-content: center;
  height: 100%;
  padding: 0 6rpx;
  box-sizing: border-box;
  border-right: 2rpx solid var(--bt-color-bg-elevated);
  transition: background-color 0.2s ease;
}

.timeline__seg--active {
  background: var(--bt-color-accent-soft-2);
}

/* 段内图层子条：横排堆叠，颜色=灯效主题色 */
.timeline__layers {
  display: flex;
  height: 24rpx;
  overflow: hidden;
  border-radius: 8rpx;
}

.timeline__layer {
  height: 100%;
}

/* 过渡区间：段尾斜纹 */
.timeline__trans {
  position: absolute;
  top: 6rpx;
  bottom: 6rpx;
  border-radius: 6rpx;
  background-image: repeating-linear-gradient(
    45deg,
    rgba(255, 255, 255, 0.55) 0,
    rgba(255, 255, 255, 0.55) 4rpx,
    rgba(17, 24, 39, 0.12) 4rpx,
    rgba(17, 24, 39, 0.12) 8rpx
  );
  pointer-events: none;
}

.timeline__label {
  margin-top: 6rpx;
  overflow: hidden;
  color: var(--bt-color-label-tertiary);
  font-size: 20rpx;
  line-height: 26rpx;
  text-align: center;
  white-space: nowrap;
}

/* 图例：灯效色点 + 名称 */
.timeline__legend {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx 20rpx;
  margin-top: 14rpx;
}

.timeline__legend-item {
  display: flex;
  align-items: center;
}

.timeline__legend-dot {
  width: 14rpx;
  height: 14rpx;
  margin-right: 8rpx;
  border-radius: 50%;
}

.timeline__legend-text {
  color: var(--bt-color-label-tertiary);
  font-size: 22rpx;
  line-height: 30rpx;
}

/* ===== 阶段详情气泡卡片 ===== */
.step-bubble {
  position: relative;
  margin: 20rpx 32rpx 0;
  padding: 24rpx;
  border-radius: var(--bt-radius-card);
  background: var(--bt-color-bg-elevated);
  box-shadow: var(--bt-shadow-card);
}

/* 箭头：用白卡三角指向当前阶段（border 三角比旋转方块更稳） */
.step-bubble__arrow {
  position: absolute;
  top: -12rpx;
  left: var(--bubble-x, 50%);
  width: 0;
  height: 0;
  margin-left: -12rpx;
  border-left: 12rpx solid transparent;
  border-right: 12rpx solid transparent;
  border-bottom: 12rpx solid var(--bt-color-bg-elevated);
}

.step-detail {
  margin-top: 0;
}

.step-detail__head {
  display: flex;
  align-items: center;
  margin-bottom: 8rpx;
}

.step-detail__title {
  flex: 1;
  color: var(--bt-color-label);
  font-size: 30rpx;
  line-height: 40rpx;
  font-weight: 600;
  text-align: left;
}

/* 过渡/循环并排一行 */
.row--two {
  flex-wrap: wrap;
  gap: 16rpx;
}

.row__half {
  flex: 1;
  display: flex;
  align-items: center;
  min-width: 40%;
}

.row__half .row__label {
  width: 96rpx;
}

/* 底部删除当前阶段 */
.del-stage {
  margin: 28rpx 0 8rpx;
  padding: 22rpx;
  border-radius: var(--bt-radius-inner);
  background: var(--bt-color-danger-soft);
  color: var(--bt-color-danger);
  font-size: 28rpx;
  line-height: 38rpx;
  font-weight: 600;
  text-align: center;
}

/* ===== 图层两列槽位卡 ===== */
.layer-grid {
  display: flex;
  flex-wrap: wrap;
  margin-top: 20rpx;
}

.layer-card {
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
  width: calc((100% - 16rpx) / 2);
  min-height: 176rpx;
  margin-right: 16rpx;
  margin-bottom: 16rpx;
  padding: 20rpx;
  border-radius: var(--bt-radius-inner);
  background: var(--bt-color-bg-sunken);
}

.layer-card:nth-child(2n) {
  margin-right: 0;
}

.layer-card__top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.layer-card__title {
  overflow: hidden;
  color: var(--bt-color-label-tertiary);
  font-size: 22rpx;
  line-height: 32rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 右上角删除：48rpx 热区，负边距抵掉多出的高度 */
.layer-card__del {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 auto;
  width: 48rpx;
  height: 48rpx;
  margin: -7rpx -8rpx -7rpx 8rpx;
  border-radius: 50%;
  color: var(--bt-color-danger);
  font-size: 24rpx;
  line-height: 1;
}

.layer-card__mid {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 10rpx;
}

/* 首个 rgb 参数作色块预览 */
.layer-card__swatch {
  flex: 0 0 auto;
  width: 40rpx;
  height: 40rpx;
  border-radius: 12rpx;
  box-shadow: inset 0 0 0 2rpx rgba(17, 24, 39, 0.08);
}

.layer-card__swatch--none {
  background: var(--bt-color-bg-elevated);
  box-shadow: inset 0 0 0 2rpx var(--bt-color-gray-4);
}

.layer-card__effect {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  color: var(--bt-color-label);
  font-size: 30rpx;
  line-height: 40rpx;
  font-weight: 600;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 渐变色带：多色灯效在卡片上直接展示配色 */
.layer-card__gradient {
  height: 12rpx;
  margin-top: 12rpx;
  border-radius: 999rpx;
}

.layer-card__summary {
  margin-top: auto;
  padding-top: 10rpx;
  overflow: hidden;
  color: var(--bt-color-label-tertiary);
  font-size: 22rpx;
  line-height: 30rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 空槽卡：虚线描边 + 居中「＋ 添加」 */
.layer-card--empty {
  align-items: stretch;
  background: transparent;
  border: 2rpx dashed var(--bt-color-accent-soft-2);
}

.layer-card__empty-body {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.layer-card__plus {
  color: var(--bt-color-accent);
  font-size: 40rpx;
  line-height: 48rpx;
}

.layer-card__add-text {
  margin-top: 4rpx;
  color: var(--bt-color-accent);
  font-size: 24rpx;
  line-height: 34rpx;
}

/* 两格都空时的提示 */
.layer-empty-hint {
  display: block;
  margin-top: 8rpx;
  color: var(--bt-color-label-tertiary);
  font-size: 22rpx;
  line-height: 30rpx;
  text-align: center;
}

/* ===== 底部弹层通用（图层编辑 / 灯组配置） ===== */
.layer-editor-mask,
.group-config-mask {
  position: fixed;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
  box-sizing: border-box;
}

.layer-editor-mask {
  z-index: 95;
}

.group-config-mask {
  z-index: 90;
}

.layer-editor-backdrop,
.group-config-backdrop {
  position: absolute;
  inset: 0;
  background: rgba(17, 24, 39, 0.4);
}

.layer-editor-panel,
.group-config-panel {
  position: relative;
  display: flex;
  flex-direction: column;
  width: 100%;
  max-height: 82vh;
  padding: 28rpx;
  overflow-y: auto;
  border-radius: 40rpx;
  background: var(--bt-color-bg-elevated);
  box-shadow: var(--bt-shadow-raised);
  box-sizing: border-box;
}

.layer-editor-head,
.group-config-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.layer-editor-title,
.group-config-title {
  flex: 1;
  min-width: 0;
  color: var(--bt-color-label);
  font-size: 32rpx;
  line-height: 44rpx;
  font-weight: 700;
}

.layer-editor-close,
.group-config-close,
.color-picker-close {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 auto;
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: var(--bt-color-bg-input);
  color: var(--bt-color-label-secondary);
  font-size: 26rpx;
  line-height: 1;
}

.layer-editor__effect {
  margin-top: 20rpx;
}

/* ===== 3D 灯效预览 ===== */
.effect3d {
  margin-top: 20rpx;
  padding: 16rpx;
  border-radius: var(--bt-radius-inner);
  background: var(--bt-color-bg-sunken);
}

.effect3d__head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 8rpx;
}

.effect3d__title {
  color: var(--bt-color-label);
  font-size: 22rpx;
  line-height: 30rpx;
  font-weight: 600;
}

.effect3d__hint {
  color: var(--bt-color-label-quaternary);
  font-size: 20rpx;
  line-height: 28rpx;
}

/* 舞台：深色底（灯光需要暗场才看得清），圆角裁切 */
.effect3d__stage {
  overflow: hidden;
  border-radius: 16rpx;
  background: radial-gradient(120% 90% at 50% 50%, #1b1b20 0%, #08080a 100%);
}

.effect3d-canvas {
  display: block;
  width: 100%;
  height: 220rpx;
}

.layer-editor__del {
  margin-top: 24rpx;
  padding: 20rpx;
  border-radius: var(--bt-radius-inner);
  background: var(--bt-color-danger-soft);
  color: var(--bt-color-danger);
  font-size: 28rpx;
  line-height: 38rpx;
  font-weight: 600;
  text-align: center;
}

/* 参数行（rgb 色块预览） */
.param {
  margin-top: 12rpx;
}

.color-swatch {
  flex: 0 0 auto;
  width: 104rpx;
  height: 72rpx;
  border-radius: var(--bt-radius-inner);
  box-shadow: inset 0 0 0 2rpx rgba(17, 24, 39, 0.08);
}

/* ===== 颜色弹层（底部弹板） ===== */
.color-picker-mask {
  position: fixed;
  inset: 0;
  z-index: 200;
  display: flex;
  align-items: flex-end;
}

.color-picker-backdrop {
  position: absolute;
  inset: 0;
  background: rgba(17, 24, 39, 0.4);
}

.color-picker-panel {
  position: relative;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  width: 100%;
  max-height: 62vh;
  padding: 28rpx 32rpx calc(48rpx + env(safe-area-inset-bottom));
  overflow-y: auto;
  border-radius: 40rpx 40rpx 0 0;
  background: var(--bt-color-bg-elevated);
  box-sizing: border-box;
}

.color-picker-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.color-picker-title {
  color: var(--bt-color-label);
  font-size: 32rpx;
  line-height: 44rpx;
  font-weight: 700;
}

/* 色轮（角度=色相，半径=饱和度） */
.picker-main {
  display: flex;
  align-items: center;
  gap: 28rpx;
}

.picker-wheel {
  position: relative;
  flex: 0 0 auto;
  width: 380rpx;
  height: 380rpx;
  border-radius: 50%;
  box-shadow: inset 0 0 0 2rpx rgba(17, 24, 39, 0.06), var(--bt-shadow-card);
}

.color-wheel {
  display: block;
  width: 100%;
  height: 100%;
  border-radius: 50%;
}

.picker-side {
  flex: 1 1 auto;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.picker-preview {
  height: 108rpx;
  border-radius: var(--bt-radius-inner);
  box-shadow: inset 0 0 0 2rpx rgba(17, 24, 39, 0.08);
}

.picker-hex {
  color: var(--bt-color-label);
  font-size: 26rpx;
  line-height: 36rpx;
  font-weight: 600;
}

.picker-hs {
  color: var(--bt-color-label-tertiary);
  font-size: 22rpx;
  line-height: 30rpx;
}

/* 色轮圆点 */
.picker-dot {
  position: absolute;
  width: 36rpx;
  height: 36rpx;
  margin-top: -18rpx;
  margin-left: -18rpx;
  border-radius: 50%;
  background: #ffffff;
  box-shadow: 0 2rpx 8rpx rgba(17, 24, 39, 0.3), 0 0 0 3rpx rgba(255, 255, 255, 0.95);
  pointer-events: none;
}

.recent-colors {
  margin-top: 8rpx;
}

.recent-colors__title {
  color: var(--bt-color-label-secondary);
  font-size: 24rpx;
  line-height: 34rpx;
  font-weight: 600;
}

.recent-colors__row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 12rpx;
}

.color-cell {
  box-sizing: border-box;
}

.color-cell--recent {
  flex: 0 0 auto;
  width: 80rpx;
  height: 80rpx;
  border-radius: var(--bt-radius-inner);
  box-shadow: inset 0 0 0 2rpx rgba(17, 24, 39, 0.08);
}/* ===== 同步状态条 ===== */
.sync-bar {
  padding: 10rpx 40rpx;
  font-size: 24rpx;
  line-height: 1.4;
  color: var(--bt-color-label-tertiary);
}

.sync-bar__text {
  display: block;
}
.sync-bar--syncing {
  color: var(--bt-color-accent);
}

.sync-bar--synced {
  color: var(--bt-color-label-tertiary);
}

.sync-bar--failed {
  color: var(--bt-color-danger);
}

.sync-bar--local {
  color: var(--bt-color-label-tertiary);
}

/* ===== 灯珠拖选取消区 ===== */
.led-cancel-zone {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 101;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 96rpx;
  background: linear-gradient(
    180deg,
    rgba(255, 56, 60, 0) 0%,
    rgba(255, 56, 60, 0.25) 40%,
    rgba(255, 56, 60, 0.45) 100%
  );
  transition: background 0.2s ease-out;
}

.led-cancel-zone--active {
  background: linear-gradient(
    180deg,
    rgba(255, 56, 60, 0.1) 0%,
    rgba(255, 56, 60, 0.45) 40%,
    rgba(255, 56, 60, 0.7) 100%
  );
}

.led-cancel-zone__text {
  color: #ffffff;
  font-size: 28rpx;
  line-height: 40rpx;
  font-weight: 600;
  text-shadow: 0 2rpx 8rpx rgba(17, 24, 39, 0.25);
}

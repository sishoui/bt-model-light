/* 引脚配置详情页样式（ADR-0027 / #27 / T7；范式 B 工具页，design.md §7.3）。 */

.page {
  padding: 0 0 176rpx; /* 底部给固定玻璃保存栏留位 */
}

/* 顶部：图片 / 名称 / 开关 */
.pin-head {
  display: flex;
  align-items: center;
}

.pin-head__img {
  width: 120rpx;
  height: 120rpx;
  border-radius: 16rpx;
  background: var(--bt-color-bg-input);
  margin-right: 24rpx;
}

.pin-head__info {
  flex: 1;
}

.pin-head__name {
  font-size: 34rpx;
  line-height: 44rpx;
  font-weight: 600;
  height: 64rpx;
}

/* 灯组 Tab（固定 5 个；横向滚动防拥挤，design.md §5.4 热区 88rpx） */
.group-tabs {
  white-space: nowrap;
  padding: 12rpx 32rpx;
}

.group-tab {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-width: 140rpx;
  height: 88rpx;
  padding: 8rpx 24rpx;
  margin-right: 12rpx;
  background: var(--bt-color-bg-elevated);
  border-radius: 20rpx;
  box-sizing: border-box;
  transition: background-color 0.25s ease-out, color 0.25s ease-out;
}

.group-tab--active {
  background: var(--bt-color-accent);
}

.group-tab__name {
  font-size: 28rpx;
  line-height: 36rpx;
  color: var(--bt-color-label);
  transition: color 0.25s ease-out;
}

.group-tab--active .group-tab__name {
  color: #ffffff;
}

.group-tab__range {
  font-size: 22rpx;
  line-height: 30rpx;
  color: var(--bt-color-label-tertiary);
  transition: color 0.25s ease-out;
}

.group-tab--active .group-tab__range {
  color: rgba(255, 255, 255, 0.75);
}

/* 通用行：标签 + 控件 */
.row {
  display: flex;
  align-items: center;
  margin-top: 16rpx;
}

.row__label {
  width: 160rpx;
  font-size: 28rpx;
  line-height: 38rpx;
  color: var(--bt-color-label-secondary);
}

.row__input {
  flex: 1;
  height: 64rpx;
  padding: 0 16rpx;
  background: var(--bt-color-bg-input);
  border-radius: 12rpx;
  font-size: 28rpx;
  line-height: 64rpx;
  text-align: center;
  box-sizing: border-box;
}

.row__input--num {
  max-width: 200rpx;
}

.row__picker {
  flex: 1;
  padding: 0 16rpx;
  height: 64rpx;
  background: var(--bt-color-bg-input);
  border-radius: 12rpx;
  font-size: 28rpx;
  line-height: 64rpx;
  text-align: center;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

/* 灯珠范围（视觉 60rpx 方格，点击热区经 margin 扩至 ~88rpx，design.md §5.4） */
.range {
  margin-top: 24rpx;
}

.range__title {
  font-size: 28rpx;
  line-height: 38rpx;
  font-weight: 600;
}

.led-grid {
  display: grid;
  grid-template-columns: repeat(10, 1fr);
  gap: 16rpx;
  margin: 8rpx 0 0;
  touch-action: none;
  max-height: 50vh;
  overflow-y: auto;
  overflow-x: hidden;
}

.led-grid--picker {
  padding: 8rpx;
  margin: 0;
  max-height: 50vh;
  overflow-y: auto;
}

.led-cell {
  width: 100%;
  aspect-ratio: 1;
  min-height: 48rpx;
  border-radius: 12rpx;
  background: var(--bt-color-bg-input);
  color: var(--bt-color-label-tertiary);
  font-size: 20rpx;
  line-height: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  transition: background-color 0.15s ease-out, color 0.15s ease-out, box-shadow 0.15s ease-out;
}

.led-cell--occupied {
  background: var(--bt-color-gray-4);
  color: var(--bt-color-gray-5);
  opacity: 0.6;
}

/* 已选中（松手后生效）：实心蓝底白字 */
.led-cell--selected {
  background: var(--bt-color-accent);
  color: #ffffff;
}

/* 被其他灯组占用：灰色不可选 */
.led-cell--occupied {
  background: var(--bt-color-gray-4);
  color: var(--bt-color-label-quaternary);
}

/* 拖选起点/终点：蓝框白底（高亮边框） */
.led-cell--drag-start,
.led-cell--drag-end {
  background: #ffffff;
  color: var(--bt-color-accent);
  box-shadow: inset 0 0 0 3rpx var(--bt-color-accent);
}

/* 拖选中间：浅蓝连接条 */
.led-cell--drag-mid {
  background: rgba(0, 136, 255, 0.2);
  color: var(--bt-color-accent);
}

.range__hint {
  margin-top: 12rpx;
  font-size: 22rpx;
  line-height: 32rpx;
  color: var(--bt-color-label-tertiary);
}

.range__actions {
  margin-top: 16rpx;
  display: flex;
  justify-content: flex-end;
}

.range__clear {
  padding: 12rpx 28rpx;
  font-size: 26rpx;
  line-height: 40rpx;
  color: var(--bt-color-danger);
  background: var(--bt-color-bg-input);
  border-radius: 999rpx;
}


/* 步骤卡片 */
.step {
  margin-top: 16rpx;
}

.step__head {
  margin-bottom: 8rpx;
}

.step__title {
  font-size: 28rpx;
  line-height: 38rpx;
  font-weight: 600;
}

.step__del {
  font-size: 24rpx;
  line-height: 34rpx;
  color: var(--bt-color-danger);
}

/* 图层（卡内嵌块：elevated 卡内用 grouped 底，同心圆角） */
.layer {
  margin-top: 16rpx;
  padding: 16rpx;
  background: var(--bt-color-bg-input);
  border-radius: 12rpx;
}

.layer__head {
  margin-bottom: 8rpx;
}

.layer__title {
  font-size: 28rpx;
  line-height: 38rpx;
  font-weight: 600;
}

.layer__effect {
  margin-bottom: 8rpx;
}

/* 参数行（rgb 色块预览） */
.param {
  margin-top: 12rpx;
}

/* rgb 色块预览：点击弹层 */
.color-swatch {
  width: 96rpx;
  height: 64rpx;
  flex: 0 0 auto;
  border-radius: 12rpx;
  box-shadow: inset 0 0 0 2rpx var(--bt-color-bg-input);
}

/* 颜色弹层（#33） */
.color-picker-mask {
  position: fixed;
  inset: 0;
  z-index: 200;
  display: flex;
  align-items: flex-end;
}

.color-picker-backdrop {
  position: absolute;
  inset: 0;
  background: rgba(0, 0, 0, 0.4);
}

.color-picker-panel {
  position: relative;
  width: 100%;
  max-height: 60vh;
  overflow-y: auto;
  background: var(--bt-color-bg-elevated);
  border-radius: 28rpx 28rpx 0 0;
  padding: 24rpx 32rpx 48rpx;
  box-shadow: 0 -24rpx 64rpx rgba(0, 0, 0, 0.2);
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.color-picker-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.color-picker-title {
  font-size: 32rpx;
  line-height: 44rpx;
  font-weight: 700;
  color: var(--bt-color-label);
}

.color-picker-close {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  line-height: 40rpx;
  color: var(--bt-color-label-secondary);
  border-radius: 999rpx;
  background: var(--bt-color-bg-input);
}

.color-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 16rpx;
  margin-top: 8rpx;
}

.color-cell {
  width: 100%;
  aspect-ratio: 1;
  border-radius: 12rpx;
  box-shadow: inset 0 0 0 2rpx rgba(0, 0, 0, 0.1);
}

.color-cell--recent {
  width: 80rpx;
  height: 80rpx;
  flex: 0 0 auto;
}

.recent-colors {
  margin-top: 16rpx;
}

.recent-colors__title {
  font-size: 26rpx;
  line-height: 36rpx;
  color: var(--bt-color-label-secondary);
}

.recent-colors__row {
  display: flex;
  gap: 12rpx;
  flex-wrap: wrap;
  margin-top: 12rpx;
}

/* 折叠摘要行 */
.step__head {
  margin-bottom: 8rpx;
}

.step__head-actions,
.layer__head-actions {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.step__arrow,
.layer__arrow {
  font-size: 24rpx;
  line-height: 34rpx;
  color: var(--bt-color-label-tertiary);
}

/* 添加按钮（次级虚线按钮） */
.add-layer {
  margin-top: 16rpx;
  padding: 12rpx;
  text-align: center;
  font-size: 28rpx;
  line-height: 38rpx;
  color: var(--bt-color-accent);
  border: 2rpx dashed var(--bt-color-accent);
  border-radius: 12rpx;
  transition: background-color 0.25s ease-out;
}

.add-layer:active {
  background-color: rgba(0, 136, 255, 0.08);
}

.add-step {
  margin: 16rpx 32rpx;
  padding: 16rpx;
  text-align: center;
  font-size: 28rpx;
  line-height: 38rpx;
  font-weight: 600;
  color: var(--bt-color-accent);
}

/* 固定保存栏：玻璃材质走 .bt-glass 工具类（含降级），此处只管布局 */
.save-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 10;
  padding: 16rpx 32rpx;
  display: flex;
  gap: 16rpx;
}

.save-bar .bt-btn {
  text-align: center;
  font-size: 28rpx;
  height: 64rpx;
  line-height: 64rpx;
}

/* 删除引脚：次级危险按钮（固定宽），保存按钮占满剩余空间 */
.save-bar__del {
  flex: 0 0 auto;
  padding: 0 28rpx;
  background-color: transparent;
  color: var(--bt-color-danger);
}

.save-bar__save {
  flex: 1;
}
/* 灯珠选择弹出层（#31） */
.led-picker-mask {
  position: fixed;
  inset: 0;
  padding-bottom: 200rpx;
  box-sizing: border-box;
  z-index: 100;
  display: flex;
  align-items: center;
  justify-content: center;
}

.led-picker-backdrop {
  position: absolute;
  inset: 0;
  background: rgba(0, 0, 0, 0.4);
}

.led-picker-panel {
  position: relative;
  width: 90vw;
  max-width: 720rpx;
  max-height: 50vh;
  background: var(--bt-color-bg-elevated);
  border-radius: 28rpx;
  padding: 24rpx;
  box-shadow: 0 24rpx 64rpx rgba(0, 0, 0, 0.2);
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.led-picker-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.led-picker-title {
  font-size: 32rpx;
  line-height: 44rpx;
  font-weight: 700;
  color: var(--bt-color-label);
}

.led-picker-close {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  line-height: 40rpx;
  color: var(--bt-color-label-secondary);
  border-radius: 999rpx;
  background: var(--bt-color-bg-input);
}

.led-picker-hint {
  font-size: 22rpx;
  line-height: 32rpx;
  color: var(--bt-color-label-tertiary);
  text-align: center;
  padding: 12rpx 0;
  min-height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.led-picker-open {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 16rpx 32rpx;
  margin-top: 12rpx;
  background: var(--bt-color-bg-input);
  border-radius: 20rpx;
  color: var(--bt-color-accent);
  font-size: 26rpx;
  line-height: 40rpx;
  font-weight: 600;
}

/* 取消区：fixed 屏幕底部，与面板物理分离，永不遮挡方格 */
.led-cancel-zone {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  height: 80rpx;
  z-index: 101;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(180deg, rgba(255, 56, 60, 0) 0%, rgba(255, 56, 60, 0.25) 40%, rgba(255, 56, 60, 0.45) 100%);
  transition: background 0.2s ease-out;
}

.led-cancel-zone--active {
  background: linear-gradient(180deg, rgba(255, 56, 60, 0.1) 0%, rgba(255, 56, 60, 0.45) 40%, rgba(255, 56, 60, 0.7) 100%);
}

.led-cancel-zone__text {
  font-size: 28rpx;
  line-height: 40rpx;
  color: #ffffff;
  font-weight: 600;
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.25);
}

.range__open {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 16rpx 32rpx;
  margin-top: 12rpx;
  background: var(--bt-color-bg-input);
  border-radius: 20rpx;
  color: var(--bt-color-accent);
  font-size: 26rpx;
  line-height: 40rpx;
  font-weight: 600;
}

.led-grid--picker {
  padding: 8rpx;
  margin: 0;
  max-height: 50vh;
  overflow-y: auto;
}

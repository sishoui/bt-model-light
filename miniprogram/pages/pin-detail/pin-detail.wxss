/* 引脚配置详情页样式（ADR-0027 / #27 / T7；范式 B 工具页，design.md §7.3）。 */

.page {
  padding: 0 0 176rpx; /* 底部给固定玻璃保存栏留位 */
}

/* 顶部：图片 / 名称 / 开关 */
.pin-head {
  display: flex;
  align-items: center;
}

.pin-head__img {
  width: 120rpx;
  height: 120rpx;
  border-radius: 16rpx;
  background: var(--bt-color-bg-input);
  margin-right: 24rpx;
}

.pin-head__info {
  flex: 1;
}

.pin-head__name {
  font-size: 34rpx;
  line-height: 44rpx;
  font-weight: 600;
  height: 64rpx;
}

/* 灯组下拉（#31） */
.group-bar {
  display: flex;
  align-items: center;
  padding: 12rpx 32rpx;
}

/* 视觉上胶囊 64rpx 高，热区经 padding 扩至 88rpx（design.md §5.4）。 */
.group-bar__pick {
  display: flex;
  align-items: center;
  padding: 12rpx 24rpx;
  background: var(--bt-color-bg-elevated);
  border-radius: 999rpx;
  box-shadow: inset 0 0 0 1rpx var(--bt-color-separator);
}

.group-bar__name {
  font-size: 30rpx;
  line-height: 40rpx;
  font-weight: 600;
  color: var(--bt-color-label);
}

.group-bar__arrow {
  margin-left: 8rpx;
  font-size: 24rpx;
  line-height: 40rpx;
  color: var(--bt-color-label-secondary);
  transition: transform 0.2s ease-out;
}

.group-bar__arrow--open {
  transform: rotate(180deg);
}

.group-bar__spacer {
  flex: 1;
}

.group-bar__add {
  width: 64rpx;
  height: 64rpx;
  margin: 12rpx 0;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 999rpx;
  background: var(--bt-color-bg-elevated);
  color: var(--bt-color-accent);
  font-size: 36rpx;
  line-height: 40rpx;
  box-shadow: inset 0 0 0 1rpx var(--bt-color-separator);
}

/* 灯组弹层（position:fixed） */
.group-menu {
  position: fixed;
  inset: 0;
  z-index: 50;
}

.group-menu__mask {
  position: absolute;
  inset: 0;
  background: var(--bt-color-bg-mask);
}

.group-menu__sheet {
  position: absolute;
  left: 32rpx;
  right: 32rpx;
  top: 160rpx;
  background: var(--bt-color-bg-elevated);
  border-radius: 24rpx;
  padding: 8rpx 0;
  box-shadow: 0 16rpx 48rpx var(--bt-color-shadow-sheet);
  max-height: 60vh;
  overflow-y: auto;
}

.group-menu__item {
  padding: 24rpx 32rpx;
  font-size: 30rpx;
  line-height: 40rpx;
  color: var(--bt-color-label);
}

.group-menu__item--active {
  color: var(--bt-color-accent);
  font-weight: 600;
}

.group-menu__item:active {
  background: var(--bt-color-bg-input);
}

.group-menu__del {
  padding: 24rpx 32rpx;
  font-size: 30rpx;
  line-height: 40rpx;
  color: var(--bt-color-danger);
  border-top: 1rpx solid var(--bt-color-separator);
}

/* 通用行：标签 + 控件 */
.row {
  display: flex;
  align-items: center;
  margin-top: 16rpx;
}

.row__label {
  width: 160rpx;
  font-size: 28rpx;
  line-height: 38rpx;
  color: var(--bt-color-label-secondary);
}

.row__input {
  flex: 1;
  height: 64rpx;
  padding: 0 16rpx;
  background: var(--bt-color-bg-input);
  border-radius: 12rpx;
  font-size: 28rpx;
  line-height: 64rpx;
  text-align: center;
  box-sizing: border-box;
}

.row__input--num {
  max-width: 200rpx;
}

.row__picker {
  flex: 1;
  padding: 0 16rpx;
  height: 64rpx;
  background: var(--bt-color-bg-input);
  border-radius: 12rpx;
  font-size: 28rpx;
  line-height: 64rpx;
  text-align: center;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

/* 灯珠范围（视觉 60rpx 方格，点击热区经 margin 扩至 ~88rpx，design.md §5.4） */
.range {
  margin-top: 24rpx;
}

.range__title {
  font-size: 28rpx;
  line-height: 38rpx;
  font-weight: 600;
}

.led-grid {
  display: flex;
  flex-wrap: wrap;
  margin: 8rpx -10rpx 0;
}

.led-cell {
  width: 60rpx;
  height: 60rpx;
  margin: 10rpx;
  border-radius: 12rpx;
  background: var(--bt-color-bg-input);
  color: var(--bt-color-label-tertiary);
  font-size: 22rpx;
  line-height: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: background-color 0.25s ease-out, color 0.25s ease-out;
}

.led-cell--on {
  background: var(--bt-color-accent);
  color: #ffffff;
}

/* 步骤卡片 */
.step {
  margin-top: 16rpx;
}

.step__head {
  margin-bottom: 8rpx;
}

.step__title {
  font-size: 28rpx;
  line-height: 38rpx;
  font-weight: 600;
}

.step__del {
  font-size: 24rpx;
  line-height: 34rpx;
  color: var(--bt-color-danger);
}

/* 图层（卡内嵌块：elevated 卡内用 grouped 底，同心圆角） */
.layer {
  margin-top: 16rpx;
  padding: 16rpx;
  background: var(--bt-color-bg-input);
  border-radius: 12rpx;
}

.layer__head {
  margin-bottom: 8rpx;
}

.layer__title {
  font-size: 28rpx;
  line-height: 38rpx;
  font-weight: 600;
}

.layer__effect {
  margin-bottom: 8rpx;
}

/* 参数行（rgb 三通道） */
.param {
  margin-top: 12rpx;
}

.rgb {
  display: flex;
  align-items: center;
  flex: 1;
}

.rgb__ch {
  font-size: 22rpx;
  line-height: 32rpx;
  color: var(--bt-color-label-tertiary);
  margin: 0 6rpx;
}

.rgb__input {
  width: 80rpx;
  height: 64rpx;
  padding: 0 8rpx;
  background: var(--bt-color-bg-elevated);
  border-radius: 12rpx;
  font-size: 24rpx;
  line-height: 64rpx;
  text-align: center;
  box-sizing: border-box;
}

/* 添加按钮（次级虚线按钮） */
.add-layer {
  margin-top: 16rpx;
  padding: 12rpx;
  text-align: center;
  font-size: 28rpx;
  line-height: 38rpx;
  color: var(--bt-color-accent);
  border: 2rpx dashed var(--bt-color-accent);
  border-radius: 12rpx;
  transition: background-color 0.25s ease-out;
}

.add-layer:active {
  background-color: rgba(0, 136, 255, 0.08);
}

.add-step {
  margin: 16rpx 32rpx;
  padding: 16rpx;
  text-align: center;
  font-size: 28rpx;
  line-height: 38rpx;
  font-weight: 600;
  color: var(--bt-color-accent);
}

/* 固定保存栏：玻璃材质走 .bt-glass 工具类（含降级），此处只管布局 */
.save-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 10;
  padding: 16rpx 32rpx;
  display: flex;
  gap: 16rpx;
}

.save-bar .bt-btn {
  text-align: center;
  font-size: 28rpx;
  height: 64rpx;
  line-height: 64rpx;
}

/* 删除引脚：次级危险按钮（固定宽），保存按钮占满剩余空间 */
.save-bar__del {
  flex: 0 0 auto;
  padding: 0 28rpx;
  background-color: transparent;
  color: var(--bt-color-danger);
}

.save-bar__save {
  flex: 1;
}
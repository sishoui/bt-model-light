/* 引脚配置详情页样式（ADR-0027 / #27 / T7；范式 B 工具页，design.md §7.3）。 */

.page {
  padding: 0 0 176rpx; /* 底部给固定玻璃保存栏留位 */
}

/* 顶部卡片：引脚信息行 + 灯组选择行（分隔线区隔，同卡内两级信息） */
.pin-head-card {
  padding-bottom: 16rpx;
}

.pin-head {
  display: flex;
  align-items: center;
}

.pin-head__img {
  width: 120rpx;
  height: 120rpx;
  border-radius: 16rpx;
  background: var(--bt-color-bg-input);
  margin-right: 24rpx;
}

.pin-head__info {
  flex: 1;
}

.pin-head__name {
  font-size: 34rpx;
  line-height: 44rpx;
  font-weight: 600;
  height: 64rpx;
}

/* 灯组选择行：卡片内分隔线上方留白；下拉框（左，占满）+「配置」按钮（右）
 * 固定 5 组，无增删（design.md §5.4 热区 88rpx） */
.group-select {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid var(--bt-color-separator);
}

.group-select__picker {
  flex: 1;
  min-width: 0;
}

.group-select__value {
  display: flex;
  align-items: center;
  height: 88rpx;
  padding: 0 20rpx;
  background: var(--bt-color-bg-input);
  border-radius: 16rpx;
}

.group-select__text {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.group-select__name {
  font-size: 30rpx;
  line-height: 40rpx;
  font-weight: 600;
  color: var(--bt-color-label);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.group-select__range {
  font-size: 22rpx;
  line-height: 30rpx;
  color: var(--bt-color-label-tertiary);
}

.group-select__arrow {
  flex: 0 0 auto;
  margin-left: 12rpx;
  font-size: 20rpx;
  line-height: 28rpx;
  color: var(--bt-color-label-tertiary);
}

.group-select__config {
  flex: 0 0 auto;
  height: 88rpx;
  padding: 0 28rpx;
  font-size: 28rpx;
  line-height: 88rpx;
  color: var(--bt-color-accent);
  background: rgba(0, 136, 255, 0.1);
  border-radius: 16rpx;
  box-sizing: border-box;
}

/* 通用行：标签 + 控件 */
.row {
  display: flex;
  align-items: center;
  margin-top: 16rpx;
}

.row__label {
  width: 160rpx;
  font-size: 28rpx;
  line-height: 38rpx;
  color: var(--bt-color-label-secondary);
}

.row__input {
  flex: 1;
  height: 64rpx;
  padding: 0 16rpx;
  background: var(--bt-color-bg-input);
  border-radius: 12rpx;
  font-size: 28rpx;
  line-height: 64rpx;
  text-align: center;
  box-sizing: border-box;
}

.row__input--num {
  max-width: 200rpx;
}

/* 时长 / 参数滑块：标签 + 滑块 + 数字输入框 */
.row__slider {
  flex: 1;
  margin: 0 12rpx;
}

.row__slider-input {
  width: 96rpx;
  max-width: 96rpx;
  flex: 0 0 auto;
}

.row__slider-val {
  width: 72rpx;
  font-size: 28rpx;
  line-height: 38rpx;
  color: var(--bt-color-label);
  text-align: right;
}

.param-slider {
  flex: 1;
  display: flex;
  align-items: center;
}

.param-slider__bar {
  flex: 1;
  margin-right: 12rpx;
  min-width: 0;
}

.param-slider__val {
  width: 64rpx;
  font-size: 26rpx;
  line-height: 34rpx;
  color: var(--bt-color-label-secondary);
  text-align: right;
}

/* 枚举单选：行内胶囊，选中高亮（点击切换，无弹层） */
.param-radio {
  flex: 1;
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx 12rpx;
  justify-content: flex-end;
}

.param-radio__item {
  padding: 6rpx 20rpx;
  font-size: 26rpx;
  line-height: 34rpx;
  color: var(--bt-color-label);
  background: var(--bt-color-bg-input);
  border-radius: 999rpx;
}

.param-radio__item--on {
  color: #ffffff;
  background: #0088ff;
}

.row__picker {
  flex: 1;
  padding: 0 16rpx;
  height: 64rpx;
  background: var(--bt-color-bg-input);
  border-radius: 12rpx;
  font-size: 28rpx;
  line-height: 64rpx;
  text-align: center;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

/* 灯珠范围（视觉 60rpx 方格，点击热区经 margin 扩至 ~88rpx，design.md §5.4） */
.range {
  margin-top: 24rpx;
}

.range__title {
  font-size: 28rpx;
  line-height: 38rpx;
  font-weight: 600;
}

.led-grid {
  display: grid;
  grid-template-columns: repeat(10, 1fr);
  gap: 16rpx;
  margin: 8rpx 0 0;
  touch-action: none;
  max-height: 50vh;
  overflow-y: auto;
  overflow-x: hidden;
}

.led-cell {
  width: 100%;
  aspect-ratio: 1;
  min-height: 48rpx;
  border-radius: 12rpx;
  background: var(--bt-color-bg-input);
  color: var(--bt-color-label-tertiary);
  font-size: 20rpx;
  line-height: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  transition: background-color 0.15s ease-out, color 0.15s ease-out, box-shadow 0.15s ease-out;
}

.led-cell--occupied {
  background: var(--bt-color-gray-4);
  color: var(--bt-color-gray-5);
  opacity: 0.6;
}

/* 已选中（松手后生效）：实心蓝底白字 */
.led-cell--selected {
  background: var(--bt-color-accent);
  color: #ffffff;
}

/* 被其他灯组占用：灰色不可选 */
.led-cell--occupied {
  background: var(--bt-color-gray-4);
  color: var(--bt-color-label-quaternary);
}

/* 拖选起点/终点：蓝框白底（高亮边框） */
.led-cell--drag-start,
.led-cell--drag-end {
  background: #ffffff;
  color: var(--bt-color-accent);
  box-shadow: inset 0 0 0 3rpx var(--bt-color-accent);
}

/* 拖选中间：浅蓝连接条 */
.led-cell--drag-mid {
  background: rgba(0, 136, 255, 0.2);
  color: var(--bt-color-accent);
}

.range__hint {
  margin-top: 12rpx;
  font-size: 22rpx;
  line-height: 32rpx;
  color: var(--bt-color-label-tertiary);
}

.range__actions {
  margin-top: 16rpx;
  display: flex;
  justify-content: flex-end;
}

.range__clear {
  padding: 12rpx 28rpx;
  font-size: 26rpx;
  line-height: 40rpx;
  color: var(--bt-color-danger);
  background: var(--bt-color-bg-input);
  border-radius: 999rpx;
}


/* 阶段标题行：左标题 + 右添加（满 5 禁用态） */
.stage-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 16rpx;
}

.stage-head__title {
  font-size: 28rpx;
  line-height: 38rpx;
  font-weight: 600;
  color: var(--bt-color-label);
}

/* 横向阶段分段条（N 段等宽拼成整体圆角矩形；轻点选中、长按拖动排序） */
.stage-bar__scroll {
  width: 100%;
  white-space: nowrap;
}

.stage-inner {
  display: flex;
  margin: 0 24rpx;
  height: 120rpx;
  background: var(--bt-color-bg-elevated);
  border: 2rpx solid rgba(0, 0, 0, 0.08);
  border-radius: 20rpx;
  overflow: hidden;
}

.stage-seg {
  position: relative;
  flex: 0 0 auto;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-width: 0;
  transition: transform 0.2s ease, background 0.2s ease;
}

.stage-seg + .stage-seg {
  border-left: 2rpx solid rgba(0, 0, 0, 0.08);
}

.stage-seg--active {
  background: rgba(0, 136, 255, 0.12);
}

.stage-seg--drag {
  transition: none;
  z-index: 2;
  background: var(--bt-color-bg-elevated);
}

.stage-seg__num {
  font-size: 30rpx;
  line-height: 36rpx;
  font-weight: 600;
  color: var(--bt-color-label);
}

.stage-seg--active .stage-seg__num {
  color: var(--bt-color-accent);
}

.stage-seg__name {
  max-width: 100%;
  padding: 0 8rpx;
  font-size: 22rpx;
  line-height: 28rpx;
  color: var(--bt-color-label-tertiary);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.stage-seg__info {
  font-size: 22rpx;
  line-height: 28rpx;
  color: var(--bt-color-label-tertiary);
}

/* 阶段时间轴图（泳道甘特）：总时长条 + 段内图层子条 + 过渡斜纹。
   与分段条不同，这是只读可视化：宽度按 duration 真实比例，点段=选中。 */
.timeline {
  margin: 16rpx 24rpx 0;
  padding: 16rpx;
  background: var(--bt-color-bg-elevated);
  border-radius: 16rpx;
}

.timeline__head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.timeline__title {
  font-size: 24rpx;
  line-height: 32rpx;
  font-weight: 600;
  color: var(--bt-color-label-secondary);
}

.timeline__total {
  font-size: 22rpx;
  line-height: 30rpx;
  color: var(--bt-color-label-tertiary);
}

/* 轨道：相对定位，段按 left/width 百分比铺满 */
.timeline__track {
  position: relative;
  height: 64rpx;
  background: var(--bt-color-bg-input);
  border-radius: 10rpx;
  overflow: hidden;
}

.timeline__seg {
  position: absolute;
  top: 0;
  height: 100%;
  display: flex;
  flex-direction: column;
  justify-content: center;
  padding: 0 6rpx;
  box-sizing: border-box;
  border-right: 2rpx solid var(--bt-color-bg-elevated);
  transition: background 0.2s ease;
}

.timeline__seg--active {
  background: rgba(0, 136, 255, 0.14);
}

/* 段内图层子条：横排堆叠，颜色=灯效主题色 */
.timeline__layers {
  display: flex;
  height: 22rpx;
  border-radius: 6rpx;
  overflow: hidden;
}

.timeline__layer {
  height: 100%;
}

/* 过渡区间：段尾斜纹（半透明白/黑交替，透明底叠在子条上） */
.timeline__trans {
  position: absolute;
  top: 6rpx;
  bottom: 6rpx;
  background-image: repeating-linear-gradient(
    45deg,
    rgba(255, 255, 255, 0.55) 0,
    rgba(255, 255, 255, 0.55) 4rpx,
    rgba(0, 0, 0, 0.12) 4rpx,
    rgba(0, 0, 0, 0.12) 8rpx
  );
  border-radius: 4rpx;
  pointer-events: none;
}

.timeline__label {
  margin-top: 6rpx;
  font-size: 20rpx;
  line-height: 26rpx;
  color: var(--bt-color-label-tertiary);
  text-align: center;
  white-space: nowrap;
  overflow: hidden;
}

/* 图例：当前灯组用到的灯效色点 + 名称 */
.timeline__legend {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx 20rpx;
  margin-top: 12rpx;
}

.timeline__legend-item {
  display: flex;
  align-items: center;
}

.timeline__legend-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 4rpx;
  margin-right: 8rpx;
}

.timeline__legend-text {
  font-size: 22rpx;
  line-height: 30rpx;
  color: var(--bt-color-label-tertiary);
}


.stage-seg--enter {
  animation: stage-seg-in 0.22s ease;
}

@keyframes stage-seg-in {
  from {
    opacity: 0;
  }
  to {
    opacity: 1;
  }
}

.stage-add {
  flex: 0 0 auto;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  border: 2rpx dashed var(--bt-color-accent);
  color: var(--bt-color-accent);
  font-size: 32rpx;
}

.stage-add--disabled {
  border-color: rgba(0, 0, 0, 0.15);
  color: var(--bt-color-label-tertiary);
}

/* 阶段详情气泡卡片：箭头指向当前选中阶段（left 由 JS 按段中心写入 --bubble-x） */
.step-bubble {
  position: relative;
  margin: 24rpx 24rpx 0;
  padding: 20rpx 20rpx 24rpx;
  background: var(--bt-color-bg-elevated);
  border-radius: 20rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.08);
}

.step-bubble__arrow {
  position: absolute;
  top: -12rpx;
  left: var(--bubble-x, 50%);
  transform: translateX(-50%);
  width: 24rpx;
  height: 24rpx;
  background: var(--bt-color-bg-elevated);
  border-left: 2rpx solid rgba(0, 0, 0, 0.08);
  border-top: 2rpx solid rgba(0, 0, 0, 0.08);
  transform: translateX(-50%) rotate(45deg);
  border-radius: 4rpx 0 0 0;
}

/* 阶段详情（横向阶段条下方的参数编辑区） */
.step-detail {
  margin-top: 0;
}

.step-detail__head {
  display: flex;
  align-items: center;
  margin-bottom: 8rpx;
}

.step-detail__title {
  flex: 1;
  text-align: left;
  font-size: 28rpx;
  line-height: 38rpx;
  font-weight: 600;
  color: var(--bt-color-label);
}

/* 时长行独占；过渡/循环并排一行 */
.row--two {
  flex-wrap: wrap;
  gap: 16rpx;
}

.row__half {
  flex: 1;
  display: flex;
  align-items: center;
  min-width: 40%;
}

.row__half .row__label {
  width: 100rpx;
}

.step__del {
  font-size: 24rpx;
  line-height: 34rpx;
  color: var(--bt-color-danger);
}

/* 底部删除当前阶段按钮（页面最下面，仅剩 1 个阶段时隐藏） */
.del-stage {
  margin: 24rpx 32rpx 8rpx;
  padding: 20rpx;
  text-align: center;
  font-size: 28rpx;
  line-height: 38rpx;
  font-weight: 600;
  color: #ffffff;
  background: var(--bt-color-danger);
  border-radius: 16rpx;
}

/* 图层两列卡片网格：每阶段最多 2 层，卡片与「添加」按钮同尺寸同一行。
   与 home 的 4 列网格同法：margin 实现列间距（不依赖 flex gap，老内核也稳）。 */
.layer-grid {
  display: flex;
  flex-wrap: wrap;
  margin-top: 16rpx;
}

.layer-card {
  /* border-box：虚线占位卡边框计入宽度，两列不换行 */
  box-sizing: border-box;
  width: calc((100% - 16rpx) / 2);
  margin-right: 16rpx;
  margin-bottom: 16rpx;
  min-height: 168rpx;
  padding: 16rpx;
  background: var(--bt-color-bg-input);
  border-radius: 16rpx;
  display: flex;
  flex-direction: column;
}

.layer-card:nth-child(2n) {
  margin-right: 0;
}

.layer-card__top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.layer-card__title {
  font-size: 24rpx;
  line-height: 34rpx;
  color: var(--bt-color-label-secondary);
}

.layer-card__arrow {
  font-size: 28rpx;
  line-height: 34rpx;
  color: var(--bt-color-label-tertiary);
}

.layer-card__mid {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 8rpx;
}

/* 首个 rgb 参数作色块预览：图层没有颜色参数时退化为描边方块 */
.layer-card__swatch {
  flex: 0 0 auto;
  width: 40rpx;
  height: 40rpx;
  border-radius: 10rpx;
  box-shadow: inset 0 0 0 2rpx rgba(0, 0, 0, 0.1);
}

.layer-card__swatch--none {
  background: var(--bt-color-bg-elevated);
  box-shadow: inset 0 0 0 2rpx var(--bt-color-gray-4);
}

.layer-card__effect {
  flex: 1;
  min-width: 0;
  font-size: 30rpx;
  line-height: 40rpx;
  font-weight: 600;
  color: var(--bt-color-label);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 渐变色带：多色灯效在卡片上直接展示配色（彩虹/双色/流星）。
   高度 12rpx 的细条，圆角与卡片内层同心。 */
.layer-card__gradient {
  height: 12rpx;
  margin-top: 10rpx;
  border-radius: 6rpx;
}

.layer-card__summary {
  margin-top: auto;
  padding-top: 8rpx;
  font-size: 22rpx;
  line-height: 30rpx;
  color: var(--bt-color-label-tertiary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 添加图层占位卡：虚线边框，与图层卡同尺寸 */
.layer-card--add {
  align-items: center;
  justify-content: center;
  background: transparent;
  border: 2rpx dashed var(--bt-color-accent);
}

.layer-card__plus {
  font-size: 40rpx;
  line-height: 48rpx;
  color: var(--bt-color-accent);
}

.layer-card__add-text {
  margin-top: 4rpx;
  font-size: 24rpx;
  line-height: 34rpx;
  color: var(--bt-color-accent);
}

/* 图层配置弹窗（点图层卡片打开）：z-index 低于颜色弹层（200），
   色块选色时可叠开在它之上。 */
.layer-editor-mask {
  position: fixed;
  inset: 0;
  z-index: 95;
  display: flex;
  align-items: center;
  justify-content: center;
}

.layer-editor-backdrop {
  position: absolute;
  inset: 0;
  background: rgba(0, 0, 0, 0.4);
}

.layer-editor-panel {
  position: relative;
  width: 90vw;
  max-width: 720rpx;
  max-height: 80vh;
  overflow-y: auto;
  background: var(--bt-color-bg-elevated);
  border-radius: 28rpx;
  padding: 24rpx;
  box-shadow: 0 24rpx 64rpx rgba(0, 0, 0, 0.2);
  display: flex;
  flex-direction: column;
}

.layer-editor-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.layer-editor-title {
  flex: 1;
  min-width: 0;
  font-size: 32rpx;
  line-height: 44rpx;
  font-weight: 700;
  color: var(--bt-color-label);
}

.layer-editor-close {
  flex: 0 0 auto;
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  line-height: 40rpx;
  color: var(--bt-color-label-secondary);
  border-radius: 999rpx;
  background: var(--bt-color-bg-input);
}

.layer-editor__effect {
  margin-top: 16rpx;
}

/* 迷你波形预览：标题行 + canvas（宽度撑满，高度固定） */
.wave-preview {
  margin-top: 16rpx;
  padding: 12rpx;
  background: var(--bt-color-bg-input);
  border-radius: 12rpx;
}

.wave-preview__head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 6rpx;
}

.wave-preview__title {
  font-size: 22rpx;
  line-height: 30rpx;
  font-weight: 600;
  color: var(--bt-color-label-secondary);
}

.wave-preview__hint {
  font-size: 20rpx;
  line-height: 28rpx;
  color: var(--bt-color-label-quaternary);
}

.wave-canvas {
  display: block;
  width: 100%;
  height: 120rpx;
}

.layer-editor__del {
  margin-top: 24rpx;
  padding: 16rpx;
  text-align: center;
  font-size: 28rpx;
  line-height: 38rpx;
  font-weight: 600;
  color: var(--bt-color-danger);
  background: var(--bt-color-bg-input);
  border-radius: 16rpx;
}

/* 参数行（rgb 色块预览） */
.param {
  margin-top: 12rpx;
}

/* rgb 色块预览：点击弹层 */
.color-swatch {
  width: 96rpx;
  height: 64rpx;
  flex: 0 0 auto;
  border-radius: 12rpx;
  box-shadow: inset 0 0 0 2rpx var(--bt-color-bg-input);
}

/* 颜色弹层（#33） */
.color-picker-mask {
  position: fixed;
  inset: 0;
  z-index: 200;
  display: flex;
  align-items: flex-end;
}

.color-picker-backdrop {
  position: absolute;
  inset: 0;
  background: rgba(0, 0, 0, 0.4);
}

.color-picker-panel {
  position: relative;
  width: 100%;
  max-height: 60vh;
  overflow-y: auto;
  background: var(--bt-color-bg-elevated);
  border-radius: 28rpx 28rpx 0 0;
  padding: 24rpx 32rpx 48rpx;
  box-shadow: 0 -24rpx 64rpx rgba(0, 0, 0, 0.2);
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.color-picker-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.color-picker-title {
  font-size: 32rpx;
  line-height: 44rpx;
  font-weight: 700;
  color: var(--bt-color-label);
}

.color-picker-close {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  line-height: 40rpx;
  color: var(--bt-color-label-secondary);
  border-radius: 999rpx;
  background: var(--bt-color-bg-input);
}

/* HSV 选色：预览色块 + 三条拖动条（色相加粗渐变，饱和度/亮度随当前色相渐变） */
.picker-preview {
  height: 96rpx;
  border-radius: 16rpx;
  box-shadow: inset 0 0 0 2rpx rgba(0, 0, 0, 0.1);
}

.picker-bars {
  display: flex;
  flex-direction: column;
  gap: 28rpx;
}

.picker-bar-row {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.picker-bar-meta {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}

.picker-bar-label {
  font-size: 26rpx;
  line-height: 36rpx;
  color: var(--bt-color-label-secondary);
}

.picker-bar-value {
  font-size: 26rpx;
  line-height: 36rpx;
  font-weight: 600;
  color: var(--bt-color-label);
}

.picker-bar {
  position: relative;
  width: 100%;
  height: 40rpx;
  border-radius: 999rpx;
  box-shadow: inset 0 0 0 2rpx rgba(0, 0, 0, 0.1);
}

/* 色相条：加粗 + 全色相彩虹渐变（红→黄→绿→青→蓝→品红→红） */
.picker-bar--hue {
  height: 56rpx;
  background: linear-gradient(to right, #FF0000 0%, #FFFF00 16.67%, #00FF00 33.33%, #00FFFF 50%, #0000FF 66.67%, #FF00FF 83.33%, #FF0000 100%);
}

.picker-dot {
  position: absolute;
  top: 50%;
  width: 36rpx;
  height: 36rpx;
  margin-left: -18rpx;
  transform: translateY(-50%);
  border-radius: 50%;
  background: #FFFFFF;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.35), 0 0 0 2rpx rgba(255, 255, 255, 0.9);
  pointer-events: none;
}

.color-cell--recent {
  width: 80rpx;
  height: 80rpx;
  flex: 0 0 auto;
  border-radius: 12rpx;
  box-shadow: inset 0 0 0 2rpx rgba(0, 0, 0, 0.1);
}

.recent-colors {
  margin-top: 24rpx;
}

.recent-colors__title {
  font-size: 26rpx;
  line-height: 36rpx;
  color: var(--bt-color-label-secondary);
}

.recent-colors__row {
  display: flex;
  gap: 12rpx;
  flex-wrap: wrap;
  margin-top: 12rpx;
}

/* 同步状态条（autoSync 驱动，嵌在页面顶部）：四态小字，failed 可点重试 */
.sync-bar {
  padding: 8rpx 32rpx;
  font-size: 24rpx;
  line-height: 1.4;
  color: var(--bt-color-label-secondary);
}

.sync-bar--syncing {
  color: var(--bt-color-accent);
}

.sync-bar--synced {
  color: var(--bt-color-label-secondary);
}

.sync-bar--failed {
  color: var(--bt-color-danger);
}

.sync-bar--local {
  color: var(--bt-color-label-tertiary);
}
/* 灯组配置弹窗（长按灯组 Tab 打开）：居中面板，名称 + 灯珠范围拖选内嵌。 */
.group-config-mask {
  position: fixed;
  inset: 0;
  z-index: 90;
  display: flex;
  align-items: center;
  justify-content: center;
}

.group-config-backdrop {
  position: absolute;
  inset: 0;
  background: rgba(0, 0, 0, 0.4);
}

.group-config-panel {
  position: relative;
  width: 90vw;
  max-width: 720rpx;
  max-height: 80vh;
  overflow-y: auto;
  background: var(--bt-color-bg-elevated);
  border-radius: 28rpx;
  padding: 24rpx;
  box-shadow: 0 24rpx 64rpx rgba(0, 0, 0, 0.2);
  display: flex;
  flex-direction: column;
}

.group-config-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.group-config-title {
  font-size: 32rpx;
  line-height: 44rpx;
  font-weight: 700;
  color: var(--bt-color-label);
}

.group-config-close {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  line-height: 40rpx;
  color: var(--bt-color-label-secondary);
  border-radius: 999rpx;
  background: var(--bt-color-bg-input);
}

/* 取消区：fixed 屏幕底部，与弹窗物理分离，永不遮挡方格 */
.led-cancel-zone {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  height: 80rpx;
  z-index: 101;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(180deg, rgba(255, 56, 60, 0) 0%, rgba(255, 56, 60, 0.25) 40%, rgba(255, 56, 60, 0.45) 100%);
  transition: background 0.2s ease-out;
}

.led-cancel-zone--active {
  background: linear-gradient(180deg, rgba(255, 56, 60, 0.1) 0%, rgba(255, 56, 60, 0.45) 40%, rgba(255, 56, 60, 0.7) 100%);
}

.led-cancel-zone__text {
  font-size: 28rpx;
  line-height: 40rpx;
  color: #ffffff;
  font-weight: 600;
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.25);
}

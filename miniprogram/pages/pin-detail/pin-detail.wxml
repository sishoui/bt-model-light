<!-- 引脚配置详情页（ADR-0027 / #27 / T7；灯珠拖选 #31）。
     顶部图片/名称/开关 + 灯组下拉（同一卡片，「配置」开弹窗改名称/灯珠范围）→ 阶段/图层/灯效编辑。
     修改即推送（autoSync 防抖下发），无保存按钮。 -->
<view class="page">
  <sim-banner wx:if="{{simMode}}" />

  <!-- 同步状态条（autoSync 驱动）：syncing/synced/failed/local 四态，idle 不显示 -->
  <view class="sync-bar sync-bar--{{syncState}}" bindtap="onSyncRetry">
    <text class="sync-bar__text" wx:if="{{syncState === 'syncing'}}">同步中…</text>
    <text class="sync-bar__text" wx:elif="{{syncState === 'synced'}}">已同步 · {{syncAt}}</text>
    <text class="sync-bar__text" wx:elif="{{syncState === 'failed'}}">同步失败，点此重试</text>
    <text class="sync-bar__text" wx:elif="{{syncState === 'local'}}">仅本机（未连接）</text>
  </view>

  <!-- 顶部卡片：图片 / 名称 / 开关，下方分隔线内嵌灯组下拉选择（固定 5 组，无增删） -->
  <view class="bt-card pin-head-card">
    <view class="pin-head">
      <image class="pin-head__img" src="{{img}}" mode="aspectFill" />
      <view class="pin-head__info">
        <input class="pin-head__name" value="{{pinName}}" placeholder="引脚名称" bindinput="onPinNameInput" />
        <view class="bt-row bt-row--between">
          <text class="bt-text--secondary">引脚 {{pin + 1}}</text>
          <!-- 灯带开关：设备关机（整机开关 off，ADR-0032）时置灰不可切换 -->
          <switch checked="{{power}}" disabled="{{!masterPower}}" color="#0088FF" bindchange="onPowerChange" />
        </view>
      </view>
    </view>

    <!-- 灯组选择：下拉框（左，占满）+「配置」开名称/灯珠范围弹窗 -->
    <view wx:if="{{groups.length}}" class="group-select">
      <picker class="group-select__picker" mode="selector" range="{{groups}}" range-key="name" value="{{activeGroup}}" bindchange="onGroupPick">
        <view class="group-select__value">
          <view class="group-select__text">
            <text class="group-select__name">{{groups[activeGroup].name}}</text>
            <text class="group-select__range">{{groups[activeGroup].ledStart === 255 ? '未配置灯珠' : '灯珠 ' + groups[activeGroup].ledStart + '-' + groups[activeGroup].ledEnd}}</text>
          </view>
          <text class="group-select__arrow">▼</text>
        </view>
      </picker>
      <view class="group-select__config bt-pressable" bindtap="onOpenGroupConfig">配置</view>
    </view>
  </view>

  <!-- 灯珠范围拖选：长按 1s 激活刷选；被其他灯组占用的格灰显不可选；
       拖选时全屏半透明覆盖层 fixed 屏幕下方（微信语音取消样式），拖入松手回滚。 -->
  <block wx:if="{{groups.length}}">
  <!-- 阶段标题 + 添加（＋ 在标题右侧，满 5 禁用）；下方圆形节点步进条撑满居中 -->
  <view class="stage-head">
    <text class="stage-head__title">阶段</text>
    <view
      class="stage-add {{groups[activeGroup].steps.length >= stepsPerGroupMax ? 'stage-add--disabled' : ''}} bt-pressable"
      bindtap="onAddStep"
    >＋</view>
  </view>
  <scroll-view class="stage-bar__scroll" scroll-x enhanced show-scrollbar="{{false}}">
    <view class="stage-inner">
      <block wx:for="{{groups[activeGroup].steps}}" wx:key="sid" wx:for-item="step" wx:for-index="si">
        <view
          class="stage-seg {{activeStepSi === si ? 'stage-seg--active' : ''}} {{dragIndex === si ? 'stage-seg--drag' : ''}} {{enterIndex === si ? 'stage-seg--enter' : ''}}"
          style="width: {{segW[si] || 0}}rpx; transform: translateX({{offsets[si] || 0}}px);"
          data-si="{{si}}"
          bindtap="onSelectStage"
          bindlongpress="onStageLongPress"
          catchtouchmove="onStageTouchMove"
          bindtouchend="onStageTouchEnd"
          bindtouchcancel="onStageTouchEnd"
        >
          <text class="stage-seg__num">{{si + 1}}</text>
          <text class="stage-seg__name">{{step.name}}</text>
          <text class="stage-seg__info">{{step.duration}}s</text>
        </view>
      </block>
    </view>
  </scroll-view>

  <!-- 阶段时间轴图（泳道甘特）：按 duration 比例的总时长条 + 每段内图层子条 +
       过渡斜纹区间。与上方分段条互补：分段条管选中/拖排序，这里看整体节奏构成。 -->
  <view wx:if="{{timeline.length}}" class="timeline">
    <view class="timeline__head">
      <text class="timeline__title">时间轴</text>
      <text class="timeline__total">{{timelineTotal}}s · {{timeline.length}} 阶段</text>
    </view>
    <view class="timeline__track">
      <view
        wx:for="{{timeline}}"
        wx:key="si"
        wx:for-item="seg"
        class="timeline__seg {{seg.active ? 'timeline__seg--active' : ''}}"
        style="left: {{seg.x * 100}}%; width: {{seg.w * 100}}%;"
        data-si="{{seg.si}}"
        bindtap="onSelectStage"
      >
        <!-- 段内图层子条：每层一条横条，颜色取灯效主题色 -->
        <view class="timeline__layers">
          <view
            wx:for="{{seg.layers}}"
            wx:key="li"
            wx:for-item="ly"
            class="timeline__layer"
            style="background-color: {{ly.color}}; width: {{100 / seg.layers.length}}%;"
          ></view>
        </view>
        <!-- 过渡区间：段尾斜纹（可选过渡/循环模式时出现） -->
        <view
          wx:if="{{seg.transW > 0}}"
          class="timeline__trans"
          style="left: {{(seg.transX - seg.x) / seg.w * 100}}%; width: {{seg.transW / seg.w * 100}}%;"
        ></view>
        <text class="timeline__label">{{seg.duration}}s</text>
      </view>
    </view>
    <!-- 图例：当前灯组用到的灯效 -->
    <view wx:if="{{timelineLegend.length}}" class="timeline__legend">
      <view wx:for="{{timelineLegend}}" wx:key="effect" class="timeline__legend-item">
        <view class="timeline__legend-dot" style="background-color: {{item.color}};"></view>
        <text class="timeline__legend-text">{{item.name}}</text>
      </view>
    </view>
  </view>

  <!-- 阶段详情气泡卡片：箭头指向当前选中阶段（left 由 JS 按段中心算出） -->
  <view class="step-bubble" style="--bubble-x: {{bubbleX}}rpx;">
    <view class="step-bubble__arrow"></view>
    <view class="step-detail">
      <view class="step-detail__head">
        <text class="step-detail__title">{{groups[activeGroup].name}} · {{groups[activeGroup].steps[activeStepSi].name}}</text>
      </view>

    <view class="row">
      <text class="row__label">阶段名称</text>
      <input class="row__input" value="{{groups[activeGroup].steps[activeStepSi].name}}" data-si="{{activeStepSi}}" bindinput="onStageNameInput" />
    </view>

      <view class="row">
        <text class="row__label">时长</text>
        <slider class="row__slider" min="{{1}}" max="{{60}}" step="1" value="{{groups[activeGroup].steps[activeStepSi].duration}}" activeColor="#0088FF" block-size="20" data-si="{{activeStepSi}}" bindchanging="onDurationChanging" bindchange="onDurationChange" />
        <input class="row__input row__input--num row__slider-input" type="number" value="{{groups[activeGroup].steps[activeStepSi].duration}}" data-si="{{activeStepSi}}" bindinput="onDurationInput" />
      </view>
      <view class="row row--two">
        <view class="row__half">
          <text class="row__label">过渡</text>
          <picker class="row__picker" mode="selector" range="{{transitionOptions}}" data-si="{{activeStepSi}}" bindchange="onTransitionChange">
            <view>{{transitionOptions[groups[activeGroup].steps[activeStepSi].transition]}}</view>
          </picker>
        </view>
        <view class="row__half">
          <text class="row__label">循环</text>
          <picker class="row__picker" mode="selector" range="{{loopOptions}}" data-si="{{activeStepSi}}" bindchange="onLoopChange">
            <view>{{loopOptions[groups[activeGroup].steps[activeStepSi].loopMode]}}</view>
          </picker>
        </view>
      </view>

      <!-- 图层：两列固定槽位卡（背景 / 动效）。占用槽显示灯效/色块/摘要，点开弹窗编辑；
           空槽显示「＋ 添加」，点它在该槽位新建。每格右下角都带删除，删完该格回到空槽，
           另一格原位不动；两格都空 = 该阶段不亮（ADR-0033）。 -->
      <view class="layer-grid">
        <view
          wx:for="{{groups[activeGroup].steps[activeStepSi].layers}}"
          wx:key="lid"
          wx:for-item="layer"
          wx:for-index="li"
          class="layer-card {{layer.empty ? 'layer-card--empty' : ''}} bt-pressable"
          data-si="{{activeStepSi}}"
          data-li="{{li}}"
          data-slot="{{li}}"
          bindtap="onOpenLayerEditor"
        >
          <view class="layer-card__top">
            <text class="layer-card__title">图层 {{li + 1}} · {{layer.role}}</text>
            <!-- 右上角删除：catchtap 拦住冒泡，删图层不打开配置弹窗。每个占用槽都有 -->
            <view
              wx:if="{{!layer.empty}}"
              class="layer-card__del bt-pressable"
              data-si="{{activeStepSi}}"
              data-li="{{li}}"
              catchtap="onDeleteLayer"
            >✕</view>
          </view>
          <block wx:if="{{layer.empty}}">
            <view class="layer-card__empty-body">
              <text class="layer-card__plus">＋</text>
              <text class="layer-card__add-text">添加{{layer.role}}</text>
            </view>
          </block>
          <block wx:else>
            <view class="layer-card__mid">
              <view
                class="layer-card__swatch {{layer.swatch ? '' : 'layer-card__swatch--none'}}"
                style="{{layer.swatch ? 'background-color: ' + layer.swatch + ';' : ''}}"
              ></view>
              <text class="layer-card__effect">{{layer.effectName}}</text>
            </view>
            <!-- 渐变色带：多色灯效（彩虹/双色渐变/流星等）一眼可见；单色灯效不显示 -->
            <view
              wx:if="{{layer.gradientCss}}"
              class="layer-card__gradient"
              style="background-image: {{layer.gradientCss}};"
            ></view>
            <text class="layer-card__summary">{{layer.summary || '默认参数'}}</text>
          </block>
        </view>
      </view>

      <!-- 两格都空时的提示：该阶段下发后灯珠不亮 -->
      <text wx:if="{{activeStepEmpty}}" class="layer-empty-hint">本阶段没有图层，灯珠不亮</text>
    </view>

    <view wx:if="{{groups[activeGroup].steps.length > 1}}" class="del-stage bt-pressable" data-si="{{activeStepSi}}" catchtap="onDeleteStep">删除当前阶段</view>
    </view>
  </block>

  <!-- 颜色弹层：全屏遮罩 + 底部弹板（色轮 + 最近选色） -->
  <view wx:if="{{colorPickerOpen}}" class="color-picker-mask" catchtouchmove="noop">
    <view class="color-picker-backdrop" bindtap="onCloseColorPicker"></view>
    <view class="color-picker-panel">
      <view class="color-picker-head">
        <text class="color-picker-title">选择颜色</text>
        <text class="color-picker-close" bindtap="onCloseColorPicker">✕</text>
      </view>
      <!-- 色轮：角度=色相，半径=饱和度。亮度不在这里调——图层有自己的亮度参数 -->
      <view class="picker-main">
        <view
          class="picker-wheel"
          bindtouchstart="onPickerTouchStart"
          catchtouchmove="onPickerTouchMove"
          bindtouchend="onPickerTouchEnd"
          bindtouchcancel="onPickerTouchEnd"
        >
          <canvas type="2d" class="color-wheel" id="color-wheel"></canvas>
          <view class="picker-dot" style="left: {{pickerUi.dotX}}; top: {{pickerUi.dotY}}; background-color: {{pickerHex}};"></view>
        </view>
        <view class="picker-side">
          <view class="picker-preview" style="background-color: {{pickerHex}};"></view>
          <text class="picker-hex">{{pickerHex}}</text>
          <text class="picker-hs">{{pickerHueSat.h}}° · 饱和 {{pickerHueSat.s}}%</text>
        </view>
      </view>
      <view wx:if="{{recentColors.length}}" class="recent-colors">
        <text class="recent-colors__title">最近使用</text>
        <view class="recent-colors__row">
          <view
            wx:for="{{recentColors}}"
            wx:key="*this"
            wx-item="c"
            class="color-cell color-cell--recent"
            style="background-color: {{c}};"
            data-hex="{{c}}"
            data-si="{{colorPickerTarget.si}}"
            data-li="{{colorPickerTarget.li}}"
            data-fi="{{colorPickerTarget.fi}}"
            bindtap="onColorSelected"
          ></view>
        </view>
      </view>
    </view>
  </view>

  <!-- 图层配置弹窗（点两列卡片打开）：灯效下拉 + schema 参数表单 + 删除图层。
       颜色弹层 z-index 更高，可在本弹窗之上叠开，选完色回落到本弹窗继续编辑。 -->
  <view wx:if="{{layerEditorOpen}}" class="layer-editor-mask" catchtouchmove="noop">
    <view class="layer-editor-backdrop" bindtap="onCloseLayerEditor"></view>
    <view class="layer-editor-panel">
      <view class="layer-editor-head">
        <text class="layer-editor-title">图层 {{layerEditorLi + 1}} · {{groups[activeGroup].steps[layerEditorSi].layers[layerEditorLi].role}} · {{groups[activeGroup].steps[layerEditorSi].layers[layerEditorLi].effectName}}</text>
        <text class="layer-editor-close" bindtap="onCloseLayerEditor">✕</text>
      </view>

      <picker class="row__picker layer-editor__effect" mode="selector" range="{{effectNames}}" data-si="{{layerEditorSi}}" data-li="{{layerEditorLi}}" bindchange="onEffectChange">
        <view>灯效：{{groups[activeGroup].steps[layerEditorSi].layers[layerEditorLi].effectName}}</view>
      </picker>

      <!-- 3D 灯效预览（canvas 2d）：按当前灯效 + 参数逐灯珠渲染（规则同固件），
           再投影成一条长条灯条。调参即时重绘，也可拖动旋转查看。 -->
      <view class="effect3d">
        <view class="effect3d__head">
          <text class="effect3d__title">3D 灯效预览</text>
          <text class="effect3d__hint">{{previewLeds}} 颗 · {{previewLayerCount}} 图层 · 拖动旋转</text>
        </view>
        <view
          class="effect3d__stage"
          bindtouchstart="onPreviewTouchStart"
          catchtouchmove="onPreviewTouchMove"
          bindtouchend="onPreviewTouchEnd"
          bindtouchcancel="onPreviewTouchEnd"
        >
          <canvas
            type="2d"
            class="effect3d-canvas"
            id="effect3d-canvas"
          ></canvas>
        </view>
      </view>

      <!-- 参数表单：按 effect schema 渲染（u8/u16 连续量走滑块，枚举走胶囊，rgb 走色块弹层） -->
      <view
        wx:for="{{groups[activeGroup].steps[layerEditorSi].layers[layerEditorLi].fields}}"
        wx:key="name"
        wx:for-item="fld"
        wx:for-index="fi"
        class="row param"
      >
        <text class="row__label">{{fld.label}}</text>
        <block wx:if="{{fld.type === 'rgb'}}">
          <view
            class="color-swatch"
            style="background-color: {{fld.hex}};"
            data-si="{{layerEditorSi}}"
            data-li="{{layerEditorLi}}"
            data-fi="{{fi}}"
            bindtap="onOpenColorPicker"
          ></view>
        </block>
        <view
          wx:elif="{{fld.options}}"
          class="param-radio"
          data-si="{{layerEditorSi}}"
          data-li="{{layerEditorLi}}"
          data-fi="{{fi}}"
        >
          <view
            wx:for="{{fld.options}}"
            wx:key="*this"
            wx:for-item="opt"
            wx:for-index="oi"
            class="param-radio__item {{fld.displayValue === oi ? 'param-radio__item--on' : ''}}"
            data-si="{{layerEditorSi}}"
            data-li="{{layerEditorLi}}"
            data-fi="{{fi}}"
            data-oi="{{oi}}"
            bindtap="onParamOptionTap"
          >{{opt}}</view>
        </view>
        <block wx:elif="{{fld.slider}}">
          <slider
            class="param-slider__bar"
            min="{{fld.min}}"
            max="{{fld.max}}"
            step="1"
            value="{{fld.value}}"
            activeColor="#0088FF"
            block-size="20"
            data-si="{{layerEditorSi}}"
            data-li="{{layerEditorLi}}"
            data-fi="{{fi}}"
            bindchanging="onParamChanging"
            bindchange="onParamChange"
          />
          <input
            class="row__input row__input--num row__slider-input"
            type="number"
            value="{{fld.value}}"
            data-si="{{layerEditorSi}}"
            data-li="{{layerEditorLi}}"
            data-fi="{{fi}}"
            bindinput="onParamInput"
          />
        </block>
        <input
          wx:else
          class="row__input row__input--num"
          type="number"
          value="{{fld.value}}"
          data-si="{{layerEditorSi}}"
          data-li="{{layerEditorLi}}"
          data-fi="{{fi}}"
          bindinput="onParamInput"
        />
      </view>

      <!-- 弹窗内删除：清空该槽位（另一格不受影响）；两格都空后本阶段灯珠不亮 -->
      <view
        class="layer-editor__del bt-pressable"
        data-si="{{layerEditorSi}}"
        data-li="{{layerEditorLi}}"
        bindtap="onDeleteLayer"
      >删除该图层</view>
    </view>
  </view>

  <!-- 灯组配置弹窗（点灯组行的「配置」打开）：名称 + 灯珠范围拖选（第一层弹窗，无二级弹层）。
       拖选激活后底部浮出取消区（fixed，微信语音取消样式），拖入松手回滚。 -->
  <view wx:if="{{groupConfigOpen}}" class="group-config-mask" catchtouchmove="noop">
    <view class="group-config-backdrop" bindtap="onCloseGroupConfig"></view>
    <view class="group-config-panel">
      <view class="group-config-head">
        <text class="group-config-title">灯组 {{activeGroup + 1}} 配置</text>
        <text class="group-config-close" bindtap="onCloseGroupConfig">✕</text>
      </view>
      <view class="row">
        <text class="row__label">名称</text>
        <input class="row__input" value="{{groups[activeGroup].name}}" data-index="{{activeGroup}}" bindinput="onGroupNameInput" />
      </view>
      <view class="range">
        <view class="bt-row bt-row--between">
          <text class="range__title">灯珠范围 <text wx:if="{{groups[activeGroup].ledStart !== 255}}">[{{groups[activeGroup].ledStart}}, {{groups[activeGroup].ledEnd}}] ({{groups[activeGroup].ledEnd - groups[activeGroup].ledStart + 1}} 颗)</text><text wx:else>未选 (0 颗)</text></text>
        </view>
        <view
          class="led-grid"
          bindtouchstart="onLedTouchStart"
          catchtouchmove="onLedTouchMove"
          bindtouchend="onLedTouchEnd"
          bindtouchcancel="onLedTouchEnd"
        >
          <view
            wx:for="{{ledCells}}"
            wx:key="i"
            class="led-cell led-cell--{{item.state}}"
          >{{item.i}}</view>
        </view>
        <view class="range__hint">{{dragging ? (inCancelZone ? '松开取消 · 保留上次选择' : '拖动中…') : '长按 1 秒激活拖动刷选；灰色为被其他灯组占用'}}</view>
        <view class="range__actions">
          <view class="range__clear bt-pressable" bindtap="onClearLeds">清除本组</view>
        </view>
      </view>
    </view>
  </view>

  <!-- 取消区：fixed 屏幕底部，与弹窗物理分离，永不遮挡方格 -->
  <view wx:if="{{groupConfigOpen && dragging}}" class="led-cancel-zone {{inCancelZone ? 'led-cancel-zone--active' : ''}}">
    <text class="led-cancel-zone__text">{{inCancelZone ? '松开取消 · 保留上次选择' : '拖到此处取消 · 保留上次选择'}}</text>
  </view>
</view>
<!-- 引脚配置详情页（ADR-0027 / #27 / T7；灯珠拖选 #31；design.md §7.3 工具页范式）。
     顶部信息卡（图/名称/开关 + 药丸灯组选择）→ 竖向时间轴（左轴圆点管时长，
     右侧每段一张卡片）。卡片里图层纵向排列：数值参数是细边圆环，环长与环下文字
     都是 1-100% 的百分比；点环在该图层卡片内展开一行数字轴拖值（环同步走）。
     枚举参数不占圆环，整行一排选项卡直接换档。卡头的灯效方块开磁贴面板换灯效。
     列表顺序即播放顺序，段内 ↑↓ 调整先后。修改即推送（autoSync 防抖下发），无保存按钮。 -->
<view class="page">
  <sim-banner wx:if="{{simMode}}" />

  <!-- 同步状态条（autoSync 驱动）：syncing/synced/failed/local 四态，idle 不显示 -->
  <view class="sync-bar sync-bar--{{syncState}}" bindtap="onSyncRetry">
    <text class="sync-bar__text" wx:if="{{syncState === 'syncing'}}">同步中…</text>
    <text class="sync-bar__text" wx:elif="{{syncState === 'synced'}}">已同步 · {{syncAt}}</text>
    <text class="sync-bar__text" wx:elif="{{syncState === 'failed'}}">同步失败，点此重试</text>
    <text class="sync-bar__text" wx:elif="{{syncState === 'local'}}">仅本机（未连接）</text>
  </view>

  <!-- 顶部卡片：引脚图 / 名称 / 开关 + 药丸灯组选择 -->
  <view class="bt-card pin-head-card">
    <view class="pin-head">
      <image class="pin-head__img" src="{{img}}" mode="aspectFill" />
      <view class="pin-head__info">
        <input
          class="pin-head__name"
          value="{{pinName}}"
          placeholder="引脚名称"
          placeholder-class="pin-head__placeholder"
          bindinput="onPinNameInput"
        />
        <view class="pin-head__switch-row">
          <text class="pin-head__pin-no">引脚 {{pin + 1}}</text>
          <!-- 灯带开关：设备关机（整机开关 off，ADR-0032）时置灰不可切换 -->
          <switch checked="{{power}}" disabled="{{!masterPower}}" color="#0088FF" bindchange="onPowerChange" />
        </view>
      </view>
    </view>

    <!-- 灯组选择：药丸（左，占满，点它开灯组磁贴面板）+「配置」开名称/灯珠范围弹窗 -->
    <view wx:if="{{groups.length}}" class="group-select">
      <view class="group-select__value bt-pressable" bindtap="onOpenGroupPicker">
        <view class="group-select__text">
          <text class="group-select__name">{{groups[activeGroup].name}}</text>
          <text class="group-select__range">{{groups[activeGroup].ledStart === 255 ? '未配置灯珠' : '灯珠 ' + groups[activeGroup].ledStart + '-' + groups[activeGroup].ledEnd}}</text>
        </view>
        <text class="group-select__arrow">▼</text>
      </view>
      <view class="group-select__config bt-pressable" bindtap="onOpenGroupConfig">配置</view>
    </view>
  </view>

  <!-- 灯珠范围拖选：长按 1s 激活刷选；被其他灯组占用的格灰显不可选；
       拖选时全屏半透明覆盖层 fixed 屏幕下方（微信语音取消样式），拖入松手回滚。 -->
  <block wx:if="{{groups.length}}">
  <!-- 阶段标题行：标题 + 总时长 + 添加（＋ 在右侧，满 stepsPerGroupMax 禁用） -->
  <view class="stage-head">
    <text class="stage-head__title">阶段</text>
    <text class="stage-head__total">共 {{stepsTotal}}s</text>
    <view
      class="stage-add {{groups[activeGroup].steps.length >= stepsPerGroupMax ? 'stage-add--disabled' : ''}} bt-pressable"
      bindtap="onAddStep"
    >＋</view>
  </view>

  <!-- 竖向时间轴：左列是轴（圆点 = 阶段时长，点它展开时长刻度轴；环色 = 该段首个
       灯效主题色），右侧每段一张卡片。列表顺序即播放顺序，↑↓ 调整先后。
       卡片里的图层纵向排列，每个可调参数是一枚细边圆环：环长 = 当前值比例，
       点开后在该卡片下方展开刻度轴，拖轴实时改值（环同步走）。 -->
  <view class="timeline">
    <view
      wx:for="{{groups[activeGroup].steps}}"
      wx:key="sid"
      wx:for-item="step"
      wx:for-index="si"
      class="tl-row"
    >
      <!-- 左轴：起始时刻 + 时长圆点 + 连线（末段不画线） -->
      <view class="tl-axis">
        <text class="tl-axis__time">{{stepAxis[si].startAt}}s</text>
        <view
          class="tl-axis__dot {{gauge && gauge.kind === 'duration' && gauge.si === si ? 'tl-axis__dot--on' : ''}}"
          style="{{stepAxis[si].color ? 'border-color: ' + stepAxis[si].color + ';' : ''}}"
          data-si="{{si}}"
          data-kind="duration"
          bindtap="onToggleGauge"
        ><text class="tl-axis__duration">{{step.duration}}</text></view>
        <view wx:if="{{si < groups[activeGroup].steps.length - 1}}" class="tl-axis__line"></view>
      </view>

      <view class="tl-card {{enterIndex === si ? 'tl-card--enter' : ''}}">
        <!-- 卡头：序号 + 名称输入 + 上移/下移 + 删除阶段（仅 1 段时不给删） -->
        <view class="tl-card__head">
          <text class="tl-card__no">{{si + 1}}</text>
          <input
            class="tl-card__name"
            value="{{step.name}}"
            placeholder="阶段名称"
            placeholder-class="pin-head__placeholder"
            data-si="{{si}}"
            bindinput="onStageNameInput"
          />
          <view
            class="tl-card__move {{si === 0 ? 'tl-card__move--off' : ''}}"
            data-si="{{si}}"
            data-dir="-1"
            catchtap="onMoveStep"
          >↑</view>
          <view
            class="tl-card__move {{si === groups[activeGroup].steps.length - 1 ? 'tl-card__move--off' : ''}}"
            data-si="{{si}}"
            data-dir="1"
            catchtap="onMoveStep"
          >↓</view>
          <view
            wx:if="{{groups[activeGroup].steps.length > 1}}"
            class="tl-card__del"
            data-si="{{si}}"
            catchtap="onDeleteStep"
          >✕</view>
        </view>

        <!-- 图层：纵向一列（背景 / 动效固定两槽）。卡头显示灯效名（点它换灯效），
             下面一排圆环是该灯效的可调参数：环长 = 值占量程比例，没有弹窗。
             空槽显示「＋ 添加」，点它在该槽位新建；删完回到空槽，另一格原位不动；
             两格都空 = 该阶段不亮（ADR-0033）。 -->
        <view class="layer-list">
          <view
            wx:for="{{step.layers}}"
            wx:key="lid"
            wx:for-item="layer"
            wx:for-index="li"
            class="layer-row {{layer.empty ? 'layer-row--empty' : ''}}"
          >
            <!-- 卡头：图层槽名 + 灯效方块磁贴（图标 + 名称，点它开灯效面板）+ 删除 -->
            <view class="layer-row__head">
              <text class="layer-row__title">图层 {{li + 1}} · {{layer.role}}</text>
              <view
                wx:if="{{!layer.empty}}"
                class="effect-tile bt-pressable {{gauge && gauge.si === si && gauge.li === li ? 'effect-tile--on' : ''}}"
                style="--tile-color: {{layer.accent}};"
                data-si="{{si}}"
                data-li="{{li}}"
                bindtap="onOpenEffectPicker"
              >
                <view class="effect-tile__icon">
                  <view class="bt-ico bt-ico--e-{{layer.effectIcon}}"></view>
                </view>
                <text class="effect-tile__name">{{layer.effectName}}</text>
                <text class="effect-tile__caret">▾</text>
              </view>
              <view
                wx:if="{{!layer.empty}}"
                class="layer-row__del bt-pressable"
                data-si="{{si}}"
                data-li="{{li}}"
                catchtap="onDeleteLayer"
              >✕</view>
            </view>

            <view wx:if="{{layer.empty}}" class="layer-row__empty bt-pressable" data-si="{{si}}" data-li="{{li}}" data-slot="{{li}}" bindtap="onLayerCardTap">
              <text class="layer-row__plus">＋</text>
              <text class="layer-row__add-text">添加{{layer.role}}</text>
            </view>

            <block wx:else>
              <!-- 圆环行：rgb 参数是实心色盘（点开颜色弹层），数值参数是细边进度环
                   （环长与环下百分比同源）。枚举参数不占这里，另起整行选项卡。 -->
              <view class="ring-row">
                <view
                  wx:for="{{layer.ringFields}}"
                  wx:key="name"
                  wx:for-item="fld"
                  class="ring-item"
                >
                  <block wx:if="{{fld.type === 'rgb'}}">
                    <view
                      class="ring-item__dot"
                      style="background-color: {{fld.hex}};"
                      data-si="{{si}}"
                      data-li="{{li}}"
                      data-fi="{{fld.index}}"
                      bindtap="onOpenColorPicker"
                    ></view>
                    <!-- 名称与 hex 同一行 -->
                    <text class="ring-item__caption">{{fld.label}} {{fld.hex}}</text>
                  </block>
                  <block wx:else>
                    <!-- 细边圆环：conic-gradient 画进度（环长 = 值比例），内层挖空成环，
                         洞里放该参数的极简线条图标。点击只描边高亮，不染内圈——
                         否则进度弧 + 染色圆盘会被读成"扇形"。 -->
                    <view
                      class="ring-item__ring {{gauge && gauge.si === si && gauge.li === li && gauge.name === fld.name ? 'ring-item__ring--on' : ''}}"
                      style="background: conic-gradient(var(--bt-color-accent) {{fld.ring}}%, var(--bt-color-gray-5) 0);"
                      data-si="{{si}}"
                      data-li="{{li}}"
                      data-name="{{fld.name}}"
                      data-kind="param"
                      bindtap="onToggleGauge"
                    >
                      <view class="ring-item__hole">
                        <view class="bt-ico bt-ico--p-{{fld.icon}}"></view>
                      </view>
                    </view>
                    <!-- 名称与百分比同一行：数值不独占一行，整行高度更紧凑 -->
                    <text class="ring-item__caption">{{fld.label}} {{fld.valueText}}</text>
                  </block>
                </view>
              </view>

              <!-- 枚举参数：整行一排选项卡，点一下即换档 -->
              <view
                wx:for="{{layer.optionFields}}"
                wx:key="name"
                wx:for-item="fld"
                class="option-row"
              >
                <text class="option-row__label">{{fld.label}}</text>
                <view class="option-tabs">
                  <view
                    wx:for="{{fld.options}}"
                    wx:key="*this"
                    wx:for-item="opt"
                    wx:for-index="oi"
                    class="option-tabs__item {{fld.optionIndex === oi ? 'option-tabs__item--on' : ''}} bt-pressable"
                    data-si="{{si}}"
                    data-li="{{li}}"
                    data-name="{{fld.name}}"
                    data-index="{{oi}}"
                    bindtap="onPickOption"
                  >{{opt}}</view>
                </view>
              </view>

              <!-- 数字轴：只在这张图层卡片内展开（点数值圆环），横向拖动改值；
                   高 0 → auto 的 grid 过渡让展开/收起是拉伸而不是跳变。 -->
              <view class="gauge-slot gauge-slot--{{(gauge && gauge.si === si && gauge.li === li) || (gaugeClosing && gaugeClosing.si === si && gaugeClosing.li === li) ? 'open' : 'closed'}}">
                <view class="gauge-slot__inner">
                  <view
                    wx:if="{{gauge && gauge.si === si && gauge.li === li}}"
                    class="gauge gauge--in"
                  >
                    <!-- 极简：一条细线 + 一枚手柄（名称与百分比在圆环下那行），右侧只放当前值 -->
                    <view
                      class="gauge__track"
                      bindtouchstart="onGaugeTouchStart"
                      catchtouchmove="onGaugeTouchMove"
                      bindtouchend="onGaugeTouchEnd"
                      bindtouchcancel="onGaugeTouchEnd"
                    >
                      <view class="gauge__handle" style="left: {{gauge.ratio * 100}}%;"></view>
                    </view>
                    <text class="gauge__value">{{gauge.readout}}</text>
                  </view>
                  <view
                    wx:elif="{{gaugeClosing && gaugeClosing.si === si && gaugeClosing.li === li}}"
                    class="gauge gauge--out"
                  >
                    <view class="gauge__track"></view>
                    <text class="gauge__value">{{gaugeClosing.readout}}</text>
                  </view>
                </view>
              </view>

              <!-- 渐变色带：多色灯效（彩虹/双色渐变/流星等）一眼可见；单色灯效不显示 -->
              <view
                wx:if="{{layer.gradientCss}}"
                class="layer-row__gradient"
                style="background-image: {{layer.gradientCss}};"
              ></view>
            </block>
          </view>
        </view>

        <!-- 阶段时长数字轴：时长没有图层卡片，留在阶段卡片底部。
             同一套数字轴样式，点左轴圆点展开、横向拖动改秒数。 -->
        <view class="gauge-slot gauge-slot--{{(gauge && gauge.kind === 'duration' && gauge.si === si) || (gaugeClosing && gaugeClosing.kind === 'duration' && gaugeClosing.si === si) ? 'open' : 'closed'}}">
          <view class="gauge-slot__inner">
            <view
              wx:if="{{gauge && gauge.kind === 'duration' && gauge.si === si}}"
              class="gauge gauge--in"
            >
              <view
                class="gauge__track"
                bindtouchstart="onGaugeTouchStart"
                catchtouchmove="onGaugeTouchMove"
                bindtouchend="onGaugeTouchEnd"
                bindtouchcancel="onGaugeTouchEnd"
              >
                <view class="gauge__handle" style="left: {{gauge.ratio * 100}}%;"></view>
              </view>
              <text class="gauge__value">{{gauge.readout}}</text>
            </view>
            <view
              wx:elif="{{gaugeClosing && gaugeClosing.kind === 'duration' && gaugeClosing.si === si}}"
              class="gauge gauge--out"
            >
              <view class="gauge__track"></view>
              <text class="gauge__value">{{gaugeClosing.readout}}</text>
            </view>
          </view>
        </view>

        <!-- 两格都空时的提示：该阶段下发后灯珠不亮 -->
        <text wx:if="{{stepAxis[si].allEmpty}}" class="layer-empty-hint">本阶段没有图层，灯珠不亮</text>
      </view>
    </view>
  </view>

  </block>

  <!-- 底部磁贴面板（灯组 / 灯效两种选择共用同一套外壳：遮罩 + 底部弹板 + 标题 + 网格）：
       灯组面板列 5 个灯组（名称 + 灯珠区间），灯效面板列 8 种灯效（方框图标 + 名称）。 -->
  <view wx:if="{{groupPickerOpen}}" class="pick-mask" catchtouchmove="noop">
    <view class="pick-backdrop" bindtap="onCloseGroupPicker"></view>
    <view class="pick-panel">
      <view class="pick-panel__head">
        <text class="pick-panel__title">选择灯组</text>
        <text class="pick-panel__close" bindtap="onCloseGroupPicker">✕</text>
      </view>
      <view class="pick-grid pick-grid--groups">
        <view
          wx:for="{{groups}}"
          wx:key="gid"
          wx:for-item="grp"
          wx:for-index="gi"
          class="pick-card bt-pressable {{activeGroup === gi ? 'pick-card--on' : ''}}"
          data-group="{{gi}}"
          bindtap="onPickGroup"
        >
          <text class="pick-card__name">{{grp.name}}</text>
          <text class="pick-card__sub">{{grp.ledStart === 255 ? '未配置灯珠' : '灯珠 ' + grp.ledStart + '-' + grp.ledEnd}}</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 灯效磁贴面板：8 种灯效按方框磁贴铺开（图标 + 名称），当前灯效高亮。
       点卡头的灯效方块打开；选一个即按 schema 重建该图层参数区（ADR-0018）。 -->
  <view wx:if="{{effectPickerOpen}}" class="pick-mask" catchtouchmove="noop">
    <view class="pick-backdrop" bindtap="onCloseEffectPicker"></view>
    <view class="pick-panel">
      <view class="pick-panel__head">
        <text class="pick-panel__title">选择灯效</text>
        <text class="pick-panel__close" bindtap="onCloseEffectPicker">✕</text>
      </view>
      <view class="pick-grid">
        <view
          wx:for="{{effectOptions}}"
          wx:key="id"
          wx:for-item="opt"
          class="pick-card bt-pressable {{currentEffectId === opt.id ? 'pick-card--on' : ''}}"
          data-effect="{{opt.id}}"
          bindtap="onPickEffect"
        >
          <view class="pick-card__icon">
            <view class="bt-ico bt-ico--e-{{opt.icon}}"></view>
          </view>
          <text class="pick-card__name">{{opt.label}}</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 颜色弹层：全屏遮罩 + 底部弹板（色轮 + 最近选色） -->
  <view wx:if="{{colorPickerOpen}}" class="color-picker-mask" catchtouchmove="noop">
    <view class="color-picker-backdrop" bindtap="onCloseColorPicker"></view>
    <view class="color-picker-panel">
      <view class="color-picker-head">
        <text class="color-picker-title">选择颜色</text>
        <text class="color-picker-close" bindtap="onCloseColorPicker">✕</text>
      </view>
      <!-- 色轮：角度=色相，半径=饱和度。亮度不在这里调——图层有自己的亮度参数 -->
      <view class="picker-main">
        <view
          class="picker-wheel"
          bindtouchstart="onPickerTouchStart"
          catchtouchmove="onPickerTouchMove"
          bindtouchend="onPickerTouchEnd"
          bindtouchcancel="onPickerTouchEnd"
        >
          <canvas type="2d" class="color-wheel" id="color-wheel"></canvas>
          <view class="picker-dot" style="left: {{pickerUi.dotX}}; top: {{pickerUi.dotY}}; background-color: {{pickerHex}};"></view>
        </view>
        <view class="picker-side">
          <view class="picker-preview" style="background-color: {{pickerHex}};"></view>
          <text class="picker-hex">{{pickerHex}}</text>
          <text class="picker-hs">{{pickerHueSat.h}}° · 饱和 {{pickerHueSat.s}}%</text>
        </view>
      </view>
      <view wx:if="{{recentColors.length}}" class="recent-colors">
        <text class="recent-colors__title">最近使用</text>
        <view class="recent-colors__row">
          <view
            wx:for="{{recentColors}}"
            wx:key="*this"
            wx-item="c"
            class="color-cell color-cell--recent"
            style="background-color: {{c}};"
            data-hex="{{c}}"
            data-si="{{colorPickerTarget.si}}"
            data-li="{{colorPickerTarget.li}}"
            data-fi="{{colorPickerTarget.fi}}"
            bindtap="onColorSelected"
          ></view>
        </view>
      </view>
    </view>
  </view>

  <!-- 灯组配置弹窗（点灯组行的「配置」打开）：名称 + 灯珠范围拖选（第一层弹窗，无二级弹层）。
       拖选激活后底部浮出取消区（fixed，微信语音取消样式），拖入松手回滚。 -->
  <view wx:if="{{groupConfigOpen}}" class="group-config-mask" catchtouchmove="noop">
    <view class="group-config-backdrop" bindtap="onCloseGroupConfig"></view>
    <view class="group-config-panel">
      <view class="group-config-head">
        <text class="group-config-title">灯组 {{activeGroup + 1}} 配置</text>
        <text class="group-config-close" bindtap="onCloseGroupConfig">✕</text>
      </view>
      <view class="row">
        <text class="row__label">名称</text>
        <input class="row__input" value="{{groups[activeGroup].name}}" data-index="{{activeGroup}}" bindinput="onGroupNameInput" />
      </view>
      <view class="range">
        <view class="bt-row bt-row--between">
          <text class="range__title">灯珠范围 <text wx:if="{{groups[activeGroup].ledStart !== 255}}">[{{groups[activeGroup].ledStart}}, {{groups[activeGroup].ledEnd}}] ({{groups[activeGroup].ledEnd - groups[activeGroup].ledStart + 1}} 颗)</text><text wx:else>未选 (0 颗)</text></text>
        </view>
        <view
          class="led-grid"
          bindtouchstart="onLedTouchStart"
          catchtouchmove="onLedTouchMove"
          bindtouchend="onLedTouchEnd"
          bindtouchcancel="onLedTouchEnd"
        >
          <view
            wx:for="{{ledCells}}"
            wx:key="i"
            class="led-cell led-cell--{{item.state}}"
          >{{item.i}}</view>
        </view>
        <view class="range__hint">{{dragging ? (inCancelZone ? '松开取消 · 保留上次选择' : '拖动中…') : '长按 1 秒激活拖动刷选；灰色为被其他灯组占用'}}</view>
        <view class="range__actions">
          <view class="range__clear bt-pressable" bindtap="onClearLeds">清除本组</view>
        </view>
      </view>
    </view>
  </view>

  <!-- 取消区：fixed 屏幕底部，与弹窗物理分离，永不遮挡方格 -->
  <view wx:if="{{groupConfigOpen && dragging}}" class="led-cancel-zone {{inCancelZone ? 'led-cancel-zone--active' : ''}}">
    <text class="led-cancel-zone__text">{{inCancelZone ? '松开取消 · 保留上次选择' : '拖到此处取消 · 保留上次选择'}}</text>
  </view>
</view>
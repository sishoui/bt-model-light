<!-- 引脚配置详情页（ADR-0027 / #27 / T7；灯珠拖选 #31）。
     顶部图片/名称/开关 → 灯组 Tab → 灯珠范围拖选 → 步骤/图层/灯效编辑 → 保存。 -->
<view class="page">
  <sim-banner wx:if="{{simMode}}" />

  <!-- 顶部：图片 / 名称 / 开关 -->
  <view class="bt-card pin-head">
    <image class="pin-head__img" src="{{img}}" mode="aspectFill" />
    <view class="pin-head__info">
      <input class="pin-head__name" value="{{pinName}}" placeholder="引脚名称" bindinput="onPinNameInput" />
      <view class="bt-row bt-row--between">
        <text class="bt-text--secondary">引脚 {{pin + 1}}</text>
        <switch checked="{{power}}" color="#0088FF" bindchange="onPowerChange" />
      </view>
    </view>
  </view>

  <!-- 灯组 Tab（固定 5 个，无新增/删除；小字显示灯珠区间） -->
  <scroll-view wx:if="{{groups.length}}" class="group-tabs" scroll-x enhanced show-scrollbar="{{false}}">
    <view
      wx:for="{{groups}}"
      wx:key="gid"
      class="group-tab {{activeGroup === index ? 'group-tab--active' : ''}} bt-pressable"
      data-index="{{index}}"
      bindtap="onTapGroup"
    >
      <text class="group-tab__name">{{item.name}}</text>
      <text class="group-tab__range">{{item.ledStart}}-{{item.ledEnd}}</text>
    </view>
  </scroll-view>

  <!-- 灯珠范围拖选：长按 1s 激活刷选；被其他灯组占用的格灰显不可选；
       拖选时全屏半透明覆盖层 fixed 屏幕下方（微信语音取消样式），拖入松手回滚。 -->
  <block wx:if="{{groups.length}}">
    <view class="bt-card">
      <view class="row">
        <text class="row__label">灯组名称</text>
        <input class="row__input" value="{{groups[activeGroup].name}}" data-index="{{activeGroup}}" bindinput="onGroupNameInput" />
      </view>

      <view class="range">
        <view class="bt-row bt-row--between">
          <text class="range__title">灯珠范围 <text wx:if="{{groups[activeGroup].ledStart !== 255}}">[{{groups[activeGroup].ledStart}}, {{groups[activeGroup].ledEnd}}] ({{groups[activeGroup].ledEnd - groups[activeGroup].ledStart + 1}} 颗)</text><text wx:else>未选 (0 颗)</text></text>
          <text class="bt-text--secondary">点此选择灯珠 ›</text>
        </view>
        <view class="range__open bt-pressable" bindtap="onOpenLedPicker">
          <text>选择灯珠（长按拖动）</text>
        </view>
        <view class="range__actions">
          <view class="range__clear bt-pressable" bindtap="onClearLeds">清除本组</view>
        </view>
      </view>
    </view>

  <!-- 步骤 / 图层 / 灯效 -->
  <view
    wx:for="{{groups[activeGroup].steps}}"
    wx:key="sid"
    wx:for-item="step"
    wx:for-index="si"
    class="bt-card step"
  >
      <view class="bt-row bt-row--between step__head">
        <text class="step__title">步骤 {{si + 1}}</text>
        <text wx:if="{{groups[activeGroup].steps.length > 1}}" class="step__del" data-si="{{si}}" bindtap="onDeleteStep">删除</text>
      </view>

      <view class="row">
        <text class="row__label">时长(秒)</text>
        <input class="row__input row__input--num" type="number" value="{{step.duration}}" data-si="{{si}}" bindinput="onDurationInput" />
      </view>
      <view class="row">
        <text class="row__label">过渡</text>
        <picker class="row__picker" mode="selector" range="{{transitionOptions}}" data-si="{{si}}" bindchange="onTransitionChange">
          <view>{{transitionOptions[step.transition]}}</view>
        </picker>
      </view>
      <view class="row">
        <text class="row__label">循环</text>
        <picker class="row__picker" mode="selector" range="{{loopOptions}}" data-si="{{si}}" bindchange="onLoopChange">
          <view>{{loopOptions[step.loopMode]}}</view>
        </picker>
      </view>

      <!-- 图层 -->
      <view
        wx:for="{{step.layers}}"
        wx:key="lid"
        wx:for-item="layer"
        wx:for-index="li"
        class="layer"
      >
        <view class="bt-row bt-row--between layer__head">
          <text class="layer__title">图层 {{li + 1}}{{step.layers.length > 1 ? (li === 0 ? '（背景）' : '（动效）') : ''}}</text>
          <text wx:if="{{step.layers.length > 1}}" class="step__del" data-si="{{si}}" data-li="{{li}}" bindtap="onDeleteLayer">删除</text>
        </view>

        <picker class="row__picker layer__effect" mode="selector" range="{{effectNames}}" data-si="{{si}}" data-li="{{li}}" bindchange="onEffectChange">
          <view>灯效：{{layer.effectName}}</view>
        </picker>

        <!-- 参数表单：按 effect schema 渲染 -->
        <view
          wx:for="{{layer.fields}}"
          wx:key="name"
          wx:for-item="fld"
          wx:for-index="fi"
          class="row param"
        >
          <text class="row__label">{{fld.label}}</text>
          <!-- rgb：R / G / B 三通道 -->
          <block wx:if="{{fld.type === 'rgb'}}">
            <view class="rgb">
              <text class="rgb__ch">R</text>
              <input class="rgb__input" type="number" value="{{fld.value[0]}}" data-si="{{si}}" data-li="{{li}}" data-fi="{{fi}}" data-ch="0" bindinput="onParamInput" />
              <text class="rgb__ch">G</text>
              <input class="rgb__input" type="number" value="{{fld.value[1]}}" data-si="{{si}}" data-li="{{li}}" data-fi="{{fi}}" data-ch="1" bindinput="onParamInput" />
              <text class="rgb__ch">B</text>
              <input class="rgb__input" type="number" value="{{fld.value[2]}}" data-si="{{si}}" data-li="{{li}}" data-fi="{{fi}}" data-ch="2" bindinput="onParamInput" />
            </view>
          </block>
          <!-- u8 / u16 -->
          <block wx:else>
            <input class="row__input row__input--num" type="number" value="{{fld.value}}" data-si="{{si}}" data-li="{{li}}" data-fi="{{fi}}" bindinput="onParamInput" />
          </block>
        </view>
      </view>

      <view wx:if="{{step.layers.length < layersPerStepMax}}" class="add-layer" data-si="{{si}}" bindtap="onAddLayer">＋ 添加图层</view>
    </view>

    <view wx:if="{{groups[activeGroup].steps.length < stepsPerGroupMax}}" class="add-step bt-pressable" bindtap="onAddStep">＋ 添加步骤</view>
  </block>

  <!-- 灯珠选择弹出层：全屏半透明遮罩 + 居中面板；取消区固定在面板下方，不遮挡方格 -->
  <view wx:if="{{ledPickerOpen}}" class="led-picker-mask" catchtouchmove="noop">
    <!-- 遮罩：点击关闭（拖选进行中不关闭） -->
    <view class="led-picker-backdrop" bindtap="onCloseLedPicker"></view>
    <!-- 居中面板：标题 + 方格列表（手势层） -->
    <view class="led-picker-panel">
      <view class="led-picker-head">
        <text class="led-picker-title">选择灯珠</text>
        <text class="led-picker-close" bindtap="onCloseLedPicker">✕</text>
      </view>
      <view
        class="led-grid led-grid--picker"
        bindtouchstart="onLedTouchStart"
        catchtouchmove="onLedTouchMove"
        bindtouchend="onLedTouchEnd"
        bindtouchcancel="onLedTouchEnd"
      >
        <view
          wx:for="{{ledCells}}"
          wx:key="i"
          class="led-cell led-cell--{{item.state}}"
        >{{item.i}}</view>
      </view>
      <view class="led-picker-hint">{{dragging ? (inCancelZone ? '松开取消 · 保留上次选择' : '拖动中…') : '长按 1 秒激活拖动刷选；灰色为被其他灯组占用'}}</view>
    </view>
    <!-- 取消区：fixed 屏幕底部，与面板物理分离，永不遮挡方格 -->
    <view wx:if="{{dragging}}" class="led-cancel-zone {{inCancelZone ? 'led-cancel-zone--active' : ''}}">
      <text class="led-cancel-zone__text">{{inCancelZone ? '松开取消 · 保留上次选择' : '拖到此处取消 · 保留上次选择'}}</text>
    </view>
  </view>

  <!-- 保存栏（功能层玻璃，.bt-glass 含降级） -->
  <view class="save-bar bt-glass">
    <button
      wx:if="{{configured}}"
      class="bt-btn bt-btn--danger save-bar__del bt-pressable"
      bindtap="onDeletePin"
    >删除引脚</button>
    <button class="bt-btn bt-btn--primary bt-pressable save-bar__save" bindtap="onSave">保存</button>
  </view>
</view>
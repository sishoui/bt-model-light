<!-- 引脚配置详情页（ADR-0027 / #27 / T7；灯珠拖选 #31）。
     顶部图片/名称/开关 → 灯组 Tab（长按弹配置窗改名称/灯珠范围）→ 阶段/图层/灯效编辑。
     修改即推送（autoSync 防抖下发），无保存按钮。 -->
<view class="page">
  <sim-banner wx:if="{{simMode}}" />

  <!-- 同步状态条（autoSync 驱动）：syncing/synced/failed/local 四态，idle 不显示 -->
  <view class="sync-bar sync-bar--{{syncState}}" bindtap="onSyncRetry">
    <text class="sync-bar__text" wx:if="{{syncState === 'syncing'}}">同步中…</text>
    <text class="sync-bar__text" wx:elif="{{syncState === 'synced'}}">已同步 · {{syncAt}}</text>
    <text class="sync-bar__text" wx:elif="{{syncState === 'failed'}}">同步失败，点此重试</text>
    <text class="sync-bar__text" wx:elif="{{syncState === 'local'}}">仅本机（未连接）</text>
  </view>

  <!-- 顶部：图片 / 名称 / 开关 -->
  <view class="bt-card pin-head">
    <image class="pin-head__img" src="{{img}}" mode="aspectFill" />
    <view class="pin-head__info">
      <input class="pin-head__name" value="{{pinName}}" placeholder="引脚名称" bindinput="onPinNameInput" />
      <view class="bt-row bt-row--between">
        <text class="bt-text--secondary">引脚 {{pin + 1}}</text>
        <switch checked="{{power}}" color="#0088FF" bindchange="onPowerChange" />
      </view>
    </view>
  </view>

  <!-- 灯组 Tab（固定 5 个，无新增/删除；小字显示灯珠区间） -->
  <scroll-view wx:if="{{groups.length}}" class="group-tabs" scroll-x enhanced show-scrollbar="{{false}}">
    <view
      wx:for="{{groups}}"
      wx:key="gid"
      class="group-tab {{activeGroup === index ? 'group-tab--active' : ''}} bt-pressable"
      data-index="{{index}}"
      bindtap="onTapGroup"
      bindlongpress="onGroupLongPress"
    >
      <text class="group-tab__name">{{item.name}}</text>
      <text class="group-tab__range">{{item.ledStart === 255 ? '未配置' : item.ledStart + '-' + item.ledEnd}}</text>
    </view>
  </scroll-view>

  <!-- 灯珠范围拖选：长按 1s 激活刷选；被其他灯组占用的格灰显不可选；
       拖选时全屏半透明覆盖层 fixed 屏幕下方（微信语音取消样式），拖入松手回滚。 -->
  <block wx:if="{{groups.length}}">
  <!-- 阶段标题 + 添加（＋ 在标题右侧，满 5 禁用）；下方圆形节点步进条撑满居中 -->
  <view class="stage-head">
    <text class="stage-head__title">阶段</text>
    <view
      class="stage-add {{groups[activeGroup].steps.length >= stepsPerGroupMax ? 'stage-add--disabled' : ''}} bt-pressable"
      bindtap="onAddStep"
    >＋</view>
  </view>
  <scroll-view class="stage-bar__scroll" scroll-x enhanced show-scrollbar="{{false}}">
    <view class="stage-inner">
      <block wx:for="{{groups[activeGroup].steps}}" wx:key="sid" wx:for-item="step" wx:for-index="si">
        <view
          class="stage-seg {{activeStepSi === si ? 'stage-seg--active' : ''}} {{dragIndex === si ? 'stage-seg--drag' : ''}} {{enterIndex === si ? 'stage-seg--enter' : ''}}"
          style="width: {{segW[si] || 0}}rpx; transform: translateX({{offsets[si] || 0}}px);"
          data-si="{{si}}"
          bindtap="onSelectStage"
          bindlongpress="onStageLongPress"
          catchtouchmove="onStageTouchMove"
          bindtouchend="onStageTouchEnd"
          bindtouchcancel="onStageTouchEnd"
        >
          <text class="stage-seg__num">{{si + 1}}</text>
          <text class="stage-seg__name">{{step.name}}</text>
          <text class="stage-seg__info">{{step.duration}}s</text>
        </view>
      </block>
    </view>
  </scroll-view>

  <!-- 阶段详情气泡卡片：箭头指向当前选中阶段（left 由 JS 按段中心算出） -->
  <view class="step-bubble" style="--bubble-x: {{bubbleX}}rpx;">
    <view class="step-bubble__arrow"></view>
    <view class="step-detail">
      <view class="step-detail__head">
        <text class="step-detail__title">{{groups[activeGroup].name}} · {{groups[activeGroup].steps[activeStepSi].name}}</text>
      </view>

    <view class="row">
      <text class="row__label">阶段名称</text>
      <input class="row__input" value="{{groups[activeGroup].steps[activeStepSi].name}}" data-si="{{activeStepSi}}" bindinput="onStageNameInput" />
    </view>

      <view class="row">
        <text class="row__label">时长(秒)</text>
        <input class="row__input row__input--num" type="number" value="{{groups[activeGroup].steps[activeStepSi].duration}}" data-si="{{activeStepSi}}" bindinput="onDurationInput" />
      </view>
      <view class="row row--two">
        <view class="row__half">
          <text class="row__label">过渡</text>
          <picker class="row__picker" mode="selector" range="{{transitionOptions}}" data-si="{{activeStepSi}}" bindchange="onTransitionChange">
            <view>{{transitionOptions[groups[activeGroup].steps[activeStepSi].transition]}}</view>
          </picker>
        </view>
        <view class="row__half">
          <text class="row__label">循环</text>
          <picker class="row__picker" mode="selector" range="{{loopOptions}}" data-si="{{activeStepSi}}" bindchange="onLoopChange">
            <view>{{loopOptions[groups[activeGroup].steps[activeStepSi].loopMode]}}</view>
          </picker>
        </view>
      </view>

      <!-- 图层 -->
      <view
        wx:for="{{groups[activeGroup].steps[activeStepSi].layers}}"
        wx:key="lid"
        wx:for-item="layer"
        wx:for-index="li"
        class="layer"
      >
        <view class="bt-row bt-row--between layer__head" data-si="{{activeStepSi}}" data-li="{{li}}" bindtap="onToggleLayer">
          <text class="layer__title">图层 {{li + 1}}{{groups[activeGroup].steps[activeStepSi].layers.length > 1 ? (li === 0 ? '（背景）' : '（动效）') : ''}} · {{layer.effectName}}</text>
          <view class="bt-row layer__head-actions">
            <text class="layer__arrow">{{expandedLayers[activeStepSi + '-' + li] ? '▼' : '▶'}}</text>
            <text wx:if="{{groups[activeGroup].steps[activeStepSi].layers.length > 1}}" class="step__del" data-si="{{activeStepSi}}" data-li="{{li}}" catchtap="onDeleteLayer">删除</text>
          </view>
        </view>

        <block wx:if="{{expandedLayers[activeStepSi + '-' + li]}}">
          <picker class="row__picker layer__effect" mode="selector" range="{{effectNames}}" data-si="{{activeStepSi}}" data-li="{{li}}" bindchange="onEffectChange">
            <view>灯效：{{layer.effectName}}</view>
          </picker>

          <!-- 参数表单：按 effect schema 渲染 -->
          <view
            wx:for="{{layer.fields}}"
            wx:key="name"
            wx:for-item="fld"
            wx:for-index="fi"
            class="row param"
          >
            <text class="row__label">{{fld.label}}</text>
            <!-- rgb：色块预览 + 弹层 -->
            <block wx:if="{{fld.type === 'rgb'}}">
              <view
                class="color-swatch"
                style="background-color: {{fld.hex}};"
                data-si="{{activeStepSi}}"
                data-li="{{li}}"
                data-fi="{{fi}}"
                bindtap="onOpenColorPicker"
              ></view>
            </block>
            <!-- u8 / u16 -->
            <block wx:else>
              <input class="row__input row__input--num" type="number" value="{{fld.value}}" data-si="{{activeStepSi}}" data-li="{{li}}" data-fi="{{fi}}" bindinput="onParamInput" />
            </block>
          </view>
        </block>
      </view>

      <view wx:if="{{groups[activeGroup].steps[activeStepSi].layers.length < layersPerStepMax}}" class="add-layer" data-si="{{activeStepSi}}" bindtap="onAddLayer">＋ 添加图层</view>
    </view>

    <view wx:if="{{groups[activeGroup].steps.length > 1}}" class="del-stage bt-pressable" data-si="{{activeStepSi}}" catchtap="onDeleteStep">删除当前阶段</view>
    </view>
  </block>

  <!-- 颜色弹层：全屏遮罩 + 底部弹板（常用色板 + 最近使用色） -->
  <view wx:if="{{colorPickerOpen}}" class="color-picker-mask" catchtouchmove="noop">
    <view class="color-picker-backdrop" bindtap="onCloseColorPicker"></view>
    <view class="color-picker-panel">
      <view class="color-picker-head">
        <text class="color-picker-title">选择颜色</text>
        <text class="color-picker-close" bindtap="onCloseColorPicker">✕</text>
      </view>
      <view class="color-grid">
        <view
          wx:for="{{colorPalette}}"
          wx:key="*this"
          wx:for-item="c"
          class="color-cell"
          style="background-color: {{c}};"
          data-hex="{{c}}"
          data-si="{{colorPickerTarget.si}}"
          data-li="{{colorPickerTarget.li}}"
          data-fi="{{colorPickerTarget.fi}}"
          bindtap="onColorSelected"
        ></view>
      </view>
      <view wx:if="{{recentColors.length}}" class="recent-colors">
        <text class="recent-colors__title">最近使用</text>
        <view class="recent-colors__row">
          <view
            wx:for="{{recentColors}}"
            wx:key="*this"
            wx-item="c"
            class="color-cell color-cell--recent"
            style="background-color: {{c}};"
            data-hex="{{c}}"
            data-si="{{colorPickerTarget.si}}"
            data-li="{{colorPickerTarget.li}}"
            data-fi="{{colorPickerTarget.fi}}"
            bindtap="onColorSelected"
          ></view>
        </view>
      </view>
    </view>
  </view>

  <!-- 灯组配置弹窗（长按灯组 Tab 打开）：名称 + 灯珠范围拖选（第一层弹窗，无二级弹层）。
       拖选激活后底部浮出取消区（fixed，微信语音取消样式），拖入松手回滚。 -->
  <view wx:if="{{groupConfigOpen}}" class="group-config-mask" catchtouchmove="noop">
    <view class="group-config-backdrop" bindtap="onCloseGroupConfig"></view>
    <view class="group-config-panel">
      <view class="group-config-head">
        <text class="group-config-title">灯组 {{activeGroup + 1}} 配置</text>
        <text class="group-config-close" bindtap="onCloseGroupConfig">✕</text>
      </view>
      <view class="row">
        <text class="row__label">名称</text>
        <input class="row__input" value="{{groups[activeGroup].name}}" data-index="{{activeGroup}}" bindinput="onGroupNameInput" />
      </view>
      <view class="range">
        <view class="bt-row bt-row--between">
          <text class="range__title">灯珠范围 <text wx:if="{{groups[activeGroup].ledStart !== 255}}">[{{groups[activeGroup].ledStart}}, {{groups[activeGroup].ledEnd}}] ({{groups[activeGroup].ledEnd - groups[activeGroup].ledStart + 1}} 颗)</text><text wx:else>未选 (0 颗)</text></text>
        </view>
        <view
          class="led-grid"
          bindtouchstart="onLedTouchStart"
          catchtouchmove="onLedTouchMove"
          bindtouchend="onLedTouchEnd"
          bindtouchcancel="onLedTouchEnd"
        >
          <view
            wx:for="{{ledCells}}"
            wx:key="i"
            class="led-cell led-cell--{{item.state}}"
          >{{item.i}}</view>
        </view>
        <view class="range__hint">{{dragging ? (inCancelZone ? '松开取消 · 保留上次选择' : '拖动中…') : '长按 1 秒激活拖动刷选；灰色为被其他灯组占用'}}</view>
        <view class="range__actions">
          <view class="range__clear bt-pressable" bindtap="onClearLeds">清除本组</view>
        </view>
      </view>
    </view>
  </view>

  <!-- 取消区：fixed 屏幕底部，与弹窗物理分离，永不遮挡方格 -->
  <view wx:if="{{groupConfigOpen && dragging}}" class="led-cancel-zone {{inCancelZone ? 'led-cancel-zone--active' : ''}}">
    <text class="led-cancel-zone__text">{{inCancelZone ? '松开取消 · 保留上次选择' : '拖到此处取消 · 保留上次选择'}}</text>
  </view>
</view>
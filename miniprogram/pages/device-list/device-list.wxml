<!-- 设备列表页（ADR-0025 / 0027 / #25）：已保存设备（单列方形卡片）+ 扫描新增。
     每张卡片 = 1:1 方形大图，所有信息（名称/状态/设备ID/解绑）均浮层在图上。 -->
<view class="page">
  <sim-banner wx:if="{{simMode}}" />

  <view class="bt-section-title">已保存设备</view>

  <!-- 单列方形卡片列表 -->
  <view wx:if="{{devices.length}}" class="device-list">
    <view wx:for="{{devices}}" wx:key="id" class="bt-card device-card bt-pressable"
      data-id="{{item.id}}" bindtap="onTapDevice" bindlongpress="onLongPressDevice">
      <!-- 1:1 方形大图 -->
      <view class="device-card__media">
        <image wx:if="{{item.img}}" class="device-card__img" src="{{item.img}}" mode="aspectFill" />
        <view wx:else class="device-card__placeholder">
          <text class="device-card__placeholder-text">暂无图片</text>
        </view>
        <!-- 浮层：左上 使用中 -->
        <text wx:if="{{item.id === currentId}}" class="device-card__tag">使用中</text>
        <!-- 浮层：右上 在线/离线 -->
        <text class="device-card__badge {{item.id === currentId ? 'device-card__badge--online' : ''}}">
          {{item.id === currentId ? '在线' : '离线'}}
        </text>
        <!-- 浮层：底部名称条 -->
        <view class="device-card__name-bar">
          <text class="device-card__name">{{item.name || item.deviceId}}</text>
        </view>
        <!-- 浮层：左下 设备ID -->
        <button class="device-card__info" catchtap="noop">
          设备ID {{item.deviceId}}
        </button>
        <!-- 浮层：右下 解绑 -->
        <button class="device-card__btn device-card__btn--danger" catchtap="onLongPressDevice"
          data-id="{{item.id}}">解绑</button>
      </view>
    </view>
  </view>
  <view wx:else class="empty-tip">
    <text class="bt-text--secondary">暂无已保存设备，点下方按钮扫描添加</text>
  </view>

  <view class="add-section">
    <button class="bt-btn bt-btn--primary bt-pressable" bindtap="onTapAdd">
      {{scanning ? '停止扫描' : '+ 新增设备'}}
    </button>
  </view>

  <block wx:if="{{scanning}}">
    <view class="bt-section-title">扫描结果（点选连接）</view>
    <view wx:if="{{found.length}}">
      <view wx:for="{{found}}" wx:key="deviceId" class="bt-card found-row bt-pressable"
        data-device-id="{{item.deviceId}}" data-name="{{item.name}}" bindtap="onTapFound">
        <view class="found-row__info">
          <text class="found-row__name">{{item.name}}</text>
          <text class="bt-text--secondary">信号 {{item.RSSI}}</text>
        </view>
        <!-- RSSI 信号曲线：每次扫描上报一根柱，高=信号强度（越靠右越新）。
             采样点不足 2 个时不画，避免一闪而过的假趋势。 -->
        <view wx:if="{{item.rssiSeries.length > 1}}" class="rssi-spark">
          <view
            wx:for="{{item.rssiSeries}}"
            wx:for-item="pt"
            wx:key="i"
            class="rssi-spark__bar"
            style="height: {{pt.h}}%;"
          ></view>
        </view>
        <text class="found-row__arrow">›</text>
      </view>
    </view>
    <view wx:else class="empty-tip">
      <text class="bt-text--secondary">正在扫描周边 BTLight_ 设备…</text>
    </view>
  </block>
</view>
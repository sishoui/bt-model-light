/* 设备列表页（ADR-0025 / 0027 / #25；design.md §7.3 工具页范式）。
   布局：单列设备卡（白卡 + 方形媒体区 + 卡内信息行）+ 扫描结果行。 */

.device-list {
  padding: 0 32rpx;
}

/* ===== 设备卡：白卡包住方形媒体区，信息改到媒体区下方（不再压在图上） ===== */
.device-card {
  padding: 16rpx;
  margin: 0 0 24rpx;
  overflow: hidden;
}

.device-card__media {
  position: relative;
  width: 100%;
  aspect-ratio: 1 / 1;
  overflow: hidden;
  border-radius: 24rpx;
  background: var(--bt-color-bg-sunken);
}

.device-card__img {
  width: 100%;
  height: 100%;
}

.device-card__placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 100%;
}

.device-card__placeholder-text {
  color: var(--bt-color-label-quaternary);
  font-size: 26rpx;
  line-height: 36rpx;
}

/* 浮层：左上 使用中 */
.device-card__tag {
  position: absolute;
  top: 16rpx;
  left: 16rpx;
  padding: 6rpx 20rpx;
  border-radius: var(--bt-radius-pill);
  background: var(--bt-color-accent);
  color: #ffffff;
  font-size: 22rpx;
  line-height: 30rpx;
  font-weight: 600;
  box-shadow: var(--bt-shadow-accent);
}

/* 浮层：右上 在线/离线（白底胶囊压在图上，比黑色更通透） */
.device-card__badge {
  position: absolute;
  top: 16rpx;
  right: 16rpx;
  padding: 6rpx 20rpx;
  border-radius: var(--bt-radius-pill);
  background: rgba(255, 255, 255, 0.92);
  color: var(--bt-color-label-secondary);
  font-size: 22rpx;
  line-height: 30rpx;
  font-weight: 500;
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
}

.device-card__badge--online {
  color: #1f9254;
}

/* 卡内信息行：名称 + 设备 ID（左）/ 解绑（右），不再压图 */
.device-card__info-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding: 20rpx 12rpx 8rpx;
}

.device-card__text {
  flex: 1;
  min-width: 0;
}

.device-card__name {
  display: block;
  overflow: hidden;
  color: var(--bt-color-label);
  font-size: 32rpx;
  line-height: 42rpx;
  font-weight: 600;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.device-card__id {
  display: block;
  overflow: hidden;
  margin-top: 2rpx;
  color: var(--bt-color-label-tertiary);
  font-size: 22rpx;
  line-height: 30rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 解绑：弱化的红字胶囊，不再用实心红块抢视觉 */
.device-card__unbind {
  flex-shrink: 0;
  padding: 12rpx 28rpx;
  border-radius: var(--bt-radius-pill);
  background: var(--bt-color-danger-soft);
  color: var(--bt-color-danger);
  font-size: 24rpx;
  line-height: 32rpx;
  font-weight: 600;
}

.device-card__unbind::after {
  border: none;
}

/* ===== 扫描结果行 ===== */
.found-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 28rpx;
}

.found-row__info {
  flex: 1;
  min-width: 0;
}

.found-row__name {
  display: block;
  overflow: hidden;
  color: var(--bt-color-label);
  font-size: 30rpx;
  line-height: 40rpx;
  font-weight: 600;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.found-row__rssi {
  display: block;
  margin-top: 2rpx;
  color: var(--bt-color-label-tertiary);
  font-size: 22rpx;
  line-height: 30rpx;
}

.found-row__arrow {
  flex-shrink: 0;
  margin-left: 16rpx;
  color: var(--bt-color-label-quaternary);
  font-size: 36rpx;
  line-height: 44rpx;
}

/* RSSI 信号曲线：一排细柱（高=信号强度百分比），占行内固定宽度。
   扫描每次上报追加一根，40 根封顶（环形缓冲）。 */
.rssi-spark {
  display: flex;
  align-items: flex-end;
  flex-shrink: 0;
  gap: 2rpx;
  width: 160rpx;
  height: 48rpx;
  margin-right: 16rpx;
}

.rssi-spark__bar {
  flex: 1;
  min-width: 2rpx;
  border-radius: 2rpx 2rpx 0 0;
  background: var(--bt-color-success);
}

/* 新增按钮区 */
.add-section {
  padding: 8rpx 32rpx 32rpx;
}

/* 空态提示 */
.empty-tip {
  padding: 48rpx 40rpx;
  text-align: center;
}

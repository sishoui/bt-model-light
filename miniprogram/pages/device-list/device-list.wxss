/* 设备列表页（ADR-0025 / 0027 / #25；范式 B 工具页，design.md §7.3）。 */

/* 已保存设备行 */
.device-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.device-row__info {
  flex: 1;
}

.device-row__name {
  font-size: 30rpx;
  line-height: 40rpx;
  font-weight: 600;
}

.device-row__tag {
  display: inline-block;
  margin-left: 16rpx;
  padding: 2rpx 12rpx;
  border-radius: 8rpx;
  background: rgba(0, 136, 255, 0.1);
  color: var(--bt-color-accent);
  font-size: 22rpx;
  line-height: 32rpx;
}

.device-row__arrow {
  color: var(--bt-color-gray-3);
  font-size: 36rpx;
}

/* 扫描结果行 */
.found-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.found-row__info {
  flex: 1;
}

.found-row__name {
  font-size: 30rpx;
  line-height: 40rpx;
  font-weight: 600;
}

.found-row__arrow {
  color: var(--bt-color-gray-3);
  font-size: 36rpx;
}

/* 新增按钮（胶囊主按钮） */
.add-section {
  padding: 32rpx;
}

/* 空态提示 */
.empty-tip {
  padding: 48rpx 32rpx;
  text-align: center;
}
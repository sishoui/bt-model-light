<!-- 首页 = 设备详情页（ADR-0027 / #25）。
     布局：1:1 大图卡（左上标题 + 大图 + 右下开机按钮 + 底部亮度条）→ 灯组列表。
     左上标题 → 设备列表页；长按大图卡 → 编辑设备名/占位图；灯组卡片点击进引脚配置详情（T7）。 -->
<view class="page">
  <sim-banner wx:if="{{simMode}}" />

  <!-- 1:1 大图卡：左上设备名 + 大图 + 右下开机按钮 + 底部亮度条 -->
  <view class="bt-card hero-card" bindlongpress="onHeroLongPress">
    <image wx:if="{{img}}" class="hero-card__img" src="{{img}}" mode="aspectFill" />
    <view wx:else class="hero-card__placeholder">
      <text class="hero-card__placeholder-text">暂无图片</text>
      <text class="hero-card__placeholder-hint">长按编辑占位图</text>
    </view>
    <view class="hero-card__title" catchtap="onTapDeviceName">
      <text class="hero-card__title-text">{{deviceName || '未连接设备'}}</text>
      <view class="hero-card__conn {{connected ? 'hero-card__conn--on' : ''}}">
        <view class="hero-card__conn-dot"></view>
        <text class="hero-card__conn-text">{{connected ? '已连接' : '未连接'}}</text>
      </view>
      <text class="hero-card__title-action">切换 ›</text>
    </view>
    <view class="hero-card__power {{power ? 'hero-card__power--on' : ''}}"
      catchtap="onTogglePower">
      {{power ? '关机' : '开机'}}
    </view>
    <view class="hero-card__brightness" catchtap="noop">
      <text class="hero-card__brightness-label">亮度</text>
      <slider class="hero-card__brightness-slider" min="0" max="255" value="{{brightness}}"
        activeColor="#ffffff" backgroundColor="rgba(255,255,255,0.3)" block-size="16"
        catchtap="noop" bindchanging="onBrightnessChanging" bindchange="onBrightnessChange" />
      <text class="hero-card__brightness-value">{{brightness}}</text>
    </view>
  </view>

  <!-- 灯组卡片列表：4 列网格小卡（仅已配置引脚，未配置不显示） -->
  <view wx:if="{{pins.length}}" class="section">
    <view class="bt-section-title">灯组</view>
    <view class="pin-grid">
      <view wx:for="{{pins}}" wx:key="pin" class="pin-card bt-pressable"
        data-pin="{{item.pin}}" bindtap="onTapPin">
        <!-- 1:1 方形媒体区：图铺满，引脚号/名称/开关浮层在图上 -->
        <view class="pin-card__media">
          <image wx:if="{{item.img}}" class="pin-card__img" src="{{item.img}}" mode="aspectFill" />
          <view wx:else class="pin-card__placeholder">
            <text class="pin-card__placeholder-text">{{item.pin + 1}}</text>
          </view>
          <!-- 右上 开关（catchtap 阻止冒泡触发卡片跳转；小卡缩到 0.6） -->
          <switch class="pin-card__switch" checked="{{item.power}}" color="#0088FF" catchtap="noop" />
          <!-- 底部名称条（引脚号 + 名称） -->
          <view class="pin-card__name-bar">
            <text class="pin-card__name">{{item.name}}</text>
            <text class="pin-card__info">引脚 {{item.pin + 1}}</text>
          </view>
        </view>
      </view>
    </view>
  </view>
  <view wx:else class="pin-empty">
    <text class="bt-text--secondary">暂无已配置引脚</text>
  </view>

  <!-- 新增引脚：从硬件 8 引脚中选一个未配置的进入配置（保存后才出现在上方列表） -->
  <view wx:if="{{availablePins.length}}" class="add-pin">
    <picker mode="selector" range="{{pinOptions}}" bindchange="onAddPin">
      <view class="bt-btn bt-btn--primary bt-pressable add-pin__btn">＋ 新增引脚</view>
    </picker>
  </view>
</view>

<!-- 编辑设备弹窗（长按大图卡触发） -->
<view wx:if="{{editing}}" class="edit-mask" bindtap="onEditCancel">
  <view class="edit-dialog" catchtap="noop">
    <view class="edit-dialog__title">编辑设备</view>
    <view class="edit-dialog__field">
      <text class="edit-dialog__label">设备名称</text>
      <input class="edit-dialog__input" value="{{draftName}}" placeholder="未连接设备"
        bindinput="onDraftNameInput" />
    </view>
    <view class="edit-dialog__field">
      <text class="edit-dialog__label">设备图片</text>
      <view class="edit-dialog__img-row">
        <image wx:if="{{draftImg}}" class="edit-dialog__img-preview" src="{{draftImg}}"
          mode="aspectFill" />
        <view wx:else class="edit-dialog__img-preview edit-dialog__img-preview--empty">
          <text class="edit-dialog__img-empty-text">未选择</text>
        </view>
        <button class="bt-btn edit-dialog__img-btn" bindtap="onChooseImg">从相册选择</button>
      </view>
    </view>
    <view class="edit-dialog__actions">
      <button class="bt-btn edit-dialog__btn edit-dialog__btn--cancel" bindtap="onEditCancel">取消</button>
      <button class="bt-btn bt-btn--primary edit-dialog__btn" bindtap="onEditSave">保存</button>
    </view>
  </view>
</view>
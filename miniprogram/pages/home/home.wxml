<!-- 首页 = 设备 Tab 默认页（ADR-0027 / #25；design.md §7.2 舞台范式）。
     结构：整幅设备图（不套卡片，图铺满屏幕宽度；名称 / 状态 / 整机开关 / 亮度都压在图上）
     → 引脚 2 列网格。左上设备名 → 设备列表页；长按舞台 → 编辑设备名/占位图。 -->
<view class="page page--dock">
  <sim-banner wx:if="{{simMode}}" />

  <!-- ===== 舞台：整幅设备图 + 压在图上的信息层与底部控制浮层 ===== -->
  <view
    class="hero {{img ? 'hero--filled' : 'hero--empty'}}"
    bindlongpress="onHeroLongPress"
  >
    <image wx:if="{{img}}" class="hero__img" src="{{img}}" mode="aspectFill" />
    <!-- 渐变压暗：上保名称、下保控制浮层的可读性（无图空态不渲染） -->
    <view wx:if="{{img}}" class="hero__scrim"></view>

    <!-- 顶部：设备名 / 切换 → 设备列表页；右侧连接状态 + 固件版本 -->
    <view class="hero__head">
      <view class="hero__title" catchtap="onTapDeviceName">
        <text class="hero__name">{{deviceName || '未连接设备'}}</text>
        <text class="hero__action">切换 ›</text>
      </view>
      <view class="hero__meta">
        <view class="hero__chip {{connected ? 'hero__chip--on' : ''}}">
          <view class="hero__chip-dot"></view>
          <text>{{connected ? '已连接' : '未连接'}}</text>
        </view>
        <!-- 固件版本（ADR-0034）：连接时固件主动上报；未连接显示上次已知值 -->
        <text wx:if="{{firmwareVersion}}" class="hero__fw">v{{firmwareVersion}}</text>
      </view>
    </view>

    <!-- 无图空态：灯泡占位（有图时由图片撑满，不渲染） -->
    <view wx:if="{{!img}}" class="hero__placeholder">
      <view class="hero__placeholder-bulb"><view class="bt-ico bt-ico--bulb"></view></view>
      <text class="hero__placeholder-text">长按此处添加设备图</text>
    </view>

    <!-- 底部控制层：无卡片容器，控件直接压在图的下缘（靠自身投影保证可读）。
         左：亮度竖条（点方块展开 → 上下滑动 → 点别处收回）；右：整机开关。
         catchlongpress="noop"：拦住原生长按冒泡到舞台（否则长按控件会弹「编辑设备」）。
         展开时加 --lifted：把整层抬到遮罩之上，否则竖条被遮罩盖住收不到滑动
         （见 home.wxss 里关于层叠上下文的注释）。 -->
    <view
      class="hero__controls {{brightnessExpanded ? 'hero__controls--lifted' : ''}}"
      catchlongpress="noop"
    >
      <!-- 亮度竖条：收起=方块，展开=竖长条。两个状态共用同一节点，
           宽高都是 rpx 明确长度（百分比高度没法插值），才能过渡。
           填充从底部往上长，收起时也按比例显示，缩着也能看出亮度。
           外面套一个固定尺寸的槽：展开时竖条改 fixed 脱离布局，
           槽继续占位，右侧开关才不会塌到左边。 -->
      <view class="hero__bar-slot">
        <!-- 没有 catchtap：节点同时绑了 touchstart/move/end，catch 会打断事件链，
             框架不保证再合成 tap（点方块会没反应）。点击改由 touchend 按位移判定。 -->
        <view
          class="hero__bar {{brightnessExpanded ? 'hero__bar--open' : ''}}"
          catchtouchstart="onBrightnessTouchStart"
          catchtouchmove="onBrightnessDrag"
          catchtouchend="onBrightnessTouchEnd"
          catchtouchcancel="onBrightnessTouchCancel"
        >
          <view class="hero__bar-fill" style="height: {{brightnessPercent}}%;"></view>
          <view class="hero__bar-ticks">
            <view class="hero__bar-tick"></view>
            <view class="hero__bar-tick"></view>
            <view class="hero__bar-tick"></view>
          </view>
          <text class="hero__bar-value">{{brightness}}</text>
        </view>
      </view>

      <!-- 整机开关（ADR-0032）：按钮显示"要做的动作"，开→关机，关→开机 -->
      <view
        class="hero__power {{power ? 'hero__power--on' : ''}} bt-pressable"
        catchtap="onTogglePower"
      >
        <view class="hero__power-icon"></view>
        <text class="hero__power-text">{{power ? '关机' : '开机'}}</text>
      </view>
    </view>

    <!-- 展开态的遮罩：接管「点其他任意位置收回」。
         z-index 低于 .hero__bar--open，所以点竖条本身仍是拖动、不会误收起。 -->
    <view wx:if="{{brightnessExpanded}}" class="brightness-mask" catchtap="onBrightnessCollapse"></view>
  </view>

  <!-- ===== 引脚卡片：2 列网格（固定 8 个硬件引脚，未配置为虚线占位卡） =====
       设备关机（整机开关 off，ADR-0032）→ 整列置灰且不可操作。 -->
  <block wx:if="{{pins.length}}">
    <view class="bt-section-title">引脚</view>
    <view class="pin-grid">
      <view
        wx:for="{{pins}}"
        wx:key="pin"
        class="pin-card {{item.configured ? '' : 'pin-card--empty'}} {{power ? 'bt-pressable' : 'pin-card--off'}}"
        data-pin="{{item.pin}}"
        bindtap="onTapPin"
      >
        <view class="pin-card__media">
          <image wx:if="{{item.img}}" class="pin-card__img" src="{{item.img}}" mode="aspectFill" />
          <view wx:else class="pin-card__icon">{{item.pin + 1}}</view>
          <!-- 右上 灯带开关（仅已配置引脚）：catchtap 阻止冒泡跳转，状态走 bindchange -->
          <view wx:if="{{item.configured}}" class="pin-card__switch" data-pin="{{item.pin}}" catchtap="noop">
            <switch
              checked="{{item.power}}"
              disabled="{{!power}}"
              color="#0088FF"
              bindchange="onPinPowerChange"
            />
          </view>
        </view>
        <view class="pin-card__foot">
          <text class="pin-card__name">{{item.name}}</text>
          <text class="pin-card__info">{{item.info}}</text>
        </view>
      </view>
    </view>
  </block>

  <view wx:else class="pin-empty">
    <view class="pin-empty__icon"><view class="bt-ico bt-ico--bulb"></view></view>
    <text class="pin-empty__title">还没有设备</text>
    <text class="pin-empty__hint">连上灯控设备后，可在首页编辑引脚灯效</text>
    <button class="bt-btn bt-btn--primary pin-empty__add" bindtap="onTapAddDevice">添加设备</button>
  </view>
</view>

<!-- 一次性新手引导层：首次打开空态时展示，关闭后本地记录不再显示 -->
<view wx:if="{{showAddGuide}}" class="add-guide-mask" catchtouchmove="noop">
  <view class="add-guide-card">
    <text class="add-guide__title">新手引导</text>
    <text class="add-guide__text">① 点左上设备名或下方 ＋ 进入扫描</text>
    <text class="add-guide__text">② 点选 BTLight_ 设备完成连接，自动返回</text>
    <text class="add-guide__text">③ 点引脚卡片开始编辑灯效</text>
    <text class="add-guide__text">无硬件时可在「我的」页开启模拟模式体验</text>
    <button class="bt-btn bt-btn--primary add-guide__close" bindtap="onAddGuideClose">我知道了</button>
  </view>
</view>

<!-- 编辑设备弹窗（长按舞台触发） -->
<view wx:if="{{editing}}" class="edit-mask" bindtap="onEditCancel">
  <view class="edit-dialog" catchtap="noop">
    <view class="edit-dialog__title">编辑设备</view>
    <view class="edit-dialog__field">
      <text class="edit-dialog__label">设备名称</text>
      <input
        class="edit-dialog__input"
        value="{{draftName}}"
        placeholder="未连接设备"
        placeholder-class="edit-dialog__placeholder"
        bindinput="onDraftNameInput"
      />
    </view>
    <view class="edit-dialog__field">
      <text class="edit-dialog__label">设备图片</text>
      <view class="edit-dialog__img-row">
        <image wx:if="{{draftImg}}" class="edit-dialog__img-preview" src="{{draftImg}}" mode="aspectFill" />
        <view wx:else class="edit-dialog__img-preview edit-dialog__img-preview--empty">
          <text class="edit-dialog__img-empty-text">未选择</text>
        </view>
        <button class="bt-btn bt-btn--tint edit-dialog__img-btn" bindtap="onChooseImg">从相册选择</button>
      </view>
    </view>
    <view class="edit-dialog__actions">
      <button class="bt-btn edit-dialog__btn edit-dialog__btn--cancel" bindtap="onEditCancel">取消</button>
      <button class="bt-btn bt-btn--primary edit-dialog__btn" bindtap="onEditSave">保存</button>
    </view>
  </view>
</view>

<!-- 首页 = 设备详情页（ADR-0027 / #25）。
     左上：设备名称 → 设备列表页；设备卡片：图片/状态/整体开关/整体亮度；
     引脚卡片列表：仅已配置引脚，点击进入引脚配置详情（T7）。 -->
<view class="page">
  <view class="device-header" bindtap="onTapDeviceName">
    <text class="device-header__title">{{deviceName || '未连接设备'}}</text>
    <text class="device-header__action">切换 ›</text>
  </view>

  <view class="bt-card device-card">
    <view class="device-card__row">
      <image class="device-card__img" src="{{img}}" mode="aspectFill" />
      <view class="device-card__info">
        <text class="device-card__name">{{deviceName || '未连接设备'}}</text>
        <text class="device-card__status {{connected ? 'device-card__status--on' : ''}}">
          {{connected ? '已连接' : '未连接'}}
        </text>
      </view>
      <switch checked="{{power}}" color="#07c160" bindchange="onPowerChange" />
    </view>
    <view class="device-card__brightness">
      <text>整体亮度</text>
      <slider min="0" max="255" value="{{brightness}}" activeColor="#07c160"
        block-size="20" bindchange="onBrightnessChange" />
      <text>{{brightness}}</text>
    </view>
  </view>

  <!-- 引脚卡片列表：仅已配置引脚（未配置不显示） -->
  <view wx:if="{{pins.length}}" class="pin-list">
    <view wx:for="{{pins}}" wx:key="pin" class="bt-card pin-card"
      data-pin="{{item.pin}}" bindtap="onTapPin">
      <image class="pin-card__img" src="{{item.img}}" mode="aspectFill" />
      <view class="pin-card__info">
        <view class="bt-row bt-row--between">
          <text class="pin-card__name">{{item.name}}</text>
          <!-- catchtap：阻止 switch 点击冒泡触发卡片跳转 -->
          <switch checked="{{item.power}}" color="#07c160" catchtap="noop" />
        </view>
        <text class="bt-text--secondary">{{item.info}}</text>
      </view>
    </view>
  </view>
  <view wx:else class="pin-empty">
    <text class="bt-text--secondary">暂无已配置引脚</text>
  </view>
</view>
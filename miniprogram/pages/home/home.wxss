/* 首页 = 设备详情页（ADR-0027 / #25；范式 A 展示页，design.md §7.2）。 */

/* 左上设备名称栏（大标题 + 玻璃功能层信息条）：点击进设备列表 */
.device-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 32rpx 16rpx;
}

.device-header__title {
  font-size: 44rpx;
  line-height: 56rpx;
  font-weight: 700;
}

.device-header__action {
  font-size: 30rpx;
  line-height: 40rpx;
  color: var(--bt-color-accent);
}

/* 设备卡片 */
.device-card__row {
  display: flex;
  align-items: center;
}

.device-card__img {
  width: 120rpx;
  height: 120rpx;
  border-radius: 16rpx;
  background: var(--bt-color-bg-input); /* 占位图底色（真机图片后续） */
  margin-right: 24rpx;
}

.device-card__info {
  flex: 1;
}

.device-card__name {
  display: block;
  font-size: 34rpx;
  line-height: 44rpx;
  font-weight: 600;
}

.device-card__status {
  display: block;
  margin-top: 4rpx;
  font-size: 30rpx;
  line-height: 40rpx;
  color: var(--bt-color-label-secondary);
}

.device-card__status--on {
  color: var(--bt-color-success);
}

.device-card__brightness {
  display: flex;
  align-items: center;
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid var(--bt-color-separator);
  font-size: 30rpx;
  line-height: 40rpx;
  color: var(--bt-color-label-secondary);
}

.device-card__brightness slider {
  flex: 1;
  margin: 0 24rpx;
}

/* 引脚卡片列表 */
.pin-list {
  margin-top: 8rpx;
}

.pin-card {
  display: flex;
  align-items: center;
}

.pin-card__img {
  width: 96rpx;
  height: 96rpx;
  border-radius: 16rpx;
  background: var(--bt-color-bg-input);
  margin-right: 24rpx;
}

.pin-card__info {
  flex: 1;
}

.pin-card__name {
  font-size: 34rpx;
  line-height: 44rpx;
  font-weight: 600;
}

.pin-empty {
  padding: 96rpx 32rpx;
  text-align: center;
}
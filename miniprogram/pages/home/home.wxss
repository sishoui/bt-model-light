/* 首页（ADR-0027 / #25；design.md §7.2 舞台范式）。
   布局：舞台（柔光 + 悬浮设备图）→ 控制卡（大字亮度）→ 引脚 2 列网格。 */

/* ===== 舞台 ===== */
.stage {
  position: relative;
  margin: 16rpx 24rpx 0;
  padding: 28rpx 28rpx 0;
  overflow: hidden;
  border-radius: 40rpx;
  background: linear-gradient(180deg, #ffffff 0%, #fbfcfd 62%, #f5f6f8 100%);
  box-shadow: var(--bt-shadow-card);
}

/* 品牌色柔光：从顶部中心漫开，给舞台"打光" */
.stage__glow {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: var(--bt-stage-glow);
  pointer-events: none;
}

.stage__head {
  position: relative;
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}

.stage__title {
  flex: 1;
  min-width: 0;
}

.stage__name {
  display: block;
  overflow: hidden;
  color: var(--bt-color-label);
  font-size: 46rpx;
  line-height: 58rpx;
  font-weight: 700;
  letter-spacing: -0.5rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.stage__action {
  display: inline-block;
  margin-top: 4rpx;
  color: var(--bt-color-accent);
  font-size: 24rpx;
  line-height: 32rpx;
}

.stage__meta {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 8rpx;
  flex-shrink: 0;
  padding-top: 6rpx;
}

.stage__fw {
  color: var(--bt-color-label-quaternary);
  font-size: 20rpx;
  line-height: 28rpx;
}

/* 设备图区：高度由图片比例决定（配合 mode="widthFix"），
   仅在超过 max-height 时居中裁切，避免竖长图把舞台撑破。 */
.stage__body {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 8rpx;
  max-height: 640rpx;
  overflow: hidden;
}

/* widthFix：宽度撑满容器、高度按原图比例算，左右不留空白 */
.stage__img {
  position: relative;
  z-index: 1;
  display: block;
  width: 100%;
  height: auto;
}

/* 地面投影：绝对定位在图片底部，不参与布局高度 */
.stage__floor {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 120rpx;
  background: var(--bt-stage-floor);
  pointer-events: none;
}

/* 无图空态：自身撑出舞台高度（图片存在时由图片决定高度） */
.stage__empty {
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 20rpx;
  width: 100%;
  min-height: 480rpx;
}

.stage__empty-bulb {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 152rpx;
  height: 152rpx;
  border-radius: 50%;
  background: var(--bt-color-bg-elevated);
  box-shadow: var(--bt-shadow-raised);
  font-size: 64rpx;
  line-height: 1;
}

.stage__empty-text {
  color: var(--bt-color-label-tertiary);
  font-size: 24rpx;
  line-height: 34rpx;
}

/* ===== 控制卡 ===== */
.control-card {
  margin-top: 24rpx;
}

.control-card__row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
}

.control-card__metric {
  flex: 1;
  min-width: 0;
}

.control-card__label {
  display: block;
  color: var(--bt-color-label-secondary);
  font-size: 26rpx;
  line-height: 36rpx;
  font-weight: 600;
}

.control-card__value {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
  margin-top: 2rpx;
}

/* 整机开关：圆形图标 + 文案（关=品牌色，开=危险色，因为按下去是关机） */
.control-card__power {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  flex-shrink: 0;
  width: 136rpx;
}

.control-card__power-icon {
  position: relative;
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: var(--bt-color-accent);
  box-shadow: var(--bt-shadow-accent);
}

/* 电源符号：开口圆环 + 竖线 */
.control-card__power-icon::before {
  content: '';
  position: absolute;
  top: 24rpx;
  left: 50%;
  width: 32rpx;
  height: 32rpx;
  margin-left: -16rpx;
  border: 4rpx solid #ffffff;
  border-top-color: transparent;
  border-radius: 50%;
  box-sizing: border-box;
}

.control-card__power-icon::after {
  content: '';
  position: absolute;
  top: 18rpx;
  left: 50%;
  width: 4rpx;
  height: 22rpx;
  margin-left: -2rpx;
  border-radius: 2rpx;
  background: #ffffff;
}

.control-card__power--on .control-card__power-icon {
  background: var(--bt-color-danger);
  box-shadow: 0 6rpx 18rpx rgba(255, 56, 60, 0.28);
}

.control-card__power-text {
  color: var(--bt-color-label-secondary);
  font-size: 22rpx;
  line-height: 30rpx;
  font-weight: 500;
}

/* 亮度条区：sparkline 与滑块上下错叠，滑块半透明叠在山形之上 */
.control-card__slider-wrap {
  position: relative;
  margin-top: 16rpx;
  padding-top: 8rpx;
}

.control-card__slider {
  position: relative;
  z-index: 1;
  margin: 0;
}

/* sparkline：绝对定位压在滑块下半部，做成"亮度轨迹"的背景层 */
.brightness-spark {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 44rpx;
  display: block;
  width: 100%;
  height: 88rpx;
  z-index: 0;
}

.control-card__scale {
  display: flex;
  justify-content: space-between;
  margin-top: 4rpx;
}

.control-card__scale-text {
  color: var(--bt-color-label-quaternary);
  font-size: 20rpx;
  line-height: 28rpx;
}

/* ===== 引脚 2 列网格 ===== */
.pin-grid {
  display: flex;
  flex-wrap: wrap;
  padding: 0 32rpx;
}

.pin-card {
  box-sizing: border-box;
  width: calc((100% - 20rpx) / 2);
  margin-right: 20rpx;
  margin-bottom: 20rpx;
  padding: 16rpx;
  border-radius: var(--bt-radius-card);
  background: var(--bt-color-bg-elevated);
  box-shadow: var(--bt-shadow-card);
}

.pin-card:nth-child(2n) {
  margin-right: 0;
}

/* 设备关机（整机开关 off，ADR-0032）：引脚卡灰化 + 不可操作。
   opacity 是主视觉；filter 不支持的机型上也不会退化成"看起来可点"。 */
.pin-card--off {
  opacity: 0.45;
  filter: grayscale(1);
}

/* 未配置引脚：虚线边框占位卡（点击进入配置） */
.pin-card--empty {
  background: transparent;
  border: 2rpx dashed var(--bt-color-label-quaternary);
  box-shadow: none;
}

/* 方形媒体区：图片铺满，未配置时用数字胶囊占位 */
.pin-card__media {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  aspect-ratio: 1 / 1;
  overflow: hidden;
  border-radius: 22rpx;
  background: var(--bt-color-bg-sunken);
}

.pin-card__img {
  width: 100%;
  height: 100%;
}

/* 未配置/无图引脚：大数字（引脚号）作为视觉主体 */
.pin-card__icon {
  color: var(--bt-color-label-quaternary);
  font-size: 64rpx;
  line-height: 1;
  font-weight: 300;
}

.pin-card--empty .pin-card__icon {
  color: var(--bt-color-label-quaternary);
}

/* 右上 开关：小卡缩到 0.62 贴顶右，避免遮住主体 */
.pin-card__switch {
  position: absolute;
  top: 2rpx;
  right: 2rpx;
  transform: scale(0.62);
  transform-origin: top right;
}

.pin-card__foot {
  padding: 14rpx 6rpx 4rpx;
}

.pin-card__name {
  display: block;
  overflow: hidden;
  color: var(--bt-color-label);
  font-size: 28rpx;
  line-height: 36rpx;
  font-weight: 600;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.pin-card__info {
  display: block;
  overflow: hidden;
  margin-top: 2rpx;
  color: var(--bt-color-label-tertiary);
  font-size: 22rpx;
  line-height: 30rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* ===== 空态 ===== */
.pin-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 72rpx 32rpx 0;
}

.pin-empty__icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  background: var(--bt-color-bg-elevated);
  box-shadow: var(--bt-shadow-raised);
  font-size: 68rpx;
  line-height: 1;
}

.pin-empty__title {
  margin-top: 28rpx;
  color: var(--bt-color-label);
  font-size: 34rpx;
  line-height: 44rpx;
  font-weight: 600;
}

.pin-empty__hint {
  margin-top: 8rpx;
  color: var(--bt-color-label-tertiary);
  font-size: 26rpx;
  line-height: 36rpx;
  text-align: center;
}

.pin-empty__add {
  width: 400rpx;
  margin-top: 40rpx;
}

/* ===== 新手引导浮层 ===== */
.add-guide-mask {
  position: fixed;
  inset: 0;
  z-index: 120;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 48rpx;
  box-sizing: border-box;
  background: rgba(17, 24, 39, 0.45);
}

.add-guide-card {
  display: flex;
  flex-direction: column;
  width: 100%;
  padding: 40rpx 32rpx 32rpx;
  border-radius: 40rpx;
  background: var(--bt-color-bg-elevated);
  box-shadow: var(--bt-shadow-raised);
}

.add-guide__title {
  margin-bottom: 20rpx;
  color: var(--bt-color-label);
  font-size: 36rpx;
  line-height: 46rpx;
  font-weight: 700;
  text-align: center;
}

.add-guide__text {
  color: var(--bt-color-label-secondary);
  font-size: 26rpx;
  line-height: 44rpx;
}

.add-guide__close {
  margin-top: 32rpx;
}

/* ===== 编辑设备弹窗 ===== */
.edit-mask {
  position: fixed;
  inset: 0;
  z-index: 120;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 48rpx;
  box-sizing: border-box;
  background: rgba(17, 24, 39, 0.45);
}

.edit-dialog {
  width: 100%;
  padding: 36rpx 32rpx 32rpx;
  border-radius: 40rpx;
  background: var(--bt-color-bg-elevated);
  box-shadow: var(--bt-shadow-raised);
}

.edit-dialog__title {
  margin-bottom: 28rpx;
  color: var(--bt-color-label);
  font-size: 36rpx;
  line-height: 46rpx;
  font-weight: 700;
  text-align: center;
}

.edit-dialog__field {
  margin-bottom: 24rpx;
}

.edit-dialog__label {
  display: block;
  margin-bottom: 10rpx;
  color: var(--bt-color-label-secondary);
  font-size: 24rpx;
  line-height: 34rpx;
  font-weight: 500;
}

.edit-dialog__input {
  height: 88rpx;
  padding: 0 24rpx;
  border-radius: var(--bt-radius-inner);
  background: var(--bt-color-bg-input);
  color: var(--bt-color-label);
  font-size: 30rpx;
  line-height: 88rpx;
  box-sizing: border-box;
}

.edit-dialog__placeholder {
  color: var(--bt-color-label-quaternary);
}

.edit-dialog__img-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.edit-dialog__img-preview {
  flex-shrink: 0;
  width: 120rpx;
  height: 120rpx;
  border-radius: var(--bt-radius-inner);
  background: var(--bt-color-bg-input);
}

.edit-dialog__img-preview--empty {
  display: flex;
  align-items: center;
  justify-content: center;
}

.edit-dialog__img-empty-text {
  color: var(--bt-color-label-quaternary);
  font-size: 22rpx;
  line-height: 32rpx;
}

.edit-dialog__img-btn {
  flex: 1;
  height: 88rpx;
  font-size: 28rpx;
  line-height: 88rpx;
}

.edit-dialog__actions {
  display: flex;
  gap: 20rpx;
  margin-top: 32rpx;
}

.edit-dialog__btn {
  flex: 1;
}

.edit-dialog__btn--cancel {
  background: var(--bt-color-bg-input);
  color: var(--bt-color-label);
}

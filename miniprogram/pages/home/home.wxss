/* 首页（ADR-0027 / #25；design.md §7.2 舞台范式）。
   布局：整幅设备图（不套卡片，图铺满屏宽；名称 / 状态 / 开关 / 亮度压在图上）→ 引脚 2 列网格。 */

/* ===== 舞台：铺满屏宽的设备图，信息与控制层压在图上 ===== */
.hero {
  position: relative;
  width: 100%;
  height: 60vh;
  min-height: 720rpx;
  max-height: 1000rpx;
  overflow: hidden;
  background: var(--bt-color-bg-elevated);
}

/* 无图空态：白底 + 品牌柔光，给占位灯泡"打光" */
.hero--empty::after {
  content: '';
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  background: var(--bt-stage-glow);
  pointer-events: none;
}

/* 图片直接撑满舞台（aspectFill 居中裁切，上下不留白） */
.hero__img {
  position: absolute;
  top: 0;
  left: 0;
  z-index: 0;
  display: block;
  width: 100%;
  height: 100%;
}

/* 渐变压暗：顶部托住设备名，底部托住控制浮层；中段透明露出图片主体 */
.hero__scrim {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 1;
  background: linear-gradient(
    180deg,
    rgba(0, 0, 0, 0.42) 0%,
    rgba(0, 0, 0, 0.16) 22%,
    rgba(0, 0, 0, 0) 44%,
    rgba(0, 0, 0, 0.12) 62%,
    rgba(0, 0, 0, 0.46) 100%
  );
  pointer-events: none;
}

/* ===== 舞台顶部：设备名（左）/ 连接状态 + 固件版本（右） ===== */
.hero__head {
  position: absolute;
  top: 0;
  right: 0;
  left: 0;
  z-index: 2;
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
  padding: 28rpx 32rpx 0;
}

.hero__title {
  flex: 1;
  min-width: 0;
}

.hero__name {
  display: block;
  overflow: hidden;
  color: var(--bt-color-label);
  font-size: 46rpx;
  line-height: 58rpx;
  font-weight: 700;
  letter-spacing: -0.5rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 有图时文字压图：改白字 + 极轻投影（不靠深色块，保持通透） */
.hero--filled .hero__name {
  color: #ffffff;
  text-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.28);
}

.hero__action {
  display: inline-block;
  margin-top: 4rpx;
  color: var(--bt-color-accent);
  font-size: 24rpx;
  line-height: 32rpx;
}

.hero--filled .hero__action {
  color: rgba(255, 255, 255, 0.88);
  text-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.28);
}

.hero__meta {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 8rpx;
  flex-shrink: 0;
  padding-top: 6rpx;
}

/* 连接状态胶囊：无图空态跟随即有 token；有图时改纯白玻璃压在图上，
   两种背景（浅图/深图）都读得清。 */
.hero__chip {
  display: inline-flex;
  align-items: center;
  padding: 6rpx 18rpx;
  border-radius: var(--bt-radius-pill);
  background: var(--bt-color-bg-input);
  color: var(--bt-color-label-secondary);
  font-size: 22rpx;
  line-height: 30rpx;
  font-weight: 500;
}

.hero--filled .hero__chip {
  background: rgba(255, 255, 255, 0.88);
  color: #4b5563;
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
}

.hero__chip-dot {
  width: 10rpx;
  height: 10rpx;
  margin-right: 8rpx;
  border-radius: 50%;
  background-color: var(--bt-color-label-quaternary);
}

.hero__chip--on {
  color: #1f9254;
}

.hero--filled .hero__chip--on {
  color: #1f9254;
}

.hero__chip--on .hero__chip-dot {
  background-color: var(--bt-color-success);
}

.hero__fw {
  color: var(--bt-color-label-quaternary);
  font-size: 20rpx;
  line-height: 28rpx;
}

.hero--filled .hero__fw {
  color: rgba(255, 255, 255, 0.72);
  text-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.28);
}

/* ===== 无图占位（灯泡 + 提示） ===== */
.hero__placeholder {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 20rpx;
  padding-bottom: 280rpx;
}

.hero__placeholder-bulb {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 152rpx;
  height: 152rpx;
  border-radius: 50%;
  background: var(--bt-color-bg-elevated);
  box-shadow: var(--bt-shadow-raised);
  color: var(--bt-color-label-tertiary);
}

.hero__placeholder-text {
  color: var(--bt-color-label-tertiary);
  font-size: 24rpx;
  line-height: 34rpx;
}

/* ===== 底部控制层：不套容器，控件直接压在图的下缘 =====
   左亮度竖条（贴左下角）/ 右整机开关。没有底板，所以控件自带投影保证可读。 */
.hero__controls {
  position: absolute;
  right: 32rpx;
  bottom: 32rpx;
  left: 32rpx;
  z-index: 3;
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 24rpx;
}

/* 展开态把整层抬到遮罩(35)之上。
   关键：z-index 非 auto 的元素自成**层叠上下文**，子元素再大的 z-index 也只在这一层
   内部比较。竖条此前写 z-index: 40 却仍被 z-index: 35 的遮罩盖住，正是因为它的 40
   只在本层内生效、对外整体仍按本层的 3 参与比较——滑动落到遮罩上，于是滚了页面。 */
.hero__controls--lifted {
  z-index: 36;
  /* 空白区域不拦截触摸，让点击穿透到遮罩上（点空白也能收起）。
     竖条与开关各自恢复 auto，继续响应自己的手势。 */
  pointer-events: none;
}

.hero__controls--lifted .hero__bar,
.hero__controls--lifted .hero__power {
  pointer-events: auto;
}

/* 槽：固定方块尺寸常驻占位。展开时竖条转 fixed 离场，槽仍在，
   右侧开关不会因为"左边空了"而塌过去。 */
.hero__bar-slot {
  flex-shrink: 0;
  width: 96rpx;
  height: 96rpx;
}

/* ===== 亮度竖条（Apple 音量条形态）：收起=方块，展开=竖长条 =====
   两个状态的宽/高都是明确 rpx（见 home.js 的 BAR_* 常量），百分比高度无法插值，
   所以过渡动画必须是长度到长度。收起态填充比例照样显示，缩着也看得出亮度。 */
.hero__bar {
  position: relative;
  width: 96rpx;
  height: 96rpx;
  overflow: hidden;
  border-radius: 28rpx;
  /* 收起态：半透明白玻璃压图，与开关/文字的观感一套 */
  background: rgba(255, 255, 255, 0.28);
  border: 1rpx solid rgba(255, 255, 255, 0.42);
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.22);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  transition: width 0.26s ease-out, height 0.26s ease-out, border-radius 0.26s ease-out;
}

/* 展开态：向上长成竖长条，并挪到屏幕垂直中间。
   用 fixed 是为了不被 .hero 的 overflow:hidden 裁掉（.hero 没有 transform/filter，
   所以 fixed 的包含块是视口）；left/top 各 50% + translate(-50%,-50%) 居中。
   这里的 z-index 只在 .hero__controls 内部有效，对外靠 .hero__controls--lifted 抬高。 */
.hero__bar--open {
  position: fixed;
  top: 50vh;
  left: 50vw;
  width: 76rpx;
  height: 420rpx;
  border-radius: 38rpx;
  transform: translate(-50%, -50%);
  background: rgba(255, 255, 255, 0.34);
  box-shadow: 0 8rpx 40rpx rgba(0, 0, 0, 0.34);
}

/* 填充：从底部往上长。高度直接给百分比（父元素高度是明确值，能算）。
   品牌色渐变让"高=亮"更直观。 */
.hero__bar-fill {
  position: absolute;
  right: 0;
  bottom: 0;
  left: 0;
  border-radius: 0 0 26rpx 26rpx;
  background: linear-gradient(180deg, #4fb4ff 0%, var(--bt-color-accent) 100%);
  transition: height 0.06s linear;
}

.hero__bar--open .hero__bar-fill {
  border-radius: 0 0 36rpx 36rpx;
}

/* 收起态没有长条可言，填充用小圆点提示比例（缩放过渡时也不难看） */
.hero__bar-ticks {
  position: absolute;
  top: 50%;
  left: 50%;
  display: none;
  transform: translate(-50%, -50%);
}

/* 展开态的分段刻度（Apple 音量条的三道横纹） */
.hero__bar--open .hero__bar-ticks {
  display: block;
}

.hero__bar-tick {
  width: 28rpx;
  height: 3rpx;
  margin-bottom: 10rpx;
  border-radius: 2rpx;
  background: rgba(255, 255, 255, 0.55);
}

.hero__bar-tick:last-child {
  margin-bottom: 0;
}

/* 数值：收起态藏在方块里（小字），展开态沉到底部之外不显示 */
.hero__bar-value {
  position: absolute;
  right: 0;
  bottom: 8rpx;
  left: 0;
  color: #ffffff;
  font-size: 22rpx;
  line-height: 26rpx;
  font-weight: 600;
  text-align: center;
  text-shadow: 0 1rpx 6rpx rgba(0, 0, 0, 0.45);
}

.hero__bar--open .hero__bar-value {
  display: none;
}

/* 展开态的遮罩：盖住整页接管「点其他位置收回」。
   展开时 .hero__controls--lifted 抬到 36（在它之上），所以竖条仍能收到滑动；
   控制层的空白区域设了 pointer-events: none，点空白照样落到遮罩上。 */
.brightness-mask {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 35;
  background: rgba(11, 12, 14, 0.28);
}

/* 无图空态：白底上白玻璃方块看不见，换浅灰底 */
.hero--empty .hero__bar {
  background: rgba(17, 24, 39, 0.06);
  border-color: rgba(17, 24, 39, 0.08);
}

.hero--empty .hero__bar-value {
  color: var(--bt-color-label-secondary);
  text-shadow: none;
}

.hero--empty .hero__power-text {
  color: var(--bt-color-label-secondary);
  text-shadow: none;
}

/* 整机开关：圆形图标 + 文案（关=品牌色，开=危险色，因为按下去是关机） */
.hero__power {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  flex-shrink: 0;
  width: 136rpx;
}

.hero__power-icon {
  position: relative;
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: var(--bt-color-accent);
  box-shadow: var(--bt-shadow-accent);
}

/* 电源符号：开口圆环 + 竖线 */
.hero__power-icon::before {
  content: '';
  position: absolute;
  top: 24rpx;
  left: 50%;
  width: 32rpx;
  height: 32rpx;
  margin-left: -16rpx;
  border: 4rpx solid #ffffff;
  border-top-color: transparent;
  border-radius: 50%;
  box-sizing: border-box;
}

.hero__power-icon::after {
  content: '';
  position: absolute;
  top: 18rpx;
  left: 50%;
  width: 4rpx;
  height: 22rpx;
  margin-left: -2rpx;
  border-radius: 2rpx;
  background: #ffffff;
}

.hero__power--on .hero__power-icon {
  background: var(--bt-color-danger);
  box-shadow: 0 6rpx 18rpx rgba(255, 56, 60, 0.28);
}

/* 开关文案：压图无底板，白字 + 投影 */
.hero__power-text {
  color: rgba(255, 255, 255, 0.9);
  font-size: 22rpx;
  line-height: 30rpx;
  font-weight: 500;
  text-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.45);
}

/* ===== 引脚 2 列网格 ===== */
.pin-grid {
  display: flex;
  flex-wrap: wrap;
  padding: 0 32rpx;
}

.pin-card {
  box-sizing: border-box;
  width: calc((100% - 20rpx) / 2);
  margin-right: 20rpx;
  margin-bottom: 20rpx;
  padding: 16rpx;
  border-radius: var(--bt-radius-card);
  background: var(--bt-color-bg-elevated);
  box-shadow: var(--bt-shadow-card);
}

.pin-card:nth-child(2n) {
  margin-right: 0;
}

/* 设备关机（整机开关 off，ADR-0032）：引脚卡灰化 + 不可操作。
   opacity 是主视觉；filter 不支持的机型上也不会退化成"看起来可点"。 */
.pin-card--off {
  opacity: 0.45;
  filter: grayscale(1);
}

/* 未配置引脚：虚线边框占位卡（点击进入配置） */
.pin-card--empty {
  background: transparent;
  border: 2rpx dashed var(--bt-color-label-quaternary);
  box-shadow: none;
}

/* 方形媒体区：图片铺满，未配置时用数字胶囊占位 */
.pin-card__media {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  aspect-ratio: 1 / 1;
  overflow: hidden;
  border-radius: 22rpx;
  background: var(--bt-color-bg-sunken);
}

.pin-card__img {
  width: 100%;
  height: 100%;
}

/* 未配置/无图引脚：大数字（引脚号）作为视觉主体 */
.pin-card__icon {
  color: var(--bt-color-label-quaternary);
  font-size: 64rpx;
  line-height: 1;
  font-weight: 300;
}

.pin-card--empty .pin-card__icon {
  color: var(--bt-color-label-quaternary);
}

/* 右上 开关：小卡缩到 0.62 贴顶右，避免遮住主体 */
.pin-card__switch {
  position: absolute;
  top: 2rpx;
  right: 2rpx;
  transform: scale(0.62);
  transform-origin: top right;
}

.pin-card__foot {
  padding: 14rpx 6rpx 4rpx;
}

.pin-card__name {
  display: block;
  overflow: hidden;
  color: var(--bt-color-label);
  font-size: 28rpx;
  line-height: 36rpx;
  font-weight: 600;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.pin-card__info {
  display: block;
  overflow: hidden;
  margin-top: 2rpx;
  color: var(--bt-color-label-tertiary);
  font-size: 22rpx;
  line-height: 30rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* ===== 空态 ===== */
.pin-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 72rpx 32rpx 0;
}

.pin-empty__icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  background: var(--bt-color-bg-elevated);
  box-shadow: var(--bt-shadow-raised);
  color: var(--bt-color-label-tertiary);
}

.pin-empty__title {
  margin-top: 28rpx;
  color: var(--bt-color-label);
  font-size: 34rpx;
  line-height: 44rpx;
  font-weight: 600;
}

.pin-empty__hint {
  margin-top: 8rpx;
  color: var(--bt-color-label-tertiary);
  font-size: 26rpx;
  line-height: 36rpx;
  text-align: center;
}

.pin-empty__add {
  width: 400rpx;
  margin-top: 40rpx;
}

/* ===== 新手引导浮层 ===== */
.add-guide-mask {
  position: fixed;
  inset: 0;
  z-index: 120;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 48rpx;
  box-sizing: border-box;
  background: rgba(17, 24, 39, 0.45);
}

.add-guide-card {
  display: flex;
  flex-direction: column;
  width: 100%;
  padding: 40rpx 32rpx 32rpx;
  border-radius: 40rpx;
  background: var(--bt-color-bg-elevated);
  box-shadow: var(--bt-shadow-raised);
}

.add-guide__title {
  margin-bottom: 20rpx;
  color: var(--bt-color-label);
  font-size: 36rpx;
  line-height: 46rpx;
  font-weight: 700;
  text-align: center;
}

.add-guide__text {
  color: var(--bt-color-label-secondary);
  font-size: 26rpx;
  line-height: 44rpx;
}

.add-guide__close {
  margin-top: 32rpx;
}

/* ===== 编辑设备弹窗 ===== */
.edit-mask {
  position: fixed;
  inset: 0;
  z-index: 120;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 48rpx;
  box-sizing: border-box;
  background: rgba(17, 24, 39, 0.45);
}

.edit-dialog {
  width: 100%;
  padding: 36rpx 32rpx 32rpx;
  border-radius: 40rpx;
  background: var(--bt-color-bg-elevated);
  box-shadow: var(--bt-shadow-raised);
}

.edit-dialog__title {
  margin-bottom: 28rpx;
  color: var(--bt-color-label);
  font-size: 36rpx;
  line-height: 46rpx;
  font-weight: 700;
  text-align: center;
}

.edit-dialog__field {
  margin-bottom: 24rpx;
}

.edit-dialog__label {
  display: block;
  margin-bottom: 10rpx;
  color: var(--bt-color-label-secondary);
  font-size: 24rpx;
  line-height: 34rpx;
  font-weight: 500;
}

.edit-dialog__input {
  height: 88rpx;
  padding: 0 24rpx;
  border-radius: var(--bt-radius-inner);
  background: var(--bt-color-bg-input);
  color: var(--bt-color-label);
  font-size: 30rpx;
  line-height: 88rpx;
  box-sizing: border-box;
}

.edit-dialog__placeholder {
  color: var(--bt-color-label-quaternary);
}

.edit-dialog__img-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.edit-dialog__img-preview {
  flex-shrink: 0;
  width: 120rpx;
  height: 120rpx;
  border-radius: var(--bt-radius-inner);
  background: var(--bt-color-bg-input);
}

.edit-dialog__img-preview--empty {
  display: flex;
  align-items: center;
  justify-content: center;
}

.edit-dialog__img-empty-text {
  color: var(--bt-color-label-quaternary);
  font-size: 22rpx;
  line-height: 32rpx;
}

.edit-dialog__img-btn {
  flex: 1;
  height: 88rpx;
  font-size: 28rpx;
  line-height: 88rpx;
}

.edit-dialog__actions {
  display: flex;
  gap: 20rpx;
  margin-top: 32rpx;
}

.edit-dialog__btn {
  flex: 1;
}

.edit-dialog__btn--cancel {
  background: var(--bt-color-bg-input);
  color: var(--bt-color-label);
}

<!-- 我的页（底部导航第二 Tab）：设置/关于/帮助（ADR-0027 / #25）。 -->
<view class="page">
  <view class="bt-section-title">设置</view>
  <view class="bt-card">
    <view class="bt-row bt-row--between settings-row">
      <view>
        <text class="settings-row__title">模拟模式</text>
        <text class="settings-row__hint">无硬件环境测试用（开启后注入模拟设备）</text>
      </view>
      <switch checked="{{simModeEnabled}}" color="#0088FF" bindchange="onToggleSimMode" />
    </view>
    <view class="bt-row bt-row--between settings-row bt-pressable" bindtap="onClearStorage">
      <text class="settings-row__title">清除本地数据</text>
      <text class="settings-row__arrow">›</text>
    </view>
  </view>

  <view class="bt-section-title">关于</view>
  <view class="bt-card">
    <view class="bt-row bt-row--between settings-row bt-pressable" bindtap="onTapAbout">
      <text class="settings-row__title">关于 bt-model-light</text>
      <view class="settings-row__meta">
        <text class="settings-row__value">v{{version}} · 协议 {{protocolVersion}}</text>
        <text class="settings-row__arrow">›</text>
      </view>
    </view>
  </view>

  <view class="bt-section-title">帮助</view>
  <view class="bt-card">
    <view class="bt-row bt-row--between settings-row bt-pressable" bindtap="onTapHelp">
      <text class="settings-row__title">使用帮助</text>
      <text class="settings-row__arrow">›</text>
    </view>
  </view>
</view>
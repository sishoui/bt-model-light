/* 用户配置页（ADR-0027 / #25；ADR-0035 用户体系；design.md §7.4 设置页范式）。
   设置行为「图标胶囊 + 文案 + 值/箭头」三段式，靠底色差与留白分层，不用分割线。 */

/* ===== 账号卡 ===== */
.profile-hero {
  margin-top: 24rpx;
  padding: 32rpx;
}

.profile-hero__row {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

/* button 自带默认样式，这里清空只留布局（微信原生 button 重置） */
.profile-hero__avatar-btn {
  padding: 0;
  margin: 0;
  border: none;
  background: transparent;
  line-height: 1;
}

.profile-hero__avatar {
  flex-shrink: 0;
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  overflow: hidden;
  background: var(--bt-color-bg-input);
}

.profile-hero__avatar--placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2rpx dashed var(--bt-color-label-quaternary);
}

.profile-hero__avatar-text {
  color: var(--bt-color-label-tertiary);
  font-size: 22rpx;
}

.profile-hero__main {
  flex: 1;
  min-width: 0;
}

.profile-hero__name-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.profile-hero__name {
  display: block;
  color: var(--bt-color-label);
  font-size: 40rpx;
  line-height: 52rpx;
  font-weight: 700;
}

.profile-hero__name-input {
  flex: 1;
  min-width: 0;
  height: 52rpx;
  color: var(--bt-color-label);
  font-size: 40rpx;
  line-height: 52rpx;
  font-weight: 700;
}

.profile-hero__placeholder {
  color: var(--bt-color-label-quaternary);
}

.profile-hero__save {
  flex: none;
  padding: 8rpx 22rpx;
  border-radius: var(--bt-radius-pill);
  background: var(--bt-color-accent-soft);
  color: var(--bt-color-accent);
  font-size: 24rpx;
  line-height: 32rpx;
  font-weight: 600;
}

.profile-hero__hint {
  display: block;
  margin-top: 6rpx;
  color: var(--bt-color-label-tertiary);
  font-size: 24rpx;
  line-height: 34rpx;
}

.profile-hero__login {
  width: 100%;
  margin-top: 32rpx;
}

/* 退出登录：弱化红字行，不再用整行分割线 */
.profile-hero__logout {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 80rpx;
  margin-top: 24rpx;
  border-radius: var(--bt-radius-inner);
  background: var(--bt-color-danger-soft);
}

.profile-hero__logout-text {
  color: var(--bt-color-danger);
  font-size: 28rpx;
  line-height: 38rpx;
  font-weight: 600;
}

/* ===== 设置卡与设置行 ===== */
.settings-card {
  padding: 8rpx 20rpx;
}

.settings-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  min-height: 112rpx;
  padding: 16rpx 8rpx;
}

.settings-row__body {
  flex: 1;
  min-width: 0;
}

.settings-row__title {
  display: block;
  color: var(--bt-color-label);
  font-size: 30rpx;
  line-height: 40rpx;
  font-weight: 600;
}

.settings-row__hint {
  display: block;
  margin-top: 2rpx;
  color: var(--bt-color-label-tertiary);
  font-size: 22rpx;
  line-height: 30rpx;
}

.settings-row__meta {
  display: flex;
  align-items: center;
  flex-shrink: 0;
}

.settings-row__value {
  flex-shrink: 0;
  margin-left: 8rpx;
  color: var(--bt-color-label-tertiary);
  font-size: 24rpx;
  line-height: 34rpx;
}

.settings-row__arrow {
  flex-shrink: 0;
  margin-left: 8rpx;
  color: var(--bt-color-label-quaternary);
  font-size: 34rpx;
  line-height: 42rpx;
}

/* ===== 底部弹层（日志）：圆角 + 抓手 + 浅遮罩 ===== */
.sheet-mask {
  position: fixed;
  inset: 0;
  z-index: 100;
  display: flex;
  align-items: flex-end;
  background: rgba(17, 24, 39, 0.35);
}

.sheet {
  display: flex;
  flex-direction: column;
  width: 100%;
  max-height: 82vh;
  padding: 16rpx 32rpx calc(40rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  border-radius: 40rpx 40rpx 0 0;
  background: var(--bt-color-bg-elevated);
}

/* 顶部抓手：暗示可下滑关闭 */
.sheet__grabber {
  width: 72rpx;
  height: 8rpx;
  margin: 0 auto 16rpx;
  border-radius: 999rpx;
  background: var(--bt-color-gray-4);
}

.sheet__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.sheet__title {
  color: var(--bt-color-label);
  font-size: 36rpx;
  line-height: 46rpx;
  font-weight: 700;
}

.sheet__close {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: var(--bt-color-bg-input);
  color: var(--bt-color-label-secondary);
  font-size: 26rpx;
  line-height: 1;
}

/* ===== 柱状图区块 ===== */
.log-chart {
  padding: 24rpx 20rpx;
}

.log-chart__head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.log-chart__title {
  color: var(--bt-color-label);
  font-size: 26rpx;
  line-height: 34rpx;
  font-weight: 600;
}

.log-chart__total {
  color: var(--bt-color-label-tertiary);
  font-size: 22rpx;
  line-height: 30rpx;
}

.log-chart__bars {
  display: flex;
  align-items: flex-end;
  height: 200rpx;
}

.log-chart__col {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  height: 100%;
}

.log-chart__count {
  color: var(--bt-color-label-tertiary);
  font-size: 20rpx;
  line-height: 28rpx;
}

/* 柱容器：占满剩余高度，柱体自底部按百分比生长 */
.log-chart__bar-wrap {
  flex: 1;
  display: flex;
  align-items: flex-end;
  justify-content: center;
  width: 100%;
  min-height: 0;
}

.log-chart__bar {
  width: 56%;
  min-height: 6rpx;
  border-radius: 999rpx 999rpx 4rpx 4rpx;
  background: var(--bt-color-accent);
  transition: height 0.25s ease-out;
}

.log-chart__bar--empty {
  min-height: 4rpx;
  background: var(--bt-color-gray-4);
}

.log-chart__label {
  margin-top: 8rpx;
  color: var(--bt-color-label-tertiary);
  font-size: 20rpx;
  line-height: 28rpx;
}

/* ===== 最近条目列表 ===== */
.log-list__title {
  display: block;
  margin: 28rpx 0 8rpx;
  color: var(--bt-color-label-secondary);
  font-size: 24rpx;
  line-height: 32rpx;
  font-weight: 600;
}

.log-list {
  flex: 1;
  min-height: 0;
  max-height: 440rpx;
}

.log-item {
  padding: 14rpx 0;
  border-bottom: 1rpx solid var(--bt-color-separator);
}

.log-item__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.log-item__ts {
  color: var(--bt-color-label-tertiary);
  font-size: 22rpx;
  line-height: 30rpx;
}

.log-item__ctx {
  padding: 2rpx 12rpx;
  border-radius: var(--bt-radius-pill);
  background: var(--bt-color-bg-input);
  color: var(--bt-color-label-secondary);
  font-size: 20rpx;
  line-height: 28rpx;
}

.log-item__msg {
  display: block;
  margin-top: 4rpx;
  color: var(--bt-color-label);
  font-size: 26rpx;
  line-height: 36rpx;
}

/* ===== 固件升级进度弹层（ADR-0034） ===== */
.ota-mask {
  position: fixed;
  inset: 0;
  z-index: 110;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 48rpx;
  box-sizing: border-box;
  background: rgba(17, 24, 39, 0.4);
}

.ota-panel {
  display: flex;
  flex-direction: column;
  width: 100%;
  padding: 36rpx 32rpx 32rpx;
  box-sizing: border-box;
  border-radius: 40rpx;
  background: var(--bt-color-bg-elevated);
  box-shadow: var(--bt-shadow-raised);
}

.ota-panel__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.ota-panel__title {
  color: var(--bt-color-label);
  font-size: 34rpx;
  line-height: 44rpx;
  font-weight: 700;
}

.ota-panel__close {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: var(--bt-color-bg-input);
  color: var(--bt-color-label-secondary);
  font-size: 26rpx;
  line-height: 1;
}

.ota-panel__text {
  margin-bottom: 20rpx;
  color: var(--bt-color-label-secondary);
  font-size: 26rpx;
  line-height: 36rpx;
}

.ota-panel__bar-wrap {
  overflow: hidden;
  width: 100%;
  height: 16rpx;
  border-radius: 999rpx;
  background: var(--bt-color-bg-input);
}

.ota-panel__bar {
  height: 100%;
  border-radius: 999rpx;
  background: var(--bt-color-accent);
  transition: width 0.2s ease-out;
}

.ota-panel__bar--error {
  background: var(--bt-color-danger);
}

.ota-panel__pct {
  margin-top: 12rpx;
  color: var(--bt-color-label-tertiary);
  font-size: 24rpx;
  line-height: 34rpx;
  text-align: right;
}

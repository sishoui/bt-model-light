/* 全局样式。具体页面样式见各 pages/ 下 WXSS。 */
page {
  --bt-color-primary: #07c160;
  --bt-color-bg: #f5f5f5;
  --bt-color-card: #ffffff;
  --bt-color-text: #1a1a1a;
  --bt-color-text-secondary: #888888;
  background-color: var(--bt-color-bg);
  color: var(--bt-color-text);
  font-size: 28rpx;
  line-height: 1.5;
}

.bt-card {
  background-color: var(--bt-color-card);
  border-radius: 16rpx;
  padding: 24rpx;
  margin: 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.bt-row {
  display: flex;
  align-items: center;
}

.bt-row--between {
  justify-content: space-between;
}

.bt-text--secondary {
  color: var(--bt-color-text-secondary);
  font-size: 24rpx;
}
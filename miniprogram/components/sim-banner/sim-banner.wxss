/* 模拟模式提示浮层（design.md §7.1）：warning 色系 + 玻璃底 + 降级。
   柔光语言：胶囊形、warning tint 底、无描边（靠底色差表达层级）。 */
.sim-banner {
  position: relative;
  z-index: 10;
  margin: 16rpx 32rpx 0;
  padding: 14rpx 28rpx;
  border-radius: var(--bt-radius-pill);
  color: #b25000;
  font-size: 24rpx;
  line-height: 34rpx;
  font-weight: 500;
  text-align: center;
  background-color: var(--bt-color-warning-soft);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
}

@supports not (backdrop-filter: blur(1px)) {
  .sim-banner {
    background-color: rgba(255, 244, 230, 0.96);
  }
}

@media (prefers-color-scheme: dark) {
  .sim-banner {
    color: #ffb340;
  }

  @supports not (backdrop-filter: blur(1px)) {
    .sim-banner {
      background-color: rgba(58, 40, 24, 0.96);
    }
  }
}

# 服务器凭据与部署配置（模板）。
#
# 复制为 deploy/server.env 并填入真实值；server.env 已被 .gitignore 排除，
# 不会进仓库。读取方式见 AGENTS.md「服务器与固件发布」「后端与后台发布」。
#
# 只允许 scripts/firmware_release.py 与 scripts/backend_deploy.py 读取本文件；
# 不要把内容贴进 issue、提交信息或日志。

# ---- SSH（固件发布与后端部署共用） ----
SERVER_HOST=203.0.113.10
SERVER_PORT=22
SERVER_USER=root
SERVER_PASSWORD=change-me

# ---- 固件发布（scripts/firmware_release.py，ADR-0034） ----
# 服务器上的固件目录（publish 写入、HTTP 对外暴露的就是它）。
SERVER_FIRMWARE_DIR=/var/www/bt-model-light/firmware
# 小程序下载 bin/manifest 的基地址（末尾不要带 /）。
FIRMWARE_BASE_URL=http://203.0.113.10/firmware

# ---- 后端 API + 管理后台（scripts/backend_deploy.py，ADR-0035/0036） ----
# 远端代码目录（publish 覆盖写入；node_modules 由远端 npm ci 生成）。
SERVER_API_DIR=/var/www/bt-model-light/api
# 管理后台构建产物的远端目录（nginx 的 /admin/ alias 指向它）。
SERVER_ADMIN_DIR=/var/www/bt-model-light/admin
# SQLite 数据库路径（目录需服务可写；publish 前会自动时间戳备份）。
DB_PATH=/var/lib/bt-light/bt-light.db

# 小程序 wx.request 的基地址（末尾不带 /）。换域名/换 HTTPS 只改这里与
# miniprogram/utils/apiClient.js 的 DEFAULT_BASE_URL（或 Storage bt_api_base_url）。
API_BASE_URL=http://203.0.113.10/api

# 微信小程序凭据：code2Session 登录必需（AppID 与 miniprogram/project.config.json 一致）。
WX_APP_ID=wx0000000000000000
WX_APP_SECRET=change-me

# 管理后台初始账号：仅当 users 表里还没有 admin 时创建一次（幂等）。
# 上线后请到后台改密码，或直接改这里再 publish（不会覆盖已存在的 admin）。
ADMIN_INIT_USER=admin
ADMIN_INIT_PASSWORD=change-me-too

# ---- 可选（有默认值，留空即用默认） ----
# 后端监听端口（只监听 127.0.0.1，对外经 nginx 反代）
# PORT=3000
# BIND=127.0.0.1
# 会话有效期（天）
# TOKEN_TTL_DAYS=30
# 头像 data URL 上限（字节）
# AVATAR_MAX_BYTES=204800
# 日志级别：debug|info|warn|error
# LOG_LEVEL=info
